---
import Base from '../../layouts/Base.astro';
import ConnectPrompt from '../../components/ConnectPrompt.astro';
import ErrorState from '../../components/ErrorState.astro';
import StatCard from '../../components/StatCard.astro';
import ChartCard from '../../components/ChartCard.astro';
import { clientFor, getActivity, getHrZones, type HrZones, type Activity } from '../../lib/garmin';
import { hasDistance, kindOf, speedLabel, speedUnit, speedValue } from '../../lib/activity-kinds';
import { activityLabel, dayLabel, duration, int, km, pace, speed, trainingEffect } from '../../lib/format';
import type { ChartSpec } from '../../lib/chart-spec';

const id = Number(Astro.params.id);
const client = clientFor(Astro.locals);

let run: Activity | undefined;
let zones: HrZones | undefined;
let error: unknown;
if (client && Number.isInteger(id) && id > 0) {
  try {
    run = await getActivity(client, id);
    if (run) {
      const k = kindOf(run.typeKey);
      const sport = k === 'cycling' ? 'CYCLING' : k === 'swim' ? 'SWIMMING' : 'RUNNING';
      zones = await getHrZones(client, sport).catch(() => undefined);
    }
  } catch (err) {
    error = err;
  }
}
if (client && !error && !run) return new Response('Actividad no encontrada', { status: 404 });

const kind = run ? kindOf(run.typeKey) : 'other';
const swim = kind === 'swim';
const avgSpeed = run ? speedValue(kind, run.distanceKm, run.movingS) : undefined;
const showDistance = run !== undefined && hasDistance(kind) && run.distanceKm > 0;

const zoneTotal = run ? run.hrZonesS.reduce((a, b) => a + b, 0) : 0;
const zoneLabels = [1, 2, 3, 4, 5].map((z, i) => {
  const lo = zones?.floors[i];
  const hi = zones?.floors[i + 1] ?? zones?.maxHr;
  return lo ? `Z${z} · ${lo}${hi ? `–${hi - 1}` : '+'}` : `Z${z}`;
});
const zonesSpec: ChartSpec = {
  type: 'bar',
  categories: zoneLabels,
  series: [{ name: 'Tiempo en zona', data: run ? run.hrZonesS.map((s) => Math.round(s)) : [], color: 1 }],
  format: 'hm',
  height: 220,
};
---

<Base title={run?.name ?? 'Actividad'}>
  <a href="/actividades" class="text-sm text-blue-700 hover:underline dark:text-blue-400">← Actividades</a>
  {
    !client ? (
      <ConnectPrompt />
    ) : error ? (
      <ErrorState error={error} />
    ) : (
      run && (
        <div class="mt-3 space-y-6">
          <div>
            <h1 class="text-2xl font-bold">{run.name}</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400">
              {dayLabel(run.date)} · {run.startLocal.slice(11, 16)} · {activityLabel(run.typeKey)}
            </p>
          </div>

          <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
            {showDistance && (
              <StatCard label="Distancia" value={swim ? int(run.distanceKm * 1000) : km(run.distanceKm, 2)} unit={swim ? 'm' : 'km'} />
            )}
            <StatCard label="Tiempo en movimiento" value={duration(run.movingS)} hint={`Total ${duration(run.durationS)}`} />
            {avgSpeed !== undefined && (
              <StatCard label={speedLabel(kind)} value={kind === 'cycling' ? speed(avgSpeed) : pace(avgSpeed)} unit={speedUnit(kind)} />
            )}
            <StatCard label="FC media / máx" value={`${int(run.avgHr)} / ${int(run.maxHr)}`} unit="ppm" />
            {run.elevationGainM ? <StatCard label="Desnivel +" value={int(run.elevationGainM)} unit="m" /> : null}
            {run.cadenceSpm ? <StatCard label="Cadencia" value={int(run.cadenceSpm)} unit="pasos/min" /> : null}
            <StatCard
              label="Efecto entreno"
              value={run.aerobicTE !== undefined ? km(run.aerobicTE) : '—'}
              hint={`${trainingEffect(run.trainingEffectLabel)} · anaeróbico ${run.anaerobicTE !== undefined ? km(run.anaerobicTE) : '—'}`}
            />
            <StatCard label="Carga" value={int(run.trainingLoad)} hint={run.calories ? `${int(run.calories)} kcal` : undefined} />
          </div>

          {zoneTotal > 0 && (
            <ChartCard
              title="Tiempo en zonas de FC"
              subtitle={zones ? 'Rangos en ppm según tus zonas de Garmin' : undefined}
              spec={zonesSpec}
              table={{
                headers: ['Zona', 'Tiempo', '%'],
                rows: zoneLabels.map((z, i) => [z, duration(run!.hrZonesS[i]), `${Math.round((run!.hrZonesS[i] / zoneTotal) * 100)} %`]),
              }}
            />
          )}
        </div>
      )
    )
  }
</Base>
