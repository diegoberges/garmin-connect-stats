---
import Base from '../../layouts/Base.astro';
import ConnectPrompt from '../../components/ConnectPrompt.astro';
import ErrorState from '../../components/ErrorState.astro';
import RouteMap from '../../components/RouteMap.astro';
import TrophyTip from '../../components/TrophyTip.astro';
import {
  GAP_BUCKET,
  clientFor,
  getActivity,
  getActivityTrack,
  getAllActivities,
  getHrReference,
  getHrZones,
  getWeights,
  type Activity,
  type ActivityExtra,
  type ActivityTrack,
  type HrZones,
} from '../../lib/garmin';
import { hasDistance, kindOf, mapStyleFor, speedUnit, speedValue } from '../../lib/activity-kinds';
import { activityLabel, dayLabel, duration, int, km, pace, shortDate, speed, trainingEffect } from '../../lib/format';
import type { ChartSpec } from '../../lib/chart-spec';
import { addDays, isoDate } from '../../lib/dates';
import { estimateHrParams, sessionLoad } from '../../lib/load';
import { efficiencyFactor } from '../../lib/efficiency';
import { PACE_ZONES, paceZoneBounds, sameRoute, timeInPaceZones, vdotForDate } from '../../lib/activity-analysis';
import { card } from '../../lib/ui';

const id = Number(Astro.params.id);
const client = clientFor(Astro.locals);

let run: (Activity & { extra: ActivityExtra }) | undefined;
let track: ActivityTrack | undefined;
let zones: HrZones | undefined;
let history: Activity[] | undefined;
let hrRef: { restingHr: number; maxHr: number } | undefined;
let weightKg: number | undefined;
let error: unknown;
if (client && Number.isInteger(id) && id > 0) {
  try {
    run = await getActivity(client, id);
    if (run) {
      const k = kindOf(run.typeKey);
      const sport = k === 'cycling' ? 'CYCLING' : k === 'swim' ? 'SWIMMING' : 'RUNNING';
      // El recorrido sale del archivo FIT: si falla, la página se muestra sin él
      const today = isoDate();
      [zones, track, history, hrRef, weightKg] = await Promise.all([
        getHrZones(client, sport).catch(() => undefined),
        getActivityTrack(client, id).catch((err) => {
          console.error('[garmin] recorrido', id, err);
          return undefined;
        }),
        // Historial (memo de 6 h): zonas de ritmo de esa fecha y actividades en la misma ruta
        getAllActivities(client, today).catch(() => undefined),
        getHrReference(client).catch(() => undefined),
        // Peso más reciente hasta esa fecha, solo si hay potencia (para W/kg)
        run.extra.avgPower
          ? getWeights(client, addDays(run.date, -90), run.date)
              .then((w) => w.at(-1)?.kg)
              .catch(() => undefined)
          : Promise.resolve(undefined),
      ]);
    }
  } catch (err) {
    error = err;
  }
}
if (client && !error && !run) return new Response('Actividad no encontrada', { status: 404 });

// ---------- Derivados ----------
const kind = run ? kindOf(run.typeKey) : 'other';
const swim = kind === 'swim';
const cycling = kind === 'cycling';
const x = run?.extra;
const fmtSpeed = (v?: number) => (v === undefined ? '—' : cycling ? speed(v) : pace(v));
/** m/s → ritmo o velocidad en la unidad de la familia */
const fromMs = (ms?: number) =>
  ms === undefined || ms <= 0
    ? undefined
    : cycling
      ? ms * 3.6
      : swim
        ? 100 / ms
        : kind === 'foot'
          ? 1000 / ms
          : undefined;
const avgSpeed = run ? speedValue(kind, run.distanceKm, run.movingS) : undefined;
const showDistance = run !== undefined && hasDistance(kind) && run.distanceKm > 0;
const hasMap = (track?.route.length ?? 0) > 1;

// Cifras principales (grandes): dependen de si hay distancia
const headline: { label: string; value: string; unit?: string }[] = run
  ? showDistance
    ? [
        {
          label: 'Distancia',
          value: swim ? int(run.distanceKm * 1000) : km(run.distanceKm, 2),
          unit: swim ? 'm' : 'km',
        },
        { label: 'Tiempo', value: duration(run.movingS) },
        { label: cycling ? 'Velocidad' : 'Ritmo', value: fmtSpeed(avgSpeed), unit: speedUnit(kind) },
      ]
    : [
        { label: 'Tiempo', value: duration(run.movingS) },
        { label: 'FC media', value: int(run.avgHr), unit: 'ppm' },
        { label: 'Calorías', value: int(run.calories), unit: 'kcal' },
      ]
  : [];

// Ritmo ajustado por pendiente (Minetti): solo a pie y si el desnivel lo cambia de forma apreciable
const gapPace =
  kind === 'foot' &&
  track?.gapDistanceM &&
  track.activeS &&
  run?.elevationGainM &&
  run.elevationGainM / run.distanceKm >= 5
    ? track.activeS / (track.gapDistanceM / 1000)
    : undefined;

// Carga de la sesión con la métrica única de la app (TRIMP de Banister)
const trimp =
  run?.avgHr && run.movingS > 0
    ? sessionLoad(run, { ...(hrRef ?? estimateHrParams(history ?? [run])), sex: Astro.locals.settings.sex })
    : undefined;
/** Sensación de Garmin (0, 25, 50, 75, 100) en texto. */
function feelLabel(v: number): string {
  if (v >= 87.5) return 'Muy bien';
  if (v >= 62.5) return 'Bien';
  if (v >= 37.5) return 'Normal';
  if (v >= 12.5) return 'Mal';
  return 'Muy mal';
}

// Potencia (solo con sensor): media, normalizada, índice de variabilidad y W/kg
const power = [
  x?.avgPower !== undefined ? ['Potencia media', `${int(x.avgPower)} W`] : null,
  x?.normPower !== undefined ? ['Potencia normalizada', `${int(x.normPower)} W`] : null,
  x?.avgPower && x?.normPower ? ['Índice de variabilidad', km(x.normPower / x.avgPower, 2)] : null,
  x?.avgPower && weightKg ? ['Potencia por kilo', `${km(x.avgPower / weightKg, 2)} W/kg`] : null,
  x?.maxPower !== undefined ? ['Potencia máxima', `${int(x.maxPower)} W`] : null,
].filter((r): r is [string, string] => r !== null);

// Secundarias del panel
const secondary = [
  run?.avgHr && showDistance ? ['FC media', `${int(run.avgHr)} ppm`] : null,
  run?.maxHr ? ['FC máxima', `${int(run.maxHr)} ppm`] : null,
  run?.elevationGainM ? ['Desnivel', `+${int(run.elevationGainM)} / −${int(x?.elevationLossM)} m`] : null,
  run?.cadenceSpm ? ['Cadencia', `${int(run.cadenceSpm)} pasos/min`] : null,
  run?.calories && showDistance ? ['Calorías', `${int(run.calories)} kcal`] : null,
  trimp ? ['Carga (TRIMP)', int(trimp)] : null,
  run?.extra.rpe !== undefined ? ['Esfuerzo percibido', `${km(run.extra.rpe)} / 10`] : null,
  run?.extra.feel !== undefined ? ['Sensación', feelLabel(run.extra.feel)] : null,
  run && run.durationS - run.movingS > 30 ? ['Tiempo total', duration(run.durationS)] : null,
  gapPace !== undefined ? ['Ritmo ajustado por pendiente', `${pace(gapPace)} /km`] : null,
  track?.decoupling ? ['Desacoplamiento', `${km(track.decoupling.pct)} %`] : null,
].filter((r): r is [string, string] => r !== null);

// Efecto del entrenamiento (escala de Garmin 0–5)
const te = [
  { label: 'Aeróbico', value: run?.aerobicTE },
  { label: 'Anaeróbico', value: run?.anaerobicTE },
].filter((t) => t.value !== undefined) as { label: string; value: number }[];

// Dinámica de carrera y otros datos: solo lo que exista
const dynamics = [
  x?.strideLengthCm !== undefined ? ['Zancada', `${km(x.strideLengthCm / 100, 2)} m`] : null,
  x?.groundContactMs !== undefined ? ['Contacto con el suelo', `${int(x.groundContactMs)} ms`] : null,
  x?.verticalOscillationCm !== undefined ? ['Oscilación vertical', `${km(x.verticalOscillationCm)} cm`] : null,
  x?.verticalRatio !== undefined ? ['Ratio vertical', `${km(x.verticalRatio)} %`] : null,
  x?.maxCadence !== undefined ? ['Cadencia máx', `${int(x.maxCadence)} pasos/min`] : null,
  x?.respirationRate !== undefined ? ['Respiración', `${int(x.respirationRate)} rpm`] : null,
].filter((r): r is [string, string] => r !== null);
const others = [
  track?.fastestSplitS !== undefined && kind === 'foot' ? ['Mejor km', `${pace(track.fastestSplitS)} /km`] : null,
  fromMs(x?.maxSpeed) !== undefined && kind !== 'other'
    ? [cycling ? 'Velocidad máx' : 'Ritmo máx', `${fmtSpeed(fromMs(x?.maxSpeed))} ${speedUnit(kind)}`]
    : null,
  x?.minHr !== undefined ? ['FC mínima', `${int(x.minHr)} ppm`] : null,
  x?.minElevationM !== undefined && x?.maxElevationM !== undefined && hasDistance(kind)
    ? ['Altitud', `${int(x.minElevationM)}–${int(x.maxElevationM)} m`]
    : null,
  x?.temperatureC !== undefined ? ['Temperatura', `${int(x.temperatureC)} °C`] : null,
  x?.steps !== undefined ? ['Pasos', int(x.steps)] : null,
].filter((r): r is [string, string] => r !== null);

// ---------- Series sincronizadas ----------
const series = track?.series ?? [];
const xCats = series.map((p) => (track?.xUnit === 'km' ? `${km(p.x)} km` : `${Math.round(p.x)} min`));
const smooth = (vals: (number | undefined)[]) =>
  vals.map((_, i) => {
    const w = vals.slice(Math.max(0, i - 1), i + 2).filter((v): v is number => v !== undefined);
    return w.length ? w.reduce((a, b) => a + b, 0) / w.length : undefined;
  });
// Paradas (< 0,5 m/s) fuera para que no disparen el eje de ritmo
const speeds = smooth(series.map((p) => (p.speed !== undefined && p.speed >= 0.5 ? p.speed : undefined)));
const paceSeries = speeds.map((ms) => {
  const v = fromMs(ms);
  return v === undefined ? null : cycling ? Math.round(v * 10) / 10 : Math.round(v);
});
// Mismo ritmo ajustado por pendiente (solo a pie y con desnivel apreciable)
const gapSeries =
  gapPace !== undefined
    ? smooth(series.map((p) => (p.gapSpeed !== undefined && p.gapSpeed >= 0.5 ? p.gapSpeed : undefined))).map((ms) => {
        const v = fromMs(ms);
        return v === undefined ? null : Math.round(v);
      })
    : undefined;
const charts: { title: string; spec: ChartSpec }[] = [];
if (kind !== 'other' && paceSeries.some((v) => v !== null)) {
  charts.push({
    title: cycling ? 'Velocidad (km/h)' : swim ? 'Ritmo (min/100 m)' : 'Ritmo (min/km)',
    spec: {
      type: 'line',
      categories: xCats,
      series: [
        { name: cycling ? 'Velocidad' : 'Ritmo', data: paceSeries, color: 1 },
        ...(gapSeries ? [{ name: 'Ajustado por pendiente', data: gapSeries, color: 4 as const }] : []),
      ],
      format: cycling ? 'kmh' : swim ? 'pace100' : 'pace',
      reversed: !cycling,
      height: 150,
    },
  });
}
if (series.some((p) => p.hr !== undefined)) {
  charts.push({
    title: 'Frecuencia cardiaca (ppm)',
    spec: {
      type: 'line',
      categories: xCats,
      series: [{ name: 'FC', data: series.map((p) => p.hr ?? null), color: 2 }],
      format: 'bpm',
      height: 150,
    },
  });
}
if (hasDistance(kind) && series.filter((p) => p.alt !== undefined).length > 2) {
  charts.push({
    title: 'Altitud (m)',
    spec: {
      type: 'area',
      categories: xCats,
      series: [
        { name: 'Altitud', data: series.map((p) => (p.alt === undefined ? null : Math.round(p.alt))), color: 3 },
      ],
      format: 'int',
      height: 130,
    },
  });
}
// Cadencia a pie: el FIT la da en zancadas/min (una pierna); se muestra en pasos/min
if (kind === 'foot' && series.filter((p) => p.cadence).length > 2) {
  charts.push({
    title: 'Cadencia (pasos/min)',
    spec: {
      type: 'line',
      categories: xCats,
      series: [
        {
          name: 'Cadencia',
          data: smooth(series.map((p) => (p.cadence && p.cadence > 20 ? p.cadence * 2 : undefined))).map((v) =>
            v === undefined ? null : Math.round(v),
          ),
          color: 4,
        },
      ],
      format: 'int',
      height: 130,
    },
  });
}
if (series.filter((p) => p.resp !== undefined).length > 2) {
  charts.push({
    title: 'Respiración (rpm)',
    spec: {
      type: 'line',
      categories: xCats,
      series: [{ name: 'Respiración', data: series.map((p) => p.resp ?? null), color: 3 }],
      format: 'int',
      height: 130,
    },
  });
}
charts.forEach((c, i) => {
  c.spec.group = 'actividad';
  c.spec.hideXLabels = i < charts.length - 1;
  // Arrastrar sobre una gráfica amplía el tramo en todas (mismo grupo)
  c.spec.zoom = charts.length > 1;
  // Los botones solo en la primera: el zoom y el restablecer valen para todas
  c.spec.zoomControls = i === 0;
});

// ---------- Parciales ----------
const splits = kind === 'foot' || cycling ? (track?.splits ?? []) : [];
const splitRows = splits.map((sp) => ({ ...sp, v: speedValue(kind, sp.distanceM / 1000, sp.timeS) }));
const vals = splitRows.map((r) => r.v).filter((v): v is number => v !== undefined);
const best = vals.length ? (cycling ? Math.max(...vals) : Math.min(...vals)) : undefined;
const worst = vals.length ? (cycling ? Math.min(...vals) : Math.max(...vals)) : undefined;
/** Ancho de barra: el km más rápido al 100 %, el más lento al 35 % (vale para ritmo y para velocidad) */
/** Media de los km completos y diferencia de cada parcial (s/km a pie; km/h en bici). */
const fullVals = splitRows.filter((r) => r.distanceM >= 999 && r.v !== undefined).map((r) => r.v!);
const splitMean = fullVals.length ? fullVals.reduce((a, b) => a + b, 0) / fullVals.length : undefined;
function vsMean(v?: number): string {
  if (v === undefined || splitMean === undefined) return '';
  const d = v - splitMean;
  if (cycling) return `${d >= 0 ? '+' : '−'}${km(Math.abs(d))}`;
  if (Math.abs(d) < 1) return '±0 s';
  return `${d > 0 ? '+' : '−'}${Math.round(Math.abs(d))} s`;
}
/** Ritmo ajustado por pendiente de cada parcial (a pie y con desnivel apreciable). */
const showSplitGap = kind === 'foot' && gapPace !== undefined;
const splitGap = (sp: { gapDistanceM?: number; timeS: number }) =>
  sp.gapDistanceM && sp.gapDistanceM > 0 ? sp.timeS / (sp.gapDistanceM / 1000) : undefined;
const barPct = (v?: number) =>
  v === undefined || best === undefined || worst === undefined
    ? 0
    : best === worst
      ? 100
      : 35 + (65 * (worst - v)) / (worst - best);

// ---------- Zonas ----------
const zoneTotal = run ? run.hrZonesS.reduce((a, b) => a + b, 0) : 0;
const zoneRows = [1, 2, 3, 4, 5].map((z, i) => {
  const lo = zones?.floors[i];
  const hi = zones?.floors[i + 1] ?? zones?.maxHr;
  const s = run?.hrZonesS[i] ?? 0;
  return {
    zone: `Z${z}`,
    range: lo ? `${lo}${hi ? `–${hi - 1}` : '+'} ppm` : '',
    time: duration(s),
    pct: zoneTotal ? (s / zoneTotal) * 100 : 0,
  };
});
// ---------- Zonas de ritmo (GAP), con el VDOT de los 180 días anteriores a la actividad ----------
const runHistory = (history ?? []).filter((a) => /run/.test(a.typeKey));
const zoneVdot =
  run && kind === 'foot' && /run/.test(run.typeKey) ? vdotForDate([...runHistory, run], run.date) : undefined;
const paceBounds = zoneVdot ? paceZoneBounds(zoneVdot) : undefined;
const paceZoneS =
  paceBounds && track?.gapTimeBySpeed ? timeInPaceZones(track.gapTimeBySpeed, GAP_BUCKET, paceBounds) : undefined;
const paceZoneTotal = paceZoneS?.reduce((a, b) => a + b, 0) ?? 0;
const paceZoneRows = PACE_ZONES.map((z, i) => {
  const fast = paceBounds?.[i];
  const slow = i > 0 ? paceBounds?.[i - 1] : undefined;
  let range = '';
  if (fast === undefined) range = `más rápido de ${pace(1000 / slow!)}`;
  else if (slow === undefined) range = `más lento de ${pace(1000 / fast)}`;
  else range = `${pace(1000 / slow)}–${pace(1000 / fast)}`;
  const sec = paceZoneS?.[i] ?? 0;
  return { label: z.label, range, time: duration(sec), pct: paceZoneTotal ? (sec / paceZoneTotal) * 100 : 0 };
});

// ---------- VFC intra-sesión ----------
const rr = track?.rr;

// ---------- Misma ruta ----------
const routeMatches = run && history ? sameRoute(run, [...history.filter((a) => a.id !== run!.id), run]) : [];
const showRoute = routeMatches.length >= 2;
const routeSpeed = (a: Activity) => speedValue(kind, a.distanceKm, a.movingS);
const routeSpec: ChartSpec | undefined =
  routeMatches.length >= 3
    ? {
        type: 'line',
        categories: routeMatches.map((a) => `${shortDate(a.date)} ${a.date.slice(2, 4)}`),
        series: [
          {
            name: cycling ? 'Velocidad' : 'Ritmo',
            data: routeMatches.map((a) => {
              const v = routeSpeed(a);
              return v === undefined ? null : Math.round(cycling ? v * 10 : v) / (cycling ? 10 : 1);
            }),
            color: 1,
          },
        ],
        format: cycling ? 'kmh' : 'pace',
        reversed: !cycling,
        height: 200,
      }
    : undefined;

/** Intensidad creciente de un mismo color para las zonas (escala ordinal) */
const ZONE_OPACITY = [0.3, 0.45, 0.6, 0.8, 1];

const label = 'type-label';
---

<Base title={run?.name ?? 'Actividad'}>
  <a
    href="/actividades"
    class="text-sm text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground"
    >← Actividades</a
  >
  {!client ? (
    <ConnectPrompt />
  ) : error ? (
    <ErrorState error={error} />
  ) : (
    run && (
      <div class="mt-3 space-y-6">
        <header>
          <span class="chip">{activityLabel(run.typeKey)}</span>
          <h1 class="type-display mt-2 flex items-center gap-2">
            {run.name}
            {run.isPr && <TrophyTip label="Récord personal en Garmin" class="h-6 w-6" />}
          </h1>
          <p class="text-sm text-muted-foreground">
            {dayLabel(run.date)} · {run.startLocal.slice(11, 16)}
          </p>
        </header>

        <div class:list={['grid gap-6', hasMap && 'lg:grid-cols-5']}>
          {hasMap && (
            <div class="min-w-0 lg:col-span-3">
              <RouteMap route={track!.route} style={mapStyleFor(run.typeKey)} />
            </div>
          )}
          <section class:list={[card, 'flex flex-col p-5', hasMap && 'lg:col-span-2']}>
            <dl class="grid grid-cols-3 gap-3">
              {headline.map((h) => (
                <div class="min-w-0">
                  <dt class={label}>{h.label}</dt>
                  <dd class="mt-1 type-kpi">
                    {h.value}
                    {h.unit && <span class="ml-0.5 text-sm font-normal text-muted-foreground">{h.unit}</span>}
                  </dd>
                </div>
              ))}
            </dl>

            {secondary.length > 0 && (
              <dl class="mt-5 grid grid-cols-1 gap-x-6 gap-y-2.5 border-t pt-4 text-sm sm:grid-cols-2 border-border">
                {secondary.map(([l, v]) => (
                  <div class="flex items-baseline justify-between gap-2">
                    <dt class="text-muted-foreground">{l}</dt>
                    <dd class="font-semibold tabular-nums">{v}</dd>
                  </div>
                ))}
              </dl>
            )}

            {te.length > 0 && (
              <div class="mt-5 border-t pt-4 border-border">
                <div class="flex items-baseline justify-between gap-2">
                  <p class={label}>Efecto del entrenamiento</p>
                  <p class="text-sm font-medium">{trainingEffect(run.trainingEffectLabel)}</p>
                </div>
                <div class="mt-3 space-y-2">
                  {te.map((t, i) => (
                    <div class="grid grid-cols-[6rem_1fr_2.5rem] items-center gap-3 text-sm">
                      <span class="text-muted-foreground">{t.label}</span>
                      <span class="h-2 overflow-hidden bg-muted">
                        <span
                          class="block h-full"
                          style={`width:${Math.min(100, (t.value / 5) * 100)}%;background:var(--viz-${i === 0 ? 1 : 2})`}
                        />
                      </span>
                      <span class="text-right font-semibold tabular-nums">{km(t.value)}</span>
                    </div>
                  ))}
                </div>
                <p class="mt-2 text-xs text-muted-foreground">Escala de Garmin de 0 a 5.</p>
              </div>
            )}
          </section>
        </div>

        {charts.length > 0 && (
          <section class:list={[card, 'min-w-0 p-4']}>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h2 class="type-card">A lo largo de la actividad</h2>
              {charts.length > 1 && (
                <p class="text-xs text-muted-foreground">
                  Pasa el cursor: las gráficas marcan el mismo punto. Arrastra sobre una para ampliar un tramo en todas
                </p>
              )}
            </div>
            <div class="mt-3 divide-y divide-border">
              {charts.map((c) => (
                <div class="py-2 first:pt-0">
                  <p class="mb-1 text-sm text-muted-foreground">{c.title}</p>
                  <div
                    class="w-full min-w-0"
                    data-chart={JSON.stringify(c.spec)}
                    role="img"
                    aria-label={c.title}
                    style={`min-height:${c.spec.height}px`}
                  />
                </div>
              ))}
            </div>
          </section>
        )}

        <div class:list={['grid items-start gap-6', splitRows.length > 1 && 'lg:grid-cols-2']}>
          {splitRows.length > 1 && (
            <section class:list={[card, 'min-w-0 p-4']}>
              <h2 class="type-card">Parciales por km</h2>
              <section class="mt-3 overflow-x-auto" tabindex="0" aria-labelledby="tabla-parciales">
                <table class="w-full text-sm">
                  <caption id="tabla-parciales" class="sr-only">
                    Parciales por km
                  </caption>
                  <thead class="border-b border-border text-xs text-muted-foreground">
                    <tr>
                      <th scope="col" class="py-1 pr-3 text-left font-medium">
                        Km
                      </th>
                      <th scope="col" class="py-1 pr-3 text-left font-medium">
                        {cycling ? 'km/h' : 'Ritmo'}
                      </th>
                      {showSplitGap && (
                        <th scope="col" class="py-1 pr-3 text-left font-medium whitespace-nowrap">
                          GAP
                        </th>
                      )}
                      <th scope="col" class="hidden py-1 pr-3 text-right font-medium whitespace-nowrap sm:table-cell">
                        vs media
                      </th>
                      <th scope="col" class="w-full py-1">
                        <span class="sr-only">Comparación</span>
                      </th>
                      <th scope="col" class="py-1 pl-3 text-right font-medium">
                        FC
                      </th>
                      <th scope="col" class="py-1 pl-3 text-right font-medium whitespace-nowrap">
                        Desn. +/−
                      </th>
                    </tr>
                  </thead>
                  <tbody class="tabular-nums">
                    {splitRows.map((r) => (
                      <tr class="border-t border-border">
                        <td class="py-1.5 pr-3 whitespace-nowrap text-muted-foreground">
                          {r.distanceM >= 999 ? r.index : km(r.distanceM / 1000, 2)}
                        </td>
                        <td
                          class:list={[
                            'py-1.5 pr-3 font-semibold',
                            r.v === best &&
                              'text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground',
                          ]}
                        >
                          {fmtSpeed(r.v)}
                        </td>
                        {showSplitGap && (
                          <td class="py-1.5 pr-3 whitespace-nowrap text-muted-foreground">
                            {splitGap(r) === undefined ? '—' : pace(splitGap(r))}
                          </td>
                        )}
                        <td class="hidden py-1.5 pr-3 text-right whitespace-nowrap sm:table-cell text-muted-foreground">
                          {r.distanceM >= 999 ? vsMean(r.v) : ''}
                        </td>
                        <td class="py-1.5">
                          <span
                            class="block h-2"
                            style={`width:${barPct(r.v)}%;background:var(--viz-1);opacity:${r.v === best ? 1 : 0.5}`}
                          />
                        </td>
                        <td class="py-1.5 pl-3 text-right">{int(r.avgHr)}</td>
                        <td class="py-1.5 pl-3 text-right whitespace-nowrap text-muted-foreground">
                          +{r.elevGainM} / −{r.elevLossM}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </section>
              <p class="mt-2 text-xs text-muted-foreground">
                Barra más larga = km más rápido (resaltado en azul). «vs media»: diferencia con la media de los km
                completos ({cycling ? 'km/h' : 's/km; + es más lento'})
                {showSplitGap ? '. GAP: ritmo ajustado por pendiente (Minetti)' : ''}.
              </p>
            </section>
          )}

          <div class="min-w-0 space-y-6">
            {zoneTotal > 0 && (
              <section class:list={[card, 'p-4']}>
                <h2 class="type-card">Zonas de frecuencia cardiaca</h2>
                <ul class="mt-3 space-y-2.5 text-sm">
                  {zoneRows.map((z, i) => (
                    <li class="grid grid-cols-[2rem_1fr_3rem_4.5rem] items-center gap-3">
                      <span class="font-semibold">{z.zone}</span>
                      <span class="min-w-0">
                        <span class="block h-2.5 overflow-hidden bg-muted">
                          <span
                            class="block h-full"
                            style={`width:${z.pct}%;background:var(--viz-2);opacity:${ZONE_OPACITY[i]}`}
                          />
                        </span>
                        {z.range && <span class="text-xs text-muted-foreground">{z.range}</span>}
                      </span>
                      <span class="text-right font-semibold tabular-nums">{Math.round(z.pct)} %</span>
                      <span class="text-right tabular-nums text-muted-foreground">{z.time}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {paceZoneS && paceZoneTotal > 0 && (
              <section class:list={[card, 'p-4']}>
                <h2 class="type-card">Zonas de ritmo (ajustado por pendiente)</h2>
                <p class="text-xs text-muted-foreground">
                  Ritmos de Daniels con tu VDOT de esa fecha ({km(zoneVdot)}, mejores marcas de los 180 días previos):
                  un cambio de forma no reescribe actividades antiguas.
                </p>
                <ul class="mt-3 space-y-2.5 text-sm">
                  {paceZoneRows.map((z, i) => (
                    <li class="grid grid-cols-[7.5rem_1fr_3rem_4.5rem] items-center gap-3">
                      <span class="font-semibold">{z.label}</span>
                      <span class="min-w-0">
                        <span class="block h-2.5 overflow-hidden bg-muted">
                          <span
                            class="block h-full"
                            style={`width:${z.pct}%;background:var(--viz-1);opacity:${ZONE_OPACITY[i]}`}
                          />
                        </span>
                        <span class="text-xs text-muted-foreground">{z.range} /km</span>
                      </span>
                      <span class="text-right font-semibold tabular-nums">{Math.round(z.pct)} %</span>
                      <span class="text-right tabular-nums text-muted-foreground">{z.time}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {rr && (
              <section class:list={[card, 'p-4']}>
                <h2 class="type-card">Variabilidad de la FC durante la sesión</h2>
                <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-2 text-sm sm:grid-cols-3">
                  <div>
                    <dt class="text-muted-foreground">RMSSD</dt>
                    <dd class="font-semibold tabular-nums">{km(rr.rmssd)} ms</dd>
                  </div>
                  <div>
                    <dt class="text-muted-foreground">ln RMSSD</dt>
                    <dd class="font-semibold tabular-nums">{km(rr.lnRmssd, 2)}</dd>
                  </div>
                  <div>
                    <dt class="text-muted-foreground">SDNN</dt>
                    <dd class="font-semibold tabular-nums">{km(rr.sdnn)} ms</dd>
                  </div>
                  <div>
                    <dt class="text-muted-foreground">pNN50</dt>
                    <dd class="font-semibold tabular-nums">{km(rr.pnn50)} %</dd>
                  </div>
                  <div>
                    <dt class="text-muted-foreground">Latidos útiles</dt>
                    <dd class="font-semibold tabular-nums">{int(rr.count)}</dd>
                  </div>
                  <div>
                    <dt class="text-muted-foreground">Descartados</dt>
                    <dd class="font-semibold tabular-nums">{km(rr.artifactPct)} %</dd>
                  </div>
                </dl>
                <p class="mt-2 text-xs text-muted-foreground">
                  Intervalos RR del archivo FIT, sin artefactos. En ejercicio la VFC cae mucho: compárala solo con
                  sesiones parecidas, no con la nocturna. Evidencia limitada.
                </p>
              </section>
            )}

            {(dynamics.length > 0 || power.length > 0 || others.length > 0) && (
              <section
                class:list={[
                  card,
                  'grid gap-6 p-4',
                  [dynamics, power, others].filter((g) => g.length > 0).length > 1 && 'sm:grid-cols-2',
                ]}
              >
                {[
                  { title: 'Dinámica de carrera', rows: dynamics },
                  { title: 'Potencia', rows: power },
                  { title: 'Otros datos', rows: others },
                ]
                  .filter((g) => g.rows.length > 0)
                  .map((g) => (
                    <div>
                      <h2 class="type-card">{g.title}</h2>
                      <dl class="mt-3 space-y-2 text-sm">
                        {g.rows.map(([l, v]) => (
                          <div class="flex items-baseline justify-between gap-2">
                            <dt class="text-muted-foreground">{l}</dt>
                            <dd class="font-semibold tabular-nums">{v}</dd>
                          </div>
                        ))}
                      </dl>
                    </div>
                  ))}
              </section>
            )}
          </div>
        </div>

        {showRoute && (
          <section class:list={[card, 'min-w-0 p-4']} aria-labelledby="misma-ruta">
            <h2 id="misma-ruta" class="type-card">
              En la misma ruta · {routeMatches.length} veces
            </h2>
            <p class="text-sm text-muted-foreground">
              Mismo deporte, salida a menos de 250 m y distancia parecida (±5 %).
            </p>
            {routeSpec && (
              <div
                class="mt-3 w-full min-w-0"
                data-chart={JSON.stringify(routeSpec)}
                role="img"
                aria-label={`${cycling ? 'Velocidad' : 'Ritmo'} en cada vez que hiciste esta ruta`}
                style="min-height:200px"
              />
            )}
            <section class="mt-3 overflow-x-auto" tabindex="0" aria-labelledby="tabla-ruta">
              <table class="w-full text-sm">
                <caption id="tabla-ruta" class="sr-only">
                  Actividades en la misma ruta
                </caption>
                <thead class="border-b border-border text-xs text-muted-foreground">
                  <tr>
                    <th scope="col" class="py-1 pr-3 text-left font-medium">
                      Fecha
                    </th>
                    <th scope="col" class="py-1 pr-3 text-right font-medium">
                      Tiempo
                    </th>
                    <th scope="col" class="py-1 pr-3 text-right font-medium">
                      {cycling ? 'km/h' : 'Ritmo'}
                    </th>
                    <th scope="col" class="py-1 pr-3 text-right font-medium">
                      FC
                    </th>
                    <th scope="col" class="hidden py-1 text-right font-medium sm:table-cell">
                      Eficiencia
                    </th>
                  </tr>
                </thead>
                <tbody class="tabular-nums">
                  {routeMatches.toReversed().map((a) => (
                    <tr class:list={['border-t border-border', a.id === run.id && 'font-semibold']}>
                      <td class="py-1.5 pr-3 whitespace-nowrap">
                        {a.id === run.id ? (
                          <span>
                            {shortDate(a.date)} {a.date.slice(0, 4)} (esta)
                          </span>
                        ) : (
                          <a
                            href={`/actividades/${a.id}`}
                            class="text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground"
                          >
                            {shortDate(a.date)} {a.date.slice(0, 4)}
                          </a>
                        )}
                      </td>
                      <td class="py-1.5 pr-3 text-right">{duration(a.movingS)}</td>
                      <td class="py-1.5 pr-3 text-right whitespace-nowrap">{fmtSpeed(routeSpeed(a))}</td>
                      <td class="py-1.5 pr-3 text-right">{int(a.avgHr)}</td>
                      <td class="hidden py-1.5 text-right sm:table-cell">
                        {efficiencyFactor(a) === undefined ? '—' : km(efficiencyFactor(a), 2)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
            <p class="mt-2 text-xs text-muted-foreground">
              Eficiencia: metros por minuto ÷ FC media (más alto = más rápido con el mismo esfuerzo).
            </p>
          </section>
        )}
      </div>
    )
  )}
</Base>

<script>
  import '../../scripts/charts';
</script>
