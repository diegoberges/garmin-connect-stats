---
/**
 * Calidad de datos: actividades de todo el historial que conviene revisar en Garmin Connect porque
 * distorsionan las estadísticas (duplicadas, carreras sin FC, errores de GPS y FC imposibles).
 * Heurísticas en lib/data-quality.ts.
 */
import Base from '../layouts/Base.astro';
import ConnectPrompt from '../components/ConnectPrompt.astro';
import ErrorState from '../components/ErrorState.astro';
import Pagination from '../components/Pagination.astro';
import { clientFor, getAllActivities, type Activity } from '../lib/garmin';
import { isoDate } from '../lib/dates';
import { dataIssues, ISSUE_LABELS, type DataIssue, type IssueKind } from '../lib/data-quality';
import { activityLabel, km, shortDate } from '../lib/format';

const PAGE_SIZE = 50;
const client = clientFor(Astro.locals);
const today = isoDate();

let all: Activity[] = [];
let error: unknown;
if (client) {
  try {
    all = await getAllActivities(client, today);
  } catch (err) {
    error = err;
  }
}

const issues = dataIssues(all);
const KINDS = Object.keys(ISSUE_LABELS) as IssueKind[];
const counts = new Map(KINDS.map((k) => [k, issues.filter((i) => i.kind === k).length]));
const requested = Astro.url.searchParams.get('tipo');
const kind = KINDS.find((k) => k === requested);
const shown: DataIssue[] = kind ? issues.filter((i) => i.kind === kind) : issues;
const pages = Math.max(1, Math.ceil(shown.length / PAGE_SIZE));
const page = Math.min(Math.max(1, Math.floor(Number(Astro.url.searchParams.get('pagina'))) || 1), pages);
const pageItems = shown.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const kindHref = (k?: IssueKind) => (k ? `?tipo=${k}` : '?');
const card = 'rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800';
const chip = (active: boolean) => [
  'rounded-full border px-3 py-1 text-sm font-medium',
  active
    ? 'border-blue-700 bg-blue-700 text-white dark:border-blue-600 dark:bg-blue-600'
    : 'border-gray-300 bg-white text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700',
];
---

<Base title="Calidad de datos">
  <h1 class="text-2xl font-bold">Calidad de datos</h1>
  <p class="mb-6 text-sm text-gray-500 dark:text-gray-400">
    Actividades de todo tu historial que conviene revisar en Garmin Connect: distorsionan la carga, las marcas o las
    tendencias. Son avisos heurísticos; que salga aquí no significa que esté mal.
  </p>

  {!client ? (
    <ConnectPrompt />
  ) : error ? (
    <ErrorState error={error} />
  ) : issues.length === 0 ? (
    <p class:list={[card, 'p-6 text-sm']}>No hemos encontrado nada raro en tus {all.length} actividades.</p>
  ) : (
    <div class="space-y-4">
      <nav aria-label="Tipo de problema" class="flex flex-wrap gap-2">
        <a href={kindHref()} aria-current={!kind ? 'true' : undefined} class:list={chip(!kind)}>
          Todos · {issues.length}
        </a>
        {KINDS.filter((k) => counts.get(k)).map((k) => (
          <a href={kindHref(k)} aria-current={kind === k ? 'true' : undefined} class:list={chip(kind === k)}>
            {ISSUE_LABELS[k]} · {counts.get(k)}
          </a>
        ))}
      </nav>

      <section class:list={[card, 'overflow-x-auto']} tabindex="0" aria-labelledby="tabla-calidad">
        <table class="w-full text-left text-sm">
          <caption id="tabla-calidad" class="sr-only">
            Actividades a revisar{kind ? `: ${ISSUE_LABELS[kind]}` : ''}, página {page} de {pages}
          </caption>
          <thead class="bg-gray-50 text-xs text-gray-600 uppercase dark:bg-gray-700 dark:text-gray-300">
            <tr>
              <th scope="col" class="px-3 py-3 sm:px-4">
                Fecha
              </th>
              <th scope="col" class="px-3 py-3 sm:px-4">
                Actividad
              </th>
              <th scope="col" class="px-3 py-3 sm:px-4">
                Aviso
              </th>
              <th scope="col" class="hidden px-4 py-3 sm:table-cell">
                Detalle
              </th>
            </tr>
          </thead>
          <tbody class="tabular-nums">
            {pageItems.map((i) => (
              <tr class="border-t border-gray-100 dark:border-gray-700">
                <td class="px-3 py-2.5 whitespace-nowrap sm:px-4">
                  {shortDate(i.activity.date)} {i.activity.date.slice(0, 4)}
                </td>
                <td class="px-3 py-2.5 sm:px-4">
                  <a
                    href={`/actividades/${i.activity.id}`}
                    class="font-medium text-blue-700 hover:underline dark:text-blue-400"
                  >
                    {i.activity.name}
                  </a>
                  <span class="block text-xs text-gray-500 dark:text-gray-400">
                    {activityLabel(i.activity.typeKey)}
                    {i.activity.distanceKm > 0 ? ` · ${km(i.activity.distanceKm, 2)} km` : ''}
                  </span>
                </td>
                <td class="px-3 py-2.5 sm:px-4">
                  <span class="rounded-sm bg-amber-100 px-1.5 py-0.5 text-xs font-semibold whitespace-nowrap text-amber-900 dark:bg-amber-900 dark:text-amber-100">
                    {ISSUE_LABELS[i.kind]}
                  </span>
                </td>
                <td class="hidden px-4 py-2.5 text-gray-600 sm:table-cell dark:text-gray-300">
                  {i.detail}
                  {i.other && (
                    <>
                      {' '}
                      (
                      <a href={`/actividades/${i.other.id}`} class="text-blue-700 hover:underline dark:text-blue-400">
                        {i.other.name}
                      </a>
                      )
                    </>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
      <Pagination page={page} pages={pages} total={shown.length} pageSize={PAGE_SIZE} label="Paginación de avisos" />
    </div>
  )}
</Base>
