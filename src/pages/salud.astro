---
/**
 * Salud: "¿cómo estoy hoy?" (señales frente a tu propio rango normal) y "¿llevo una vida sana?"
 * (marcadores con más evidencia a largo plazo). Criterios y fuentes: reports/Métricas de salud y rendimiento.md.
 */
import Base from '../layouts/Base.astro';
import ConnectPrompt from '../components/ConnectPrompt.astro';
import PageIndex from '../components/PageIndex.astro';
import ErrorState from '../components/ErrorState.astro';
import ChartCard from '../components/ChartCard.astro';
import Collapsible from '../components/Collapsible.astro';
import DataTable from '../components/DataTable.astro';
import {
  clientFor,
  getActivities,
  getDailyHealth,
  getHeartHistory,
  getHrReference,
  getWeights,
  getFitnessAge,
  getVo2Max,
  type Activity,
  type DayHealth,
  type FitnessAge,
  type Vo2Point,
} from '../lib/garmin';
import { addDays, isoDate } from '../lib/dates';
import { mean } from '../lib/stats';
import {
  RHR_ALERT_BPM,
  RHR_WINDOW,
  deltaTrend,
  hrvTrend,
  sleepDebt,
  stepTarget,
  todayStatus,
  weeklyIntensity,
  type SignalState,
} from '../lib/baseline';
import { dayLabel, hoursMinutes, int, km, shortDate } from '../lib/format';
import type { ChartSeries, ChartSpec } from '../lib/chart-spec';
import { vo2Percentile } from '../lib/vo2-norms';
import { type AlertLevel, alertHistory, resolveThresholds, type SleepFatigueAlert } from '../lib/sleep-alert';
import { WARMUP_DAYS, dailyLoad, estimateHrParams, pmc } from '../lib/load';
import { READINESS_WEIGHTS, readiness, readinessLabel } from '../lib/readiness';
import { weightChange, weightTrend } from '../lib/weight';
import { card } from '../lib/ui';
import { fmt } from '../scripts/chart-options';
import { bmi, bmiCategory, quarterChange, sleepRegularity, weeklyMean } from '../lib/long-term';

/** 90 días: 60 para las líneas base + 30 visibles; también cubre 12 semanas de minutos de intensidad. */
const FETCH_DAYS = 90;
const VIEW_DAYS = 30;
const WEEKS = 12;

const client = clientFor(Astro.locals);
const today = isoDate();

let all: DayHealth[] = [];
let vo2: Vo2Point[] = [];
let fitness: FitnessAge | undefined;
let acts: Activity[] | undefined;
let hrRef: { restingHr: number; maxHr: number } | undefined;
let weights: { date: string; kg: number }[] = [];
let heart: DayHealth[] | undefined;
let error: unknown;
if (client) {
  try {
    const from = addDays(today, -(FETCH_DAYS - 1));
    [all, vo2, fitness, acts, hrRef, weights, heart] = await Promise.all([
      getDailyHealth(client, from, today),
      getVo2Max(client, from, today).catch(() => []),
      getFitnessAge(client).catch(() => undefined),
      // Para la forma (TSB) de la disposición: si falla, se calcula sin ella
      getActivities(client, addDays(from, -WARMUP_DAYS), today).catch(() => undefined),
      getHrReference(client).catch(() => undefined),
      getWeights(client, from, today).catch(() => []),
      // 12 meses de FC en reposo y VFC (memo de 6 h); si falla, la página se muestra sin esas gráficas
      getHeartHistory(client, addDays(today, -363), today).catch(() => undefined),
    ]);
  } catch (err) {
    error = err;
  }
}

const v = (x?: number) => (x === undefined ? null : x);
const r = (x?: number) => (x === undefined ? null : Math.round(x));
const view = all.slice(-VIEW_DAYS);
const cats = view.map((d) => shortDate(d.date));
const offset = all.length - view.length;

// ---------- Hoy ----------
const status = todayStatus(all, { ms: (x) => `${Math.round(x)} ms`, hm: (s) => hoursMinutes(s) });
const STATE_TEXT = {
  normal: {
    title: 'Todo dentro de tu rango normal',
    text: 'Ninguna señal de recuperación se sale de lo habitual para ti.',
    tone: 'ok',
  },
  attention: {
    title: 'Atención: 2 señales fuera de rango',
    text: 'Puede ser cansancio, mal descanso o el inicio de algo. Valora un día más suave.',
    tone: 'warn',
  },
  alert: {
    title: 'Posible enfermedad o mala recuperación',
    text: 'Varias señales se salen a la vez de tu rango. Prioriza descansar.',
    tone: 'alert',
  },
  calibrating: {
    title: 'Calibrando tu rango normal',
    text: 'Hacen falta unas 3 semanas de datos nocturnos para comparar contigo mismo.',
    tone: 'muted',
  },
} as const;
/** "Deuda de sueño (7 noches)" → "deuda de sueño" */
const signalName = (label: string) => label.replace(/\s*\(.*\)$/, '').replace(/^./, (c) => c.toLowerCase());
const offSignal = status.signals.find((x) => x.state === 'warn');
// Con una sola señal fuera, el estado sigue siendo normal, pero se dice cuál: "ninguna" sería falso.
const state =
  status.state === 'normal' && status.warns === 1 && offSignal
    ? {
        ...STATE_TEXT.normal,
        title: `En tu rango, salvo ${signalName(offSignal.label)}`,
        text: 'Una sola señal fuera de lo habitual no basta para cambiar el plan; si mañana se suma otra, conviene un día más suave.',
      }
    : STATE_TEXT[status.state];
const DOT: Record<SignalState, string> = {
  ok: 'bg-green-500',
  warn: 'bg-amber-500',
  high: 'border-2 border-green-500',
  calibrating: 'bg-muted-foreground',
  nodata: 'bg-muted-foreground/40',
};
const DOT_LABEL: Record<SignalState, string> = {
  ok: 'En rango',
  warn: 'Fuera de rango',
  high: 'Por encima de tu rango (no suma)',
  calibrating: 'Calibrando',
  nodata: 'Sin datos',
};

// ---------- Disposición (readiness) ----------
const tsb = new Map<string, number>();
if (acts) {
  const hr = { ...(hrRef ?? estimateHrParams(acts)), sex: Astro.locals.settings.sex };
  for (const pt of pmc(dailyLoad(acts, addDays(today, -(FETCH_DAYS - 1 + WARMUP_DAYS)), today, hr)))
    if (pt.formPct !== undefined) tsb.set(pt.date, pt.form);
}
const settingsTarget = Astro.locals.settings.alert?.sleepTargetH;
// Si la noche de hoy no se ha sincronizado, la disposición es la de ayer
const readyDate =
  all.at(-1)?.sleepS === undefined && all.at(-1)?.hrvLastNight === undefined ? addDays(today, -1) : today;
const ready = readiness(all, readyDate, tsb, settingsTarget ? settingsTarget * 3600 : undefined);
const PART_VALUE: Record<string, (v: number) => string> = {
  hrv: (x) => `${Math.round(x)} ms`,
  rhr: (x) => `${Math.round(x)} ppm`,
  sleep: (x) => hoursMinutes(x),
  tsb: (x) => `${x > 0 ? '+' : ''}${Math.round(x)}`,
};
const zText = (z: number) => `${z >= 0 ? '+' : '−'}${Math.abs(z).toFixed(1).replace('.', ',')} DE`;

// ---------- Histórico de la alerta de fatiga por sueño ----------
const alertT = resolveThresholds(Astro.locals.settings.alert);
const alerts = alertHistory(all, addDays(today, -(VIEW_DAYS - 1)), today, alertT).reverse();

// ---------- Recuperación (30 días con banda) ----------
const hrv = hrvTrend(all).slice(offset);
const hrvSpec: ChartSpec = {
  type: 'line',
  categories: cats,
  band: {
    name: 'Tu rango normal',
    data: hrv.map((p) => (p.low !== undefined ? [Math.round(p.low), Math.round(p.high!)] : null)),
  },
  series: [
    { name: 'Media 7 días', data: hrv.map((p) => r(p.avg7)), color: 1 },
    { name: 'Cada noche', data: hrv.map((p) => v(p.daily)), color: 1, faint: true },
  ],
  format: 'ms',
};
const rhr = deltaTrend(all, (d) => d.restingHr, RHR_WINDOW).slice(offset);
const rhrSpec: ChartSpec = {
  type: 'line',
  categories: cats,
  band: {
    name: `Habitual ±${RHR_ALERT_BPM} ppm`,
    data: rhr.map((p) =>
      p.base !== undefined ? [Math.round(p.base - RHR_ALERT_BPM), Math.round(p.base + RHR_ALERT_BPM)] : null,
    ),
  },
  series: [{ name: 'FC en reposo', data: rhr.map((p) => v(p.value)), color: 2 }],
  format: 'bpm',
};
const needs = view.map((d) => d.sleepNeedS).filter((x): x is number => x !== undefined);
const avgNeed = needs.length ? mean(needs) : undefined;
// Las noches en que saltó la alerta de fatiga por sueño se pintan en el color de su nivel (como sus etiquetas):
// una serie por nivel, apiladas, así cada barra tiene un solo color y la leyenda dice qué significa.
const alertByDate = new Map(alerts.map((a) => [a.date, a]));
const sleepOf = (level?: AlertLevel) =>
  view.map((d) => (alertByDate.get(d.date)?.level === level ? v(d.sleepS) : null));
const sleepSeries: ChartSeries[] = [{ name: 'Sueño', data: sleepOf(undefined), color: 1 }];
if (alerts.some((a) => a.level === 'warning')) {
  sleepSeries.push({ name: 'Alerta de fatiga · aviso', data: sleepOf('warning'), color: 4 });
}
if (alerts.some((a) => a.level === 'high')) {
  sleepSeries.push({ name: 'Alerta de fatiga · alto', data: sleepOf('high'), color: 2 });
}
const sleepSpec: ChartSpec = {
  type: 'bar',
  categories: cats,
  series: sleepSeries,
  stacked: true,
  format: 'hm',
  reference: avgNeed ? { value: Math.round(avgNeed), label: 'Necesidad' } : undefined,
};
const levelText = (a?: SleepFatigueAlert) => (a ? (a.level === 'high' ? 'Alto' : 'Aviso') : '—');
const sleepTable = {
  headers: ['Noche', 'Sueño', 'Alerta', 'Noches cortas (7 d)', 'Deuda 7 días'],
  rows: view.toReversed().map((d) => {
    const a = alertByDate.get(d.date);
    return [
      dayLabel(d.date),
      d.sleepS !== undefined ? hoursMinutes(d.sleepS) : '—',
      levelText(a),
      a ? `${a.shortNights} de ${a.nightsWithData}` : '—',
      a ? hoursMinutes(a.debtS) : '—',
    ];
  }),
};
const hm1 = (h: number) => String(h).replace('.', ',');
const debt = sleepDebt(all);
const sleptNights = view.filter((d) => d.sleepS !== undefined);
const avgSleep = sleptNights.length ? mean(sleptNights.map((d) => d.sleepS!)) : undefined;
const pct7h = sleptNights.length
  ? (sleptNights.filter((d) => d.sleepS! >= 7 * 3600).length / sleptNights.length) * 100
  : undefined;

// ---------- Vida sana ----------
const lastVo2 = vo2.at(-1);
const vo2Spec: ChartSpec = {
  type: 'line',
  categories: vo2.map((p) => shortDate(p.date)),
  band: {
    name: 'Margen de error del reloj (±5 %)',
    data: vo2.map((p) => [Math.round(p.value * 0.95 * 10) / 10, Math.round(p.value * 1.05 * 10) / 10]),
  },
  series: [{ name: 'VO2máx', data: vo2.map((p) => p.value), color: 3 }],
  format: 'dec1',
  height: 220,
};
const sex = Astro.locals.settings.sex;
const vo2Age = fitness?.age;
const vo2Pct = lastVo2 && sex && vo2Age !== undefined ? vo2Percentile(lastVo2.value, vo2Age, sex) : undefined;
/** Posición (0–100 %) de un valor en la escala P5–P95 del grupo */
const scalePos = (value: number) => {
  if (!vo2Pct) return 0;
  const lo = vo2Pct.marks[0].value;
  const hi = vo2Pct.marks.at(-1)!.value;
  return Math.min(100, Math.max(0, ((value - lo) / (hi - lo)) * 100));
};
const firstVo2 = vo2[0];
const vo2Change = lastVo2 && firstVo2 && vo2.length > 1 ? lastVo2.value - firstVo2.value : undefined;

const intensity = weeklyIntensity(all, WEEKS, today, acts ?? []);
const fullWeeks = intensity.slice(0, -1); // la semana en curso aún no ha terminado
const weeksMet = fullWeeks.filter((w) => w.total >= 150).length;
const intensitySpec: ChartSpec = {
  type: 'bar',
  stacked: true,
  categories: intensity.map((w) => shortDate(w.week)),
  series: [
    { name: 'Moderados', data: intensity.map((w) => w.moderate), color: 1 },
    { name: 'Vigorosos (×2)', data: intensity.map((w) => w.vigorousX2), color: 2 },
  ],
  format: 'int',
  reference: { value: 150, label: 'OMS 150 min' },
  // El eje va de 0 a por encima de 150 para que la línea de la OMS siempre se vea
  yMin: 0,
  yMax: Math.max(180, Math.ceil((Math.max(...intensity.map((w) => w.total)) * 1.1) / 30) * 30),
};

const age = fitness?.age;
const target = stepTarget(age);
const stepsOf = (ds: DayHealth[]) => {
  const xs = ds.map((d) => d.steps).filter((x): x is number => x !== undefined);
  return xs.length ? mean(xs) : undefined;
};
const steps7 = stepsOf(all.slice(-7));
const steps30 = stepsOf(view);
const stepsSpec: ChartSpec = {
  type: 'bar',
  categories: cats,
  series: [{ name: 'Pasos', data: view.map((d) => v(d.steps)), color: 1 }],
  format: 'int',
  reference: { value: target, label: `Meta ${int(target)}` },
};
// Diferencia sobre los valores ya redondeados, para que cuadre con lo que se muestra
const ageDiff = fitness?.fitnessAge !== undefined && age !== undefined ? age - fitness.fitnessAge : undefined;
const leverFmt = (x: number) => (Number.isInteger(x) ? int(x) : km(x));

// ---------- Peso (media de 7 días) ----------
const wTrend = weightTrend(weights);
const wChange = weightChange(wTrend);
const weightSpec: ChartSpec = {
  type: 'line',
  categories: wTrend.map((w) => shortDate(w.date)),
  series: [
    { name: 'Media 7 días', data: wTrend.map((w) => Math.round(w.avg7 * 10) / 10), color: 1 },
    { name: 'Cada pesaje', data: wTrend.map((w) => Math.round(w.kg * 10) / 10), color: 1, faint: true },
  ],
  format: 'dec1',
  height: 220,
};

const heightCm = Astro.locals.settings.heightCm;
const lastWeight = wTrend.at(-1);
// IMC con tu altura del perfil; sin ella, el que usa Garmin para la edad física
const garminBmi = fitness?.levers.find((l) => l.key === 'bmi')?.value;
const bmiNow = lastWeight && heightCm ? bmi(lastWeight.avg7, heightCm) : garminBmi;
const bmiSource = lastWeight && heightCm ? '' : ', de Garmin';

// ---------- Regularidad del sueño (30 días) ----------
const regularity = sleepRegularity(all, today);
const regSpec: ChartSpec | undefined = regularity && {
  type: 'rangeBar',
  categories: regularity.nights.map((n) => shortDate(n.date)),
  series: [{ name: 'En la cama', data: regularity.nights.map((n) => [n.bed, n.wake]), color: 1 }],
  format: 'clock',
  height: 240,
};
const clock = (minFromNoon: number) => fmt('clock', minFromNoon);
const mins = (m: number) => `${Math.round(m)} min`;

// ---------- FC en reposo y VFC a 12 meses ----------
const rhr52 = heart ? weeklyMean(heart, (d) => d.restingHr, 52, today) : [];
const hrv52 = heart ? weeklyMean(heart, (d) => d.hrvLastNight, 52, today, true) : [];
const rhrChange = quarterChange(rhr52);
const hrvChange = quarterChange(hrv52);
const has52 = (ws: typeof rhr52) => ws.filter((w) => w.value !== undefined).length >= 8;
const weekSpec = (name: string, ws: typeof rhr52, format: ChartSpec['format'], color: 1 | 2): ChartSpec => ({
  type: 'line',
  categories: ws.map((w) => shortDate(w.week)),
  series: [{ name, data: ws.map((w) => (w.value === undefined ? null : Math.round(w.value * 10) / 10)), color }],
  format,
  height: 220,
});
function changeText(c: typeof rhrChange, unit: string): string {
  if (!c) return '';
  if (Math.abs(c.diff) < 0.05) return ` · sin cambio (±0 ${unit}) del primer al último trimestre`;
  return ` · ${c.diff > 0 ? '+' : '−'}${km(Math.abs(c.diff))} ${unit} del primer al último trimestre`;
}

// ---------- Contexto ----------
const bbSpec: ChartSpec = {
  type: 'rangeBar',
  categories: cats,
  series: [
    {
      name: 'Body Battery (mín–máx)',
      data: view.map((d) =>
        d.bodyBatteryMin !== undefined && d.bodyBatteryMax !== undefined ? [d.bodyBatteryMin, d.bodyBatteryMax] : null,
      ),
      color: 1,
    },
  ],
  format: 'int',
  yMin: 0,
  yMax: 100,
  height: 220,
};
const stressSpec: ChartSpec = {
  type: 'line',
  categories: cats,
  series: [
    { name: 'Durante el sueño', data: view.map((d) => v(d.sleepStress)), color: 1 },
    { name: 'Media del día', data: view.map((d) => v(d.stressAvg)), color: 2, faint: true },
  ],
  format: 'int',
  yMin: 0,
  height: 220,
};
const phasesSpec: ChartSpec = {
  type: 'bar',
  stacked: true,
  categories: cats,
  series: [
    { name: 'Profundo', data: view.map((d) => v(d.deepS)), color: 1 },
    { name: 'Ligero', data: view.map((d) => v(d.lightS)), color: 2 },
    { name: 'REM', data: view.map((d) => v(d.remS)), color: 3 },
    { name: 'Despierto', data: view.map((d) => v(d.awakeS)), color: 4 },
  ],
  format: 'hm',
  height: 220,
};

const sectionTitle = 'type-section';
const TONE = {
  ok: 'border-l-green-500',
  warn: 'border-l-amber-400',
  alert: 'border-l-red-500',
  muted: 'border-l-muted-foreground',
} as const;
---

<Base title="Salud">
  <h1 class="type-display">Salud</h1>
  <p class:list={['text-sm text-muted-foreground', client && !error ? 'mb-2' : 'mb-6']}>{dayLabel(today)}</p>
  {client && !error && (
    <PageIndex
      class="mb-4"
      items={[
        { href: '#hoy', label: 'Hoy' },
        { href: '#recuperacion', label: 'Recuperación' },
        { href: '#vida-sana', label: 'Vida sana' },
        { href: '#contexto', label: 'Contexto' },
      ]}
    />
  )}

  {!client ? (
    <ConnectPrompt />
  ) : error ? (
    <ErrorState error={error} />
  ) : (
    <div class="space-y-8">
      {/* ---------- Hoy ---------- */}
      <section class:list={[card, 'border-l-4 p-5', TONE[state.tone]]} aria-labelledby="hoy">
        <div class="grid gap-6 lg:grid-cols-[1fr_1.4fr]">
          <div>
            <h2 id="hoy" class={sectionTitle}>
              Hoy
            </h2>
            <p class="type-title mt-2">{state.title}</p>
            <p class="mt-1 text-sm text-muted-foreground">{state.text}</p>
            <p class="mt-3 text-xs text-muted-foreground">
              Cada señal se compara con tu propio rango de los últimos 1–2 meses, no con valores de referencia.
            </p>
          </div>
          <ul class="divide-y divide-border lg:col-start-2 lg:row-span-2 lg:row-start-1">
            {status.signals.map((s) => (
              <li class="flex items-start gap-3 py-2.5 first:pt-0 last:pb-0">
                <span
                  class:list={['mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full', DOT[s.state]]}
                  title={DOT_LABEL[s.state]}
                />
                {s.state !== 'warn' && <span class="sr-only">{DOT_LABEL[s.state]}:</span>}
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline justify-between gap-3">
                    <p class="text-sm font-medium">
                      {s.label}
                      {s.state === 'warn' && <span class="chip chip-warn ml-2 align-middle">Fuera de rango</span>}
                    </p>
                    <p class="text-sm font-semibold whitespace-nowrap tabular-nums">{s.value}</p>
                  </div>
                  <p
                    class:list={[
                      'text-xs',
                      s.state === 'warn' ? 'text-amber-800 dark:text-amber-300' : 'text-muted-foreground',
                    ]}
                  >
                    {s.detail}
                  </p>
                </div>
              </li>
            ))}
          </ul>
          {ready && (
            <div class="p-3 bg-muted/50 lg:col-start-1">
              <div class="flex items-baseline justify-between gap-3">
                <h3 id="disposicion" class="type-card">
                  Disposición{readyDate !== today ? ' (datos de ayer)' : ''}
                </h3>
                <p class="tabular-nums">
                  <span class="type-kpi">{ready.score}</span>
                  <span class="text-sm text-muted-foreground">/100</span>
                </p>
              </div>
              <p class="text-sm font-medium">{readinessLabel(ready.score)}</p>
              <Collapsible summary="Desglose y cómo se calcula" class="mt-2" open={ready.parts.some((x) => x.z < -1)}>
                <ul class="space-y-0.5 text-xs">
                  {ready.parts.map((part) => (
                    <li class="flex justify-between gap-3 tabular-nums">
                      <span>
                        {part.label} · {PART_VALUE[part.key](part.value)}
                      </span>
                      <span
                        class:list={[
                          part.z < -1 ? 'font-medium text-amber-800 dark:text-amber-300' : 'text-muted-foreground',
                        ]}
                      >
                        {part.z >= 0 ? '↑' : '↓'} {zText(part.z)}
                      </span>
                    </li>
                  ))}
                </ul>
                <p class="mt-2 text-xs text-muted-foreground">
                  50 es tu día normal. Pesos: VFC {READINESS_WEIGHTS.hrv * 100} %, FC en reposo{' '}
                  {READINESS_WEIGHTS.rhr * 100} %, sueño {READINESS_WEIGHTS.sleep * 100} % (frente a tu objetivo) y
                  forma {READINESS_WEIGHTS.tsb * 100} %
                  {ready.missing.length ? '; los que faltan se reparten entre el resto' : ''}. Orientativa: no es un
                  modelo validado.
                </p>
              </Collapsible>
            </div>
          )}
        </div>
      </section>

      {/* ---------- Recuperación ---------- */}
      <section class="space-y-4" aria-labelledby="recuperacion">
        <h2 id="recuperacion" class={sectionTitle}>
          Recuperación · últimos {VIEW_DAYS} días
        </h2>
        <div class="grid gap-6 lg:grid-cols-2">
          <ChartCard
            title="Variabilidad de la FC (VFC)"
            subtitle="Media de 7 días frente a tu rango normal (60 días). Por debajo suele indicar fatiga o enfermedad."
            spec={hrvSpec}
            table={{
              headers: ['Día', 'Noche', 'Media 7 d', 'Rango'],
              rows: hrv.map((p) => [
                shortDate(p.date),
                int(p.daily),
                int(p.avg7),
                p.low !== undefined ? `${int(p.low)}–${int(p.high)}` : '—',
              ]),
            }}
          />
          <ChartCard
            title="FC en reposo"
            subtitle={`Frente a tu habitual (mediana de ${RHR_WINDOW} días). +${RHR_ALERT_BPM} ppm o más es una señal de alerta.`}
            spec={rhrSpec}
            table={{
              headers: ['Día', 'ppm', 'Habitual', 'Diferencia'],
              rows: rhr.map((p) => [
                shortDate(p.date),
                int(p.value),
                int(p.base),
                p.delta !== undefined ? `${p.delta > 0 ? '+' : ''}${Math.round(p.delta)}` : '—',
              ]),
            }}
          />
        </div>
        <section
          id="alertas"
          class:list={[card, 'grid scroll-mt-4 gap-6 p-4 lg:grid-cols-[14rem_1fr]']}
          aria-labelledby="alertas-titulo"
        >
          <dl class="grid grid-cols-3 gap-4 lg:grid-cols-1">
            <div>
              <dt class="type-label">Deuda de sueño (7 noches)</dt>
              <dd class="type-value">{debt.nights ? hoursMinutes(debt.debtS) : '—'}</dd>
            </div>
            <div>
              <dt class="type-label">Media por noche</dt>
              <dd class="type-value">{hoursMinutes(avgSleep)}</dd>
            </div>
            <div>
              <dt class="type-label">Noches de 7 h o más</dt>
              <dd class="type-value">{pct7h !== undefined ? `${Math.round(pct7h)} %` : '—'}</dd>
            </div>
          </dl>
          <div class="min-w-0">
            <h3 id="alertas-titulo" class="type-card">
              Horas de sueño y alertas de fatiga
            </h3>
            <p class="max-w-prose text-sm text-muted-foreground">
              La línea es la necesidad que calcula Garmin; en color, las noches en que saltó la alerta de fatiga.
            </p>
            <p class="mt-2 text-sm font-medium">
              {alerts.length === 0
                ? `Ninguna alerta en los últimos ${VIEW_DAYS} días.`
                : `${alerts.length} ${alerts.length === 1 ? 'noche' : 'noches'} con alerta en los últimos ${VIEW_DAYS} días${
                    alerts.some((x) => x.level === 'high')
                      ? ` (${alerts.filter((x) => x.level === 'high').length} de nivel alto)`
                      : ''
                  }.`}
            </p>
            <div
              class="mt-2 w-full min-w-0"
              data-chart={JSON.stringify(sleepSpec)}
              role="img"
              aria-label="Horas de sueño por noche, con las noches de alerta de fatiga destacadas"
              style="min-height:260px"
            />
            <details class="mt-2 text-sm">
              <summary class="cursor-pointer select-none text-muted-foreground hover:text-foreground">
                Ver datos
              </summary>
              <section class="mt-2 max-h-72 overflow-auto" tabindex="0" aria-labelledby="datos-sueno">
                <table class="w-full text-left text-xs">
                  <caption id="datos-sueno" class="sr-only">
                    Horas de sueño y alertas de fatiga de los últimos {VIEW_DAYS} días
                  </caption>
                  <thead class="sticky top-0 text-muted-foreground bg-muted/50">
                    <tr>
                      {sleepTable.headers.map((h) => (
                        <th scope="col" class="px-2 py-1 font-medium">
                          {h}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody class="tabular-nums">
                    {sleepTable.rows.map((r) => (
                      <tr class="border-b border-border">
                        {r.map((c) => (
                          <td class="px-2 py-1">{c}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </section>
            </details>
            <Collapsible summary="Cómo se calcula" class="mt-1">
              <p class="max-w-prose text-xs text-muted-foreground">
                Alerta: anoche menos de {hm1(alertT.lastNightH)} h y al menos {alertT.minShortNights} noches de menos de{' '}
                {hm1(alertT.shortNightH)} h en 7 días; nivel alto si además baja la VFC o sube la FC en reposo. Los
                umbrales se cambian en tu perfil. La duración pesa más que las fases, que en reloj de muñeca son poco
                fiables. Orientativa.
              </p>
            </Collapsible>
          </div>
        </section>

        {regularity && regSpec && (
          <section class:list={[card, 'grid gap-6 p-4 lg:grid-cols-[14rem_1fr]']} aria-labelledby="regularidad">
            <div>
              <h3 id="regularidad" class="type-card">
                Regularidad del sueño
              </h3>
              <p class="type-title mt-1">{regularity.label}</p>
              <dl class="mt-3 grid grid-cols-2 gap-3 text-sm lg:grid-cols-1">
                <div>
                  <dt class="type-label">Te acuestas</dt>
                  <dd class="type-value">
                    {clock(regularity.meanBed)} ± {mins(regularity.sdBed)}
                  </dd>
                </div>
                <div>
                  <dt class="type-label">Te levantas</dt>
                  <dd class="type-value">
                    {clock(regularity.meanWake)} ± {mins(regularity.sdWake)}
                  </dd>
                </div>
                {regularity.socialJetlag !== undefined && (
                  <div>
                    <dt class="type-label">Jet lag social</dt>
                    <dd
                      class:list={['type-value', regularity.socialJetlag > 60 && 'text-amber-800 dark:text-amber-300']}
                    >
                      {hoursMinutes(regularity.socialJetlag * 60)}
                    </dd>
                  </div>
                )}
              </dl>
              <p class="mt-3 text-xs text-muted-foreground">
                {regularity.nights.length} noches. ± es la variación típica de un día a otro: menos de 30 min es
                regular. Jet lag social: cuánto se desplaza tu sueño el fin de semana (más de 1 h se asocia a peor salud
                metabólica). Orientativo.
              </p>
            </div>
            <div class="min-w-0">
              <p class="text-sm text-muted-foreground">Hora de acostarte y de levantarte</p>
              <div
                class="mt-2 w-full min-w-0"
                data-chart={JSON.stringify(regSpec)}
                role="img"
                aria-label={`Horario de sueño de las últimas ${regularity.nights.length} noches`}
                style="min-height:240px"
              />
              <DataTable title="Horario de sueño" spec={regSpec} categoryLabel="Noche" />
            </div>
          </section>
        )}
      </section>

      {/* ---------- Vida sana ---------- */}
      <section class="space-y-4" aria-labelledby="vida-sana">
        <h2 id="vida-sana" class={sectionTitle}>
          Vida sana · tendencia a largo plazo
        </h2>
        <div class:list={['grid gap-6', fitness?.fitnessAge !== undefined && lastVo2 && 'lg:grid-cols-2']}>
          {fitness?.fitnessAge !== undefined && (
            <section class:list={[card, 'flex flex-col p-5']}>
              <h3 class="type-card">Edad física</h3>
              <p class="mt-2 flex items-baseline gap-2">
                <span class="type-kpi">{km(fitness.fitnessAge)}</span>
                <span class="text-sm text-muted-foreground">años</span>
              </p>
              {ageDiff !== undefined && (
                <p
                  class:list={[
                    'text-sm font-medium',
                    ageDiff >= 0 ? 'text-green-700 dark:text-green-400' : 'text-red-700 dark:text-red-400',
                  ]}
                >
                  {ageDiff >= 0 ? `${km(ageDiff)} años menos` : `${km(-ageDiff)} años más`} que tu edad ({age})
                </p>
              )}
              {fitness.achievable !== undefined && fitness.achievable < fitness.fitnessAge && (
                <p class="mt-1 text-sm text-muted-foreground">
                  Podrías llegar a {km(fitness.achievable)} años con estas palancas:
                </p>
              )}
              {fitness.levers.length > 0 && (
                <ul class="mt-3 divide-y text-sm divide-border">
                  {fitness.levers.map((l) => (
                    <li class="flex items-baseline justify-between gap-3 py-2">
                      <span>
                        {l.label}
                        {l.stale && <span class="ml-1 text-xs text-muted-foreground">(dato antiguo)</span>}
                      </span>
                      <span class="text-right tabular-nums">
                        <span class="font-semibold">{l.value !== undefined ? leverFmt(l.value) : '—'}</span>
                        {l.target !== undefined && <span class="text-muted-foreground"> → {leverFmt(l.target)}</span>}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
              {/* Al pie, alineada con la nota de VO2máx: la tarjeta se estira a la altura de su vecina */}
              <p class="mt-auto pt-3 text-xs text-muted-foreground">
                Cálculo de Garmin a partir de VO2máx, actividad vigorosa, FC en reposo e IMC.
              </p>
            </section>
          )}

          {lastVo2 && (
            <section class:list={[card, 'min-w-0 p-5']}>
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="type-card">VO2máx</h3>
                <span class="text-xs text-muted-foreground">a {shortDate(lastVo2.date)}</span>
              </div>
              <p class="mt-2 flex items-baseline gap-2">
                <span class="type-kpi">{km(lastVo2.value)}</span>
                <span class="text-sm text-muted-foreground">ml/kg/min</span>
              </p>
              {vo2Change !== undefined && (
                <p class="text-sm text-muted-foreground">
                  {Math.abs(vo2Change) < lastVo2.value * 0.05
                    ? 'Estable en 90 días (los cambios menores del 5 % están dentro del margen del reloj).'
                    : `${vo2Change > 0 ? '+' : '−'}${km(Math.abs(vo2Change))} en 90 días.`}
                </p>
              )}
              {vo2Pct ? (
                <div class="mt-4">
                  <p class="text-sm">
                    <span class="font-semibold">
                      {vo2Pct.bound === 'above'
                        ? 'Por encima del percentil 95'
                        : vo2Pct.bound === 'below'
                          ? 'Por debajo del percentil 5'
                          : `Percentil ${vo2Pct.percentile}`}
                    </span>
                    <span class="text-muted-foreground">
                      {' '}
                      · {sex === 'male' ? 'hombres' : 'mujeres'} de {vo2Pct.group} años
                    </span>
                  </p>
                  <div class="relative mt-6 mb-5 h-2 bg-linear-to-r from-muted to-(--viz-1)" aria-hidden="true">
                    {vo2Pct.marks
                      .filter((m) => [25, 50, 75, 90].includes(m.p))
                      .map((m) => (
                        <span
                          class="absolute top-full mt-1 -translate-x-1/2 text-[10px] tabular-nums text-muted-foreground"
                          style={`left:${scalePos(m.value)}%`}
                        >
                          P{m.p}
                        </span>
                      ))}
                    <span
                      class="absolute top-1/2 h-4 w-4 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-card bg-foreground shadow-sm"
                      style={`left:${scalePos(lastVo2.value)}%`}
                    />
                  </div>
                  <p class="text-xs text-muted-foreground">
                    Referencia FRIEND (pruebas de esfuerzo en cinta, 2015). Orientativo: el VO2máx del reloj tiene un
                    margen de ±5 %.
                  </p>
                </div>
              ) : (
                <p class="mt-3 text-xs text-muted-foreground">
                  {!sex
                    ? 'Indica tu sexo en el menú de perfil para ver en qué percentil estás para tu edad.'
                    : 'Falta tu edad (llega con la Edad física de Garmin) para calcular el percentil.'}
                </p>
              )}
              {vo2.length > 1 && (
                  <div
                    class="mt-2 w-full min-w-0"
                    data-chart={JSON.stringify(vo2Spec)}
                    role="img"
                    aria-label="Evolución del VO2máx"
                    style="min-height:220px"
                  />
                  <DataTable title="VO2máx" spec={vo2Spec} categoryLabel="Fecha" />
              )}
              <p class="mt-2 text-xs text-muted-foreground">
                Es el marcador con más evidencia: cada +3,5 ml/kg/min se asocia a un ~13 % menos de mortalidad.
              </p>
            </section>
          )}
        </div>

        <div class="grid gap-6 lg:grid-cols-2">
          <ChartCard
            title="Minutos de intensidad por semana"
            subtitle={`Moderados + vigorosos ×2 frente a los 150 de la OMS · ${weeksMet} de ${fullWeeks.length} semanas cumplidas. Con las zonas de FC de tus actividades (Z2–Z3 moderados, Z4–Z5 vigorosos) cuando Garmin no los da; orientativo.`}
            spec={intensitySpec}
            table={{
              headers: ['Semana', 'Moderados', 'Vigorosos ×2', 'Total'],
              rows: intensity.map((w) => [shortDate(w.week), int(w.moderate), int(w.vigorousX2), int(w.total)]),
            }}
          />
          <ChartCard
            title="Pasos"
            subtitle={`Media 7 días ${int(steps7)} · 30 días ${int(steps30)} · meta por edad ${int(target)} (el beneficio se estabiliza hacia ahí)`}
            spec={stepsSpec}
            table={{ headers: ['Día', 'Pasos'], rows: view.map((d) => [shortDate(d.date), int(d.steps)]) }}
          />
          {wTrend.length >= 2 && (
            <ChartCard
              title="Peso (kg)"
              subtitle={`Media de 7 días, que amortigua la hidratación y la hora del pesaje${wChange !== undefined ? ` · ${wChange >= 0 ? '+' : '−'}${km(Math.abs(wChange))} kg en ${FETCH_DAYS} días` : ''}${bmiNow !== undefined ? ` · IMC ${km(bmiNow)} (${bmiCategory(bmiNow).toLowerCase()}${bmiSource}; orientativo, sobrestima la grasa si tienes mucho músculo)` : ' · Indica tu altura en el perfil para ver el IMC'}`}
              spec={weightSpec}
              table={{
                headers: ['Día', 'Pesaje', 'Media 7 d'],
                rows: wTrend.map((w) => [shortDate(w.date), km(w.kg), km(w.avg7)]),
              }}
            />
          )}
          {has52(rhr52) && (
            <ChartCard
              title="FC en reposo · 12 meses"
              subtitle={`Media semanal. Bajar con los meses suele indicar mejor forma aeróbica${changeText(rhrChange, 'ppm')}.`}
              spec={weekSpec('FC en reposo', rhr52, 'bpm', 2)}
              table={{
                headers: ['Semana', 'Media', 'Días'],
                rows: rhr52.map((w) => [shortDate(w.week), int(w.value), int(w.days)]),
              }}
            />
          )}
          {has52(hrv52) && (
            <ChartCard
              title="VFC · 12 meses"
              subtitle={`Media semanal (geométrica) de la VFC nocturna. Lo útil es tu tendencia, no el valor absoluto${changeText(hrvChange, 'ms')}.`}
              spec={weekSpec('VFC', hrv52, 'ms', 1)}
              table={{
                headers: ['Semana', 'Media', 'Noches'],
                rows: hrv52.map((w) => [shortDate(w.week), int(w.value), int(w.days)]),
              }}
            />
          )}
        </div>
      </section>

      {/* ---------- Contexto ---------- */}
      <section class="space-y-4" aria-labelledby="contexto">
        <div>
          <h2 id="contexto" class={sectionTitle}>
            Contexto
          </h2>
          <p class="mt-1 text-sm text-muted-foreground">
            Métricas de Garmin con evidencia limitada: útiles para contexto, no para decidir.
          </p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          <ChartCard title="Body Battery" subtitle="Rango diario mínimo–máximo (algoritmo propietario)" spec={bbSpec} />
          <ChartCard
            title="Activación fisiológica"
            subtitle="El «estrés» de Garmin mide activación, no estrés psicológico. Lo más útil es el valor durante el sueño."
            spec={stressSpec}
          />
          <ChartCard
            title="Fases del sueño"
            subtitle="Orientativas: el reloj de muñeca las estima con poca precisión"
            spec={phasesSpec}
          />
        </div>
      </section>

      <p class="text-xs text-muted-foreground">
        Estimaciones de bienestar basadas en estudios observacionales y en los sensores del reloj. No es un diagnóstico
        médico.
      </p>
    </div>
  )}
</Base>

<script>
  import '../scripts/charts';
</script>
