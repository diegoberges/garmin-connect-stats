---
import Base from '../layouts/Base.astro';
import { clearSettings, maskKey, secretConfigured, writeSettings } from '../lib/settings';
import { forgetToken, getAccessToken, GarminAuthError } from '../lib/garmin/auth';
import { runDiagnostics } from '../lib/garmin/diagnostics';

let error: string | undefined;
let success: string | undefined;
const settings = { ...Astro.locals.settings };
const secure = Astro.url.protocol === 'https:';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');

  if (action === 'save-garmin') {
    const apiKey = String(form.get('garminApiKey') ?? '').trim();
    if (!apiKey) {
      error = 'Pega tu API key antes de guardar.';
    } else {
      try {
        await getAccessToken(apiKey, { force: true }); // valida contra Garmin antes de guardar
        settings.garminApiKey = apiKey;
        writeSettings(Astro.cookies, settings, secure);
        success = 'Cuenta de Garmin conectada correctamente.';
      } catch (err) {
        error =
          err instanceof GarminAuthError || !secretConfigured()
            ? (err as Error).message
            : 'Error inesperado al validar la key.';
      }
    }
  } else if (action === 'remove-garmin') {
    if (settings.garminApiKey) forgetToken(settings.garminApiKey);
    delete settings.garminApiKey;
    if (Object.keys(settings).length) writeSettings(Astro.cookies, settings, secure);
    else clearSettings(Astro.cookies);
    success = 'Key de Garmin eliminada.';
  }
  Astro.locals.settings = settings;
}

const garminKey = settings.garminApiKey;
const fresh = Astro.url.searchParams.has('probar');
const checks = garminKey ? await runDiagnostics(garminKey, { fresh }) : [];
const allOk = checks.length > 0 && checks.every((c) => c.ok);
---

<Base title="Ajustes">
  <h1 class="mb-6 text-2xl font-bold">Ajustes</h1>

  {
    !secretConfigured() && (
      <div class="mb-4 rounded-lg bg-yellow-50 p-4 text-sm text-yellow-800 dark:bg-gray-800 dark:text-yellow-300" role="alert">
        Falta configurar <code>APP_SECRET</code> en el servidor. Sin él no se puede guardar la key de forma segura.
      </div>
    )
  }

  {
    error && (
      <div class="mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 dark:bg-gray-800 dark:text-red-400" role="alert">
        {error}
      </div>
    )
  }
  {
    success && (
      <div class="mb-4 rounded-lg bg-green-50 p-4 text-sm text-green-800 dark:bg-gray-800 dark:text-green-400" role="status">
        {success}
      </div>
    )
  }

  <section class="rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-800">
    <div class="flex flex-wrap items-start justify-between gap-2">
      <div>
        <h2 class="text-lg font-semibold">Garmin Connect</h2>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
          Crea tu Personal API Key en
          <a class="text-blue-600 underline dark:text-blue-400" href="https://connect.garmin.com/app/settings/personalApiToken" target="_blank" rel="noopener">Garmin Connect → Personal API Key</a>
          y pégala aquí. Se guarda cifrada en una cookie que solo lee el servidor.
        </p>
      </div>
      {
        garminKey ? (
          <span class="rounded-sm bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800 dark:bg-green-900 dark:text-green-300">
            Conectado · {maskKey(garminKey)}
          </span>
        ) : (
          <span class="rounded-sm bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800 dark:bg-gray-700 dark:text-gray-300">
            Sin conectar
          </span>
        )
      }
    </div>

    <form method="post" class="mt-4 flex flex-col gap-3 sm:flex-row">
      <input type="hidden" name="action" value="save-garmin" />
      <label for="garminApiKey" class="sr-only">Personal API Key</label>
      <input
        id="garminApiKey"
        name="garminApiKey"
        type="password"
        autocomplete="off"
        required
        placeholder={garminKey ? 'Pega una key nueva para reemplazarla' : 'Personal API Key'}
        class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400"
      />
      <button
        type="submit"
        class="rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium whitespace-nowrap text-white hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
      >
        Validar y guardar
      </button>
    </form>

    {
      garminKey && (
        <form method="post" class="mt-3">
          <input type="hidden" name="action" value="remove-garmin" />
          <button type="submit" class="text-sm text-red-600 hover:underline dark:text-red-400">
            Eliminar key
          </button>
        </form>
      )
    }
  </section>

  {
    garminKey && (
      <section class="mt-6 rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-800">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h2 class="text-lg font-semibold">Estado de la conexión</h2>
            <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
              {allOk
                ? 'Todo responde correctamente.'
                : `${checks.filter((c) => !c.ok).length} de ${checks.length} comprobaciones han fallado.`}
            </p>
          </div>
          <a
            href="/ajustes?probar"
            class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700"
          >
            Probar de nuevo
          </a>
        </div>

        <ul class="mt-4 divide-y divide-gray-200 dark:divide-gray-700">
          {checks.map((c) => (
            <li class="flex items-start gap-3 py-3">
              <span
                class:list={[
                  'mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white',
                  c.ok ? 'bg-green-500' : 'bg-red-500',
                ]}
                aria-label={c.ok ? 'Correcto' : 'Error'}
              >
                {c.ok ? '✓' : '!'}
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                  <p class="text-sm font-medium">{c.name}</p>
                  <span class="text-xs text-gray-500 tabular-nums dark:text-gray-400">{c.ms} ms</span>
                </div>
                <p
                  class:list={[
                    'mt-0.5 text-sm break-words',
                    c.ok ? 'text-gray-600 dark:text-gray-300' : 'text-red-700 dark:text-red-400',
                  ]}
                >
                  {c.ok ? c.detail : c.error}
                </p>
                <p class="mt-0.5 font-mono text-xs break-all text-gray-400 dark:text-gray-500">{c.endpoint}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
