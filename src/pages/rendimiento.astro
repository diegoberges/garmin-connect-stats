---
/**
 * Rendimiento: ¿mi entrenamiento me está haciendo mejor? Carga y su balance (forma física / fatiga / forma),
 * cómo reparto la intensidad, volumen de carrera, mejores marcas y VO2máx.
 * Criterios y fuentes: reports/Métricas de salud y rendimiento.md (fase 2).
 */
import Base from '../layouts/Base.astro';
import ConnectPrompt from '../components/ConnectPrompt.astro';
import PageIndex from '../components/PageIndex.astro';
import ErrorState from '../components/ErrorState.astro';
import ChartCard from '../components/ChartCard.astro';
import Collapsible from '../components/Collapsible.astro';
import DataTable from '../components/DataTable.astro';
import RangeSelector from '../components/RangeSelector.astro';
import {
  clientFor,
  getActivities,
  getActivityTrack,
  getAllActivities,
  getHrReference,
  getVo2Max,
  type Activity,
  type ActivityTrack,
  type Vo2Point,
} from '../lib/garmin';
import { predictionTrend, vo2At, vo2Trend } from '../lib/progression';
import { eddington, streaks } from '../lib/consistency';
import { criticalSpeed, efTrend, paceAtHr, predictTime, vdot } from '../lib/efficiency';
import { addDays, isoDate, weekStart } from '../lib/dates';
import { pctChange, runsBetween, totals, weeklyTotals } from '../lib/stats';
import {
  ACWR_ZONES,
  FATIGUE_DAYS,
  FITNESS_DAYS,
  FORM_ZONES,
  MONOTONY_HIGH,
  RAMP_ALERT,
  RAMP_WATCH,
  WARMUP_DAYS,
  WEEKLY_SPIKE_PCT,
  acwr,
  acwrZone,
  bestEfforts,
  dailyLoad,
  estimateHrParams,
  formZone,
  monotonyStrain,
  pmc,
  rampRate,
  todayModel,
  weeklyChange,
  weeklyLoad,
  type FormZone,
  type HrParams,
} from '../lib/load';
import { LOAD_SCOPES, SPORT_GROUPS, inLoadScope, parseLoadScope, periodVolumes } from '../lib/volume';
import { BEST_EFFORT_DISTANCES } from '../lib/garmin/types';
import { activityLabel, duration, hoursMinutes, int, km, pace, shortDate } from '../lib/format';
import type { ChartSpec, ColorSlot } from '../lib/chart-spec';
import { card } from '../lib/ui';
import {
  PROGRESS_THRESHOLDS,
  type ProgressDir,
  pctChange as relChange,
  progressVerdict,
  recordsThisYear,
  trendDir,
} from '../lib/progress';

const WEEK_OPTIONS = [
  { value: 4, label: '4 sem' },
  { value: 12, label: '12 sem' },
  { value: 26, label: '6 meses' },
  { value: 52, label: '1 año' },
];
const requested = Number(Astro.url.searchParams.get('semanas'));
const weeks = WEEK_OPTIONS.some((o) => o.value === requested) ? requested : 12;
const scope = parseLoadScope(Astro.url.searchParams.get('carga'));
const scopeLabel = LOAD_SCOPES.find((s) => s.scope === scope)!.label;

const client = clientFor(Astro.locals);
const today = isoDate();
const thisWeek = weekStart(today);
const lastWeek = addDays(thisWeek, -7);
const from = addDays(thisWeek, -7 * (weeks - 1));
// Historial extra para que la media de 42 días arranque estabilizada y para comparar con 4 semanas previas
const loadFrom = addDays(from, -WARMUP_DAYS);

let all: Activity[] = [];
let history: Activity[] | undefined;
/** Historial completo de todas las actividades (para rachas); `history` son solo las carreras. */
let everything: Activity[] | undefined;
let garminVo2: Vo2Point[] = [];
let hrRef: { restingHr: number; maxHr: number } | undefined;
let longTracks: { run: Activity; track?: ActivityTrack }[] = [];
let error: unknown;
if (client) {
  try {
    [all, everything, hrRef, garminVo2] = await Promise.all([
      getActivities(client, loadFrom, today),
      // Si el histórico falla, la tabla se muestra solo con el periodo
      getAllActivities(client, today).catch((err) => {
        console.error('[garmin] histórico de actividades', err);
        return undefined;
      }),
      getHrReference(client).catch(() => undefined),
      getVo2Max(client, from, today).catch(() => []),
    ]);
    history = everything?.filter((a) => /run/.test(a.typeKey));
  } catch (err) {
    error = err;
  }
}

if (client && !error) {
  const longRuns = all
    .filter((a) => /run/.test(a.typeKey) && a.movingS >= 60 * 60 && a.avgHr)
    .sort((a, b) => b.startLocal.localeCompare(a.startLocal))
    .slice(0, 8);
  longTracks = await Promise.all(
    longRuns.map(async (run) => ({ run, track: await getActivityTrack(client, run.id).catch(() => undefined) })),
  );
}

// ---------- Carga (TRIMP de Banister, la única métrica de carga) ----------
// Todo el historial si está; si no, lo del periodo (entonces las cifras de hoy pueden variar algo con él)
const allHistory = everything ?? all;
const hr: HrParams = { ...(hrRef ?? estimateHrParams(allHistory)), sex: Astro.locals.settings.sex };
const scoped = all.filter(inLoadScope(scope));
// Gráficas de la sección Carga: el periodo y el filtro de carga elegidos
const model = pmc(dailyLoad(scoped, loadFrom, today, hr));
const visible = model.filter((p) => p.date >= from);
// Cifras de hoy (estado de forma, sus indicadores y "¿Estás mejorando?"): todas las actividades y ventana fija
const todayPoints = todayModel(allHistory, today, hr);
const nowP = todayPoints.at(-1);
const weekAgo = todayPoints.at(-8);
const fitnessChange = nowP && weekAgo ? nowP.fitness - weekAgo.fitness : undefined;
const hasForm = visible.some((p) => p.formPct !== undefined);
// Sin gráfica de forma, la de forma física/fatiga muestra su propio eje x
const zone = nowP?.formPct !== undefined ? formZone(nowP.formPct) : undefined;

const allWeeks = weeklyLoad(scoped, weeks + 5, today, hr);
const shownWeeks = allWeeks.slice(-weeks);
// Subida de la carga semanal (aviso de hoy): todas las actividades, independiente del periodo y del filtro
const change = weeklyChange(weeklyLoad(allHistory, 6, today, hr));
const spike = change?.pct !== undefined && change.pct >= WEEKLY_SPIKE_PCT;
// Los días de fuerza se cuentan siempre, aunque el filtro de carga los deje fuera
const strength4 =
  weeklyLoad(all, 5, today, hr)
    .slice(0, -1)
    .reduce((a, w) => a + w.strengthDays, 0) / 4;
const ratioNow = nowP?.formPct !== undefined ? acwr(nowP) : undefined;
const ratioZone = ratioNow !== undefined ? acwrZone(ratioNow) : undefined;
const ramp = rampRate(todayPoints);
const mono = monotonyStrain(todayPoints);
const acwrPoints = visible.map((p) => (p.formPct !== undefined ? acwr(p) : undefined));
const acwrSpec: ChartSpec = {
  type: 'line',
  categories: visible.map((p) => shortDate(p.date)),
  band: { name: 'Óptimo (0,8–1,3)', data: visible.map(() => [0.8, 1.3]) },
  series: [
    {
      name: 'Ratio agudo:crónico',
      data: acwrPoints.map((x) => (x === undefined ? null : Math.round(x * 100) / 100)),
      color: 2,
    },
  ],
  format: 'dec2',
  reference: { value: 1.5, label: 'Riesgo > 1,5' },
  height: 220,
};
const hasAcwr = acwrPoints.some((x) => x !== undefined);
const dec = (v: number) => String(v).replace('.', ',');
/** "Carga baja: < 0,8 · Óptima: 0,8–1,3 · …" */
const acwrLegend = ACWR_ZONES.map((z, i) => {
  if (i === 0) return `${z.label}: < ${dec(z.max)}`;
  const lo = dec(ACWR_ZONES[i - 1].max);
  return z.max === Infinity ? `${z.label}: > ${lo}` : `${z.label}: ${lo}–${dec(z.max)}`;
}).join(' · ');
/** " (+12 %)" frente al tramo anterior; vacío si antes no había nada. */
function vs(current: number, previous: number): string {
  const pc = pctChange(current, previous);
  if (pc === undefined) return '';
  const sign = pc >= 0 ? '+' : '−';
  return ` (${sign}${Math.abs(Math.round(pc))} %)`;
}
function rampText(r: number): string {
  if (r > RAMP_ALERT) return `Sube demasiado rápido (> ${RAMP_ALERT})`;
  if (r > RAMP_WATCH) return `Vigilar (> ${RAMP_WATCH})`;
  return r < 0 ? 'Bajando' : 'Subida sostenible';
}
/** Indicadores secundarios que piden atención: se muestran fuera del plegable, en texto. */
const loadWarnings = [
  ratioZone && (ratioZone.zone === 'elevated' || ratioZone.zone === 'risk')
    ? `ratio agudo:crónico ${km(ratioNow!, 2)} (${ratioZone.label.toLowerCase()})`
    : undefined,
  ramp !== undefined && ramp > RAMP_WATCH ? `rampa +${km(ramp)} (${rampText(ramp).toLowerCase()})` : undefined,
  mono && mono.monotony > MONOTONY_HIGH ? `monotonía ${km(mono.monotony, 2)} (poca variedad)` : undefined,
  spike && change?.pct !== undefined ? `carga semanal +${Math.round(change.pct)} % (subida brusca)` : undefined,
].filter((x): x is string => x !== undefined);
const volumes = periodVolumes(all, today);
const sumGroups = (m: Map<string, { sessions: number; timeS: number }>) =>
  [...m.values()].reduce((a, v) => ({ sessions: a.sessions + v.sessions, timeS: a.timeS + v.timeS }), {
    sessions: 0,
    timeS: 0,
  });
const weekAll = sumGroups(volumes[0].current);
const weekAllPrev = sumGroups(volumes[0].previous);

const pmcCats = visible.map((p) => shortDate(p.date));
const pmcTable = {
  headers: ['Día', 'Forma física', 'Fatiga', 'Forma'],
  rows: visible.map((p) => [
    shortDate(p.date),
    int(p.fitness),
    int(p.fatigue),
    p.formPct === undefined ? '—' : `${p.formPct > 0 ? '+' : ''}${Math.round(p.formPct)} %`,
  ]),
};
const fitnessSpec: ChartSpec = {
  type: 'line',
  categories: pmcCats,
  series: [
    { name: `Forma física (${FITNESS_DAYS} d)`, data: visible.map((p) => Math.round(p.fitness)), color: 1 },
    { name: `Fatiga (${FATIGUE_DAYS} d)`, data: visible.map((p) => Math.round(p.fatigue)), color: 2 },
  ],
  format: 'int',
  height: 220,
  group: 'pmc',
  hideXLabels: visible.some((p) => p.formPct !== undefined),
};
const formSpec: ChartSpec = {
  type: 'line',
  categories: pmcCats,
  band: { name: 'Zona productiva (−10 a −30 %)', data: visible.map(() => [-30, -10]) },
  series: [
    { name: 'Forma', data: visible.map((p) => (p.formPct === undefined ? null : Math.round(p.formPct))), color: 3 },
  ],
  format: 'pct',
  height: 200,
  group: 'pmc',
};

// Carga semanal por tipo: 3 tipos con más carga + "Otras" (máx. 4 colores)
const typeTotals = new Map<string, number>();
for (const w of shownWeeks)
  for (const [t, l] of Object.entries(w.byType)) typeTotals.set(t, (typeTotals.get(t) ?? 0) + l);
const ranked = [...typeTotals.entries()].sort((a, b) => b[1] - a[1]).map(([t]) => t);
const topTypes = ranked.slice(0, ranked.length > 4 ? 3 : 4);
const hasOthers = ranked.length > topTypes.length;
const weekCats = shownWeeks.map((w) => shortDate(w.week));
const loadSpec: ChartSpec = {
  type: 'bar',
  stacked: true,
  categories: weekCats,
  series: [
    ...topTypes.map((t, i) => ({
      name: activityLabel(t),
      data: shownWeeks.map((w) => Math.round(w.byType[t] ?? 0)),
      color: (i + 1) as ColorSlot,
    })),
    ...(hasOthers
      ? [
          {
            name: 'Otras',
            data: shownWeeks.map((w) =>
              Math.round(
                Object.entries(w.byType)
                  .filter(([t]) => !topTypes.includes(t))
                  .reduce((a, [, l]) => a + l, 0),
              ),
            ),
            color: 4 as ColorSlot,
          },
        ]
      : []),
  ],
  format: 'int',
};

// Distribución de intensidad (modelo de 3 zonas a partir de las 5 de FC: Z1–Z2 baja, Z3 moderada, Z4–Z5 alta)
const pctOf = (w: { low: number; mid: number; high: number }, k: 'low' | 'mid' | 'high') => {
  const t = w.low + w.mid + w.high;
  return t > 0 ? Math.round((w[k] / t) * 100) : null;
};
const intensitySpec: ChartSpec = {
  type: 'bar',
  stacked: true,
  categories: weekCats,
  series: [
    { name: 'Baja (Z1–Z2)', data: shownWeeks.map((w) => pctOf(w, 'low')), color: 1 },
    { name: 'Moderada (Z3)', data: shownWeeks.map((w) => pctOf(w, 'mid')), color: 4 },
    { name: 'Alta (Z4–Z5)', data: shownWeeks.map((w) => pctOf(w, 'high')), color: 2 },
  ],
  format: 'pct',
  yMin: 0,
  yMax: 100,
  reference: { value: 80, label: '80 % suave' },
};
const period = shownWeeks.reduce((a, w) => ({ low: a.low + w.low, mid: a.mid + w.mid, high: a.high + w.high }), {
  low: 0,
  mid: 0,
  high: 0,
});
const periodLow = pctOf(period, 'low');

// ---------- Carrera ----------
const isRun = (a: Activity) => /run/.test(a.typeKey);
const runs = all.filter(isRun);
const runsInPeriod = runs.filter((r) => r.date >= from);
const elapsed = Math.round((Date.parse(today) - Date.parse(thisWeek)) / 86_400_000);
const cur = totals(runsBetween(runs, thisWeek, today));
const prev = totals(runsBetween(runs, lastWeek, addDays(lastWeek, elapsed)));
const t = totals(runsInPeriod);
// Esta semana frente a la pasada a estas alturas: en gris, sin rojo, porque a mitad de semana siempre "falta"
const weekFigures = [
  { label: 'Distancia', value: km(cur.km), unit: 'km', before: `${km(prev.km)} km` },
  { label: 'Sesiones', value: int(cur.runs), unit: '', before: int(prev.runs) },
  { label: 'Tiempo', value: hoursMinutes(cur.movingS), unit: '', before: hoursMinutes(prev.movingS) },
  { label: 'Ritmo medio', value: pace(cur.paceSPerKm), unit: '/km', before: `${pace(prev.paceSPerKm)} /km` },
];
const periodFigures = [
  { label: 'Distancia', value: km(t.km), unit: 'km' },
  { label: 'Sesiones', value: int(t.runs), unit: '' },
  { label: 'Tiempo', value: hoursMinutes(t.movingS), unit: '' },
  { label: 'Ritmo medio', value: pace(t.paceSPerKm), unit: '/km' },
  { label: 'FC media', value: int(t.avgHr), unit: 'ppm' },
  { label: 'Desnivel +', value: int(t.elevationGainM), unit: 'm' },
];
const kmWeekly = weeklyTotals(runsInPeriod, weeks, today);
const kmSpec: ChartSpec = {
  type: 'bar',
  categories: kmWeekly.map((w) => shortDate(w.week)),
  series: [{ name: 'Kilómetros', data: kmWeekly.map((w) => Math.round(w.km * 10) / 10), color: 1 }],
  format: 'km',
  height: 220,
};

// Mejores marcas de los últimos 12 meses (desde hoy, sin depender del selector) frente a todo el historial
const yearAgo = addDays(today, -365);
const lastYearRuns = [...(history ?? []), ...runs].filter((r) => r.date >= yearAgo);
const records = bestEfforts(lastYearRuns);
const allTime = new Map((history ? bestEfforts([...history, ...runs]) : []).map((r) => [r.distance, r]));
const firstRun = history?.at(-1)?.date;
const DIST_LABEL: Record<number, string> = {
  1000: '1 km',
  1609: '1 milla',
  5000: '5 km',
  10000: '10 km',
  21098: 'Media maratón',
  42195: 'Maratón',
};
const periodByDist = new Map(records.map((r) => [r.distance, r]));
// Todas las distancias con marca en el periodo o en el histórico, en orden de distancia
const recordRows = BEST_EFFORT_DISTANCES.filter((d) => periodByDist.has(d) || allTime.has(d)).map((distance) => ({
  distance,
  period: periodByDist.get(distance),
  best: allTime.get(distance),
}));
/** "4 nov 2024": las marcas históricas pueden ser de otros años */
const yearDate = (d: string) => `${shortDate(d)} ${d.slice(0, 4)}`;

// ---------- Eficiencia y progreso (fase 3) ----------
// Factor de eficiencia en carreras comparables (rodajes suaves de asfalto/cinta)
const ef = efTrend(runs);
const efShown = ef.filter((p) => p.date >= from);
const refHr = (() => {
  const hrs = runs
    .filter((r) => ef.some((p) => p.id === r.id))
    .map((r) => r.avgHr!)
    .sort((a, b) => a - b);
  return hrs.length ? Math.round(hrs[Math.floor(hrs.length / 2)] / 5) * 5 : undefined; // mediana redondeada a 5
})();
const efMean = (pts: typeof ef) => (pts.length ? pts.reduce((s, p) => s + p.ef, 0) / pts.length : undefined);
const sixWeeksAgo = addDays(today, -42);
const efRecent = efMean(ef.filter((p) => p.date > sixWeeksAgo));
const efPrevious = efMean(ef.filter((p) => p.date <= sixWeeksAgo && p.date > addDays(sixWeeksAgo, -42)));
// Redondeado a una décima, como se muestra: así "+1,0 %" nunca sale como "estable"
const efChange = efRecent && efPrevious ? Math.round(((efRecent - efPrevious) / efPrevious) * 1000) / 10 : undefined;
// Eficiencia expresada como ritmo a la FC habitual de rodaje (mismo dato que el EF, en min/km):
// cada carrera comparable y la media de 28 días.
const paceRefSpec: ChartSpec | undefined = refHr
  ? {
      type: 'line',
      categories: efShown.map((p) => shortDate(p.date)),
      series: [
        {
          name: 'Media 28 días',
          data: efShown.map((p) => (p.avg28 ? Math.round(paceAtHr(p.avg28, refHr)) : null)),
          color: 1,
          points: false,
        },
        {
          name: 'Cada rodaje',
          data: efShown.map((p) => Math.round(paceAtHr(p.ef, refHr))),
          color: 1,
          faint: true,
          points: true,
        },
      ],
      format: 'pace',
      reversed: true,
      height: 240,
    }
  : undefined;

// Desacoplamiento en las tiradas largas recientes (≥ 60 min): requiere el archivo FIT de cada una
const decouplings = longTracks
  .map(({ run, track }) => ({ run, d: track?.decoupling }))
  .filter((x): x is { run: Activity; d: NonNullable<ActivityTrack['decoupling']> } => Boolean(x.d));

// VO2máx estimado por sesión (ritmo y FC) frente al de Garmin, en el periodo
const runsById = new Map([...(history ?? []), ...runs].map((r) => [r.id, r]));
const vo2TrendAll = vo2Trend([...runsById.values()], hr.maxHr);
const vo2Est = vo2TrendAll.filter((p) => p.date >= from);
const vo2Dates = [...new Set(vo2Est.map((p) => p.date))];
const garminByDate = garminVo2.toSorted((a, b) => a.date.localeCompare(b.date));
const garminAt = (d: string) => garminByDate.findLast((g) => g.date <= d)?.value;
const vo2Spec: ChartSpec = {
  type: 'line',
  categories: vo2Dates.map(shortDate),
  series: [
    {
      name: 'Estimado (media 28 días)',
      data: vo2Dates.map((d) => {
        const v = vo2At(vo2Est, d);
        return v === undefined ? null : Math.round(v * 10) / 10;
      }),
      color: 1,
      points: false,
    },
    {
      name: 'Cada carrera',
      data: vo2Dates.map((d) => {
        const v = vo2Est.findLast((p) => p.date === d)?.value;
        return v === undefined ? null : Math.round(v * 10) / 10;
      }),
      color: 1,
      faint: true,
      points: true,
    },
    ...(garminByDate.length
      ? [{ name: 'Garmin', data: vo2Dates.map((d) => garminAt(d) ?? null), color: 3 as ColorSlot }]
      : []),
  ],
  format: 'dec1',
  height: 240,
};

// Pronóstico de 10K y media semana a semana a partir del VO2máx estimado (media de 28 días)
const predTrend = predictionTrend(vo2TrendAll, weeks, today);
const hasPredTrend = predTrend.filter((p) => p.vdot !== undefined).length >= 2;
const predNow = predTrend.findLast((p) => p.vdot !== undefined);
const predSpec: ChartSpec = {
  type: 'line',
  categories: predTrend.map((p) => shortDate(p.week)),
  series: [
    { name: '10K', data: predTrend.map((p) => (p.t10k ? Math.round(p.t10k / 10) : null)), color: 1 },
    { name: 'Media maratón', data: predTrend.map((p) => (p.tHalf ? Math.round(p.tHalf / 21.0975) : null)), color: 2 },
  ],
  format: 'pace',
  reversed: true,
  height: 240,
};

// Constancia: Eddington de carrera y rachas, sobre todo el historial (o el periodo si falla)
const allActs = everything ?? all;
const edd = eddington(allActs);
const streak = streaks(allActs, today);

// Curva de marcas (ritmo por distancia) y predicción
const curveDistances = BEST_EFFORT_DISTANCES.filter((d) => periodByDist.has(d) || allTime.has(d));
const curveSpec: ChartSpec = {
  type: 'line',
  categories: curveDistances.map((d) => DIST_LABEL[d]),
  series: [
    {
      name: 'Últimos 12 meses',
      data: curveDistances.map((d) => {
        const r = periodByDist.get(d);
        return r ? Math.round(r.timeS / (d / 1000)) : null;
      }),
      color: 1,
    },
    {
      name: 'Histórico',
      data: curveDistances.map((d) => {
        const r = allTime.get(d);
        return r ? Math.round(r.timeS / (d / 1000)) : null;
      }),
      color: 2,
      faint: true,
    },
  ],
  format: 'pace',
  reversed: true,
  height: 240,
};
// VDOT: la mejor marca de 5 km o más en los últimos 12 meses (las cortas sobrestiman la resistencia)
const vdotBase = records
  .filter((r) => r.distance >= 5000)
  .map((r) => ({ r, v: vdot(r.distance, r.timeS) }))
  .sort((a, b) => b.v - a.v)[0];
const PREDICT = [5000, 10000, 21097.5, 42195] as const;
const PREDICT_LABEL: Record<number, string> = {
  5000: '5 km',
  10000: '10 km',
  21097.5: 'Media maratón',
  42195: 'Maratón',
};
const predictions = vdotBase ? PREDICT.map((d) => ({ d, t: predictTime(vdotBase.v, d) })) : [];
const cs = criticalSpeed(records);
// Contraste: el pronóstico por fisiología (VO2máx estimado como VDOT) frente al de tus marcas, que es el principal
const marks10k = predictions.find((p) => p.d === 10000)?.t;
const fisio10k = predNow?.t10k;
const gap10k = marks10k && fisio10k ? marks10k - fisio10k : undefined;
function gapTextFor(gap: number | undefined): string {
  if (gap === undefined) return '.';
  if (Math.abs(gap) < 60) return ': casi lo mismo que con tus marcas, así que ambas estimaciones cuadran.';
  if (gap > 0)
    return `, ${duration(gap)} más rápido que con tus marcas: puede ser margen que aún no has demostrado en carrera o que la estimación por FC sea optimista.`;
  return `, ${duration(-gap)} más lento que con tus marcas: tus marcas van por delante de lo que sugiere la FC en los rodajes.`;
}
const gapText = gapTextFor(gap10k);
const weeklyKm8 = kmWeekly.slice(-9, -1).reduce((s, w) => s + w.km, 0) / Math.min(8, Math.max(1, kmWeekly.length - 1));

/** El estado del desacoplamiento en palabra (además del color): < 5 % buena base, < 10 % vigilar, si no, alto. */
const decouplingWord = (pct: number) => {
  if (pct < 5) return 'buena base';
  if (pct < 10) return 'vigilar';
  return 'alto';
};

// ---------- ¿Estás mejorando? (cuatro señales frente a hace 6 semanas o a tu histórico) ----------
const vo2Now = vo2At(vo2TrendAll, today);
const vo2Before = vo2At(vo2TrendAll, sixWeeksAgo);
const vo2Change =
  vo2Now !== undefined && vo2Before !== undefined ? Math.round((vo2Now - vo2Before) * 10) / 10 : undefined;
const fitnessBefore = todayPoints.at(-43)?.fitness;
const fitnessRaw = nowP?.formPct !== undefined ? relChange(nowP.fitness, fitnessBefore) : undefined;
const fitnessTrend = fitnessRaw === undefined ? undefined : Math.round(fitnessRaw);
const yearRecords = recordsThisYear(recordRows);
const signed = (x: number, digits = 1) => `${x >= 0 ? '+' : '−'}${km(Math.abs(x), digits)}`;
interface ProgressItem {
  label: string;
  value: string;
  change: string;
  dir?: ProgressDir;
  href: string;
}
const progressItems: ProgressItem[] = [];
if (refHr && efRecent) {
  const dir = trendDir(efChange, PROGRESS_THRESHOLDS.efficiencyPct);
  progressItems.push({
    label: `Ritmo a ${refHr} ppm`,
    value: `${pace(paceAtHr(efRecent, refHr))} /km`,
    change:
      efChange === undefined
        ? 'sin rodajes de hace 6 semanas para comparar'
        : `${signed(efChange)} % de eficiencia en 6 semanas`,
    dir,
    href: '#ritmo-fc',
  });
}
if (vo2Now !== undefined) {
  progressItems.push({
    label: 'VO2máx estimado',
    value: km(vo2Now),
    change: vo2Change === undefined ? 'sin estimación de hace 6 semanas' : `${signed(vo2Change)} en 6 semanas`,
    dir: trendDir(vo2Change, PROGRESS_THRESHOLDS.vo2),
    href: '#vo2',
  });
}
if (yearRecords.total) {
  progressItems.push({
    label: 'Marcas de este año',
    value: `${yearRecords.count} de ${yearRecords.total}`,
    change: yearRecords.count ? 'igualan o mejoran tu histórico' : 'ninguna supera aún tu histórico',
    dir: yearRecords.count ? 'better' : 'same',
    href: '#marcas',
  });
}
if (nowP?.formPct !== undefined) {
  progressItems.push({
    label: 'Forma física (carga)',
    value: int(nowP.fitness),
    change: fitnessTrend === undefined ? 'calibrando' : `${signed(fitnessTrend, 0)} % en 6 semanas`,
    dir: trendDir(fitnessTrend, PROGRESS_THRESHOLDS.fitnessPct),
    href: '#carga',
  });
}
const progress = progressVerdict(progressItems.map((i) => i.dir));
const DIR_TEXT: Record<ProgressDir, { arrow: string; word: string; cls: string }> = {
  better: { arrow: '↑', word: 'Mejor', cls: 'text-green-700 dark:text-green-400' },
  same: { arrow: '→', word: 'Estable', cls: 'text-muted-foreground' },
  worse: { arrow: '↓', word: 'Peor', cls: 'text-amber-800 dark:text-amber-300' },
};
const PROGRESS_TONE = { ok: 'border-l-green-500', warn: 'border-l-amber-400', muted: 'border-l-muted-foreground' };

const sectionTitle = 'type-section';
// Mismo código de color que la tarjeta "Hoy" de Salud: verde bien, ámbar atención, rojo mal
const ZONE_TONE: Record<FormZone, string> = {
  fresh: 'border-l-green-500',
  neutral: 'border-l-green-500',
  optimal: 'border-l-green-500',
  transition: 'border-l-amber-400',
  risk: 'border-l-red-500',
};
---

<Base title="Rendimiento">
  <div class:list={['flex flex-wrap items-center justify-between gap-3', client && !error ? 'mb-2' : 'mb-6']}>
    <h1 class="type-display">Rendimiento</h1>
    {client && <RangeSelector options={WEEK_OPTIONS} current={weeks} param="semanas" />}
  </div>
  {client && !error && (
    <p class="mb-2 text-xs text-muted-foreground">
      El periodo cambia las gráficas de Eficiencia, Carga y Carrera; el resto de bloques dice su propia ventana.
    </p>
  )}
  {client && !error && (
    <PageIndex
      class="mb-4"
      items={[
        { href: '#estado', label: 'Estado de forma' },
        { href: '#eficiencia', label: 'Eficiencia y progreso' },
        { href: '#constancia', label: 'Constancia' },
        { href: '#carga', label: 'Carga' },
        { href: '#volumen', label: 'Volumen' },
        { href: '#carrera', label: 'Carrera' },
      ]}
    />
  )}

  {!client ? (
    <ConnectPrompt />
  ) : error ? (
    <ErrorState error={error} />
  ) : (
    <div class="space-y-8">
      {/* ---------- Estado de forma ---------- */}
      {nowP && !zone && (
        <section class:list={[card, 'border-l-4 border-l-muted-foreground p-5']} aria-labelledby="estado">
          <h2 id="estado" class={sectionTitle}>
            Estado de forma · hoy
          </h2>
          <p class="type-title mt-2">Calibrando</p>
          <p class="mt-1 text-sm text-muted-foreground">
            Hacen falta {FITNESS_DAYS} días de historial de actividades para estimar tu forma física y tu forma.
            Mientras tanto se muestran la carga y la fatiga.
          </p>
        </section>
      )}
      {nowP && zone && (
        <section class:list={[card, 'border-l-4 p-5', ZONE_TONE[zone.zone]]} aria-labelledby="estado">
          <div class="grid gap-6 lg:grid-cols-[1fr_1.3fr]">
            <div>
              <h2 id="estado" class={sectionTitle}>
                Estado de forma · hoy
              </h2>
              <p class="type-title mt-2">{zone.label}</p>
              <p class="mt-1 text-sm text-muted-foreground">{zone.text}</p>
              <Collapsible summary="Cómo se calcula" class="mt-3">
                <p class="text-xs text-muted-foreground">
                  Forma = forma física (carga media de {FITNESS_DAYS} días) − fatiga (de {FATIGUE_DAYS} días), en % de
                  tu forma física. La forma física es carga (TRIMP de Banister), no una nota: sirve para compararte
                  contigo mismo, no con otros ni con el VO2máx. Las zonas son orientativas, no umbrales validados.
                </p>
              </Collapsible>
            </div>
            <div>
              <dl class="grid grid-cols-3 gap-x-6 gap-y-4">
                <div>
                  <dt class="type-label">Forma</dt>
                  <dd class="type-kpi">
                    {nowP.formPct! > 0 ? '+' : ''}
                    {Math.round(nowP.formPct!)} %
                  </dd>
                </div>
                <div>
                  <dt class="type-label">Forma física (carga)</dt>
                  <dd class="type-kpi">{int(nowP.fitness)}</dd>
                  {fitnessChange !== undefined && (
                    <dd class="text-xs tabular-nums text-muted-foreground">
                      {fitnessChange >= 0 ? '↑ +' : '↓ −'}
                      {km(Math.abs(fitnessChange))} en 7 días
                    </dd>
                  )}
                </div>
                <div>
                  <dt class="type-label">Fatiga</dt>
                  <dd class="type-kpi">{int(nowP.fatigue)}</dd>
                </div>
              </dl>
              {loadWarnings.length > 0 && (
                <p class="mt-4 text-sm font-medium text-amber-800 dark:text-amber-300">
                  Pide atención: {loadWarnings.join(' · ')}.
                </p>
              )}
              <Collapsible summary="Más indicadores de carga" class="mt-4">
                <dl class="grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-3">
                  {ratioNow !== undefined && (
                    <div>
                      <dt class="type-label">Ratio agudo:crónico</dt>
                      <dd class="type-value">{km(ratioNow, 2)}</dd>
                      <dd
                        class:list={[
                          'text-xs',
                          ratioZone!.zone === 'optimal'
                            ? 'text-muted-foreground'
                            : 'font-medium text-amber-800 dark:text-amber-300',
                        ]}
                      >
                        {ratioZone!.label}
                      </dd>
                    </div>
                  )}
                  {ramp !== undefined && (
                    <div>
                      <dt class="type-label">Rampa (forma física, 7 días)</dt>
                      <dd class="type-value">
                        {ramp >= 0 ? '+' : '−'}
                        {km(Math.abs(ramp))}
                      </dd>
                      <dd
                        class:list={[
                          'text-xs',
                          ramp > RAMP_ALERT ? 'font-medium text-red-700 dark:text-red-400' : 'text-muted-foreground',
                        ]}
                      >
                        {rampText(ramp)}
                      </dd>
                    </div>
                  )}
                  {mono && (
                    <div>
                      <dt class="type-label">Monotonía · strain (7 días)</dt>
                      <dd class="type-value">
                        {km(mono.monotony, 2)} · {int(mono.strain)}
                      </dd>
                      <dd
                        class:list={[
                          'text-xs',
                          mono.monotony > MONOTONY_HIGH
                            ? 'font-medium text-amber-800 dark:text-amber-300'
                            : 'text-muted-foreground',
                        ]}
                      >
                        {mono.monotony > MONOTONY_HIGH
                          ? 'Poca variedad entre días duros y suaves'
                          : 'Buena variedad de carga'}
                      </dd>
                    </div>
                  )}
                  {change && (
                    <div class="col-span-2">
                      <dt class="type-label">Carga de la semana pasada</dt>
                      <dd class="text-sm">
                        <span class="font-semibold tabular-nums">{int(change.last.total)}</span>
                        {change.pct !== undefined && (
                          <span
                            class:list={[
                              'ml-1 tabular-nums',
                              spike ? 'font-medium text-red-700 dark:text-red-400' : 'text-muted-foreground',
                            ]}
                          >
                            ({change.pct >= 0 ? '+' : '−'}
                            {Math.abs(Math.round(change.pct))} % vs media de 4 semanas{spike ? ' · subida brusca' : ''})
                          </span>
                        )}
                      </dd>
                    </div>
                  )}
                  <div>
                    <dt class="type-label">Días de fuerza</dt>
                    <dd class="text-sm">
                      <span class="font-semibold tabular-nums">{km(strength4)}</span>{' '}
                      <span class="text-muted-foreground">/ semana (4 sem)</span>
                    </dd>
                  </div>
                </dl>
              </Collapsible>
            </div>
          </div>
        </section>
      )}

      {/* ---------- ¿Estás mejorando? ---------- */}
      {progressItems.length > 0 && (
        <section class:list={[card, 'border-l-4 p-5', PROGRESS_TONE[progress.tone]]} aria-labelledby="progreso">
          <h2 id="progreso" class={sectionTitle}>
            ¿Estás mejorando?
          </h2>
          <p class="type-title mt-2">{progress.title}</p>
          <p class="mt-1 max-w-[80ch] text-sm text-muted-foreground">
            Cuatro señales frente a hace 6 semanas (las marcas, frente a tu histórico). Orientativo: cada una tiene su
            detalle más abajo.
          </p>
          <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-4 lg:grid-cols-4">
            {progressItems.map((item) => (
              <li class="min-w-0">
                <a href={item.href} class="group block" data-no-loading>
                  <span class="type-label group-hover:text-foreground">{item.label}</span>
                  <span class="type-readout block whitespace-nowrap">{item.value}</span>
                  {item.dir && (
                    <span class:list={['block text-sm font-medium', DIR_TEXT[item.dir].cls]}>
                      {DIR_TEXT[item.dir].arrow} {DIR_TEXT[item.dir].word}
                    </span>
                  )}
                  <span class="block text-xs text-muted-foreground underline decoration-foreground/20 underline-offset-4 group-hover:decoration-foreground">
                    {item.change}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* ---------- Eficiencia y progreso ---------- */}
      <section class="space-y-4" aria-labelledby="eficiencia">
        <div>
          <h2 id="eficiencia" class={sectionTitle}>
            Eficiencia y progreso
          </h2>
          <p class="mt-1 text-sm text-muted-foreground">
            ¿Corres más rápido con el mismo esfuerzo? Solo se comparan rodajes suaves de asfalto o cinta (30–120 min,
            poco desnivel), para que series y trail no mezclen la tendencia.
          </p>
        </div>

        {efShown.length >= 2 && paceRefSpec ? (
          <section class:list={[card, 'min-w-0 p-4']}>
            <div id="ritmo-fc" class="flex scroll-mt-4 flex-wrap items-baseline justify-between gap-2">
              <h3 class="type-card">Ritmo a {refHr} ppm</h3>
              {efChange !== undefined && (
                <span
                  class:list={[
                    'text-sm font-medium tabular-nums',
                    Math.abs(efChange) < 1
                      ? 'text-muted-foreground'
                      : efChange > 0
                        ? 'text-green-700 dark:text-green-400'
                        : 'text-red-700 dark:text-red-400',
                  ]}
                >
                  {Math.abs(efChange) < 1
                    ? '→ estable'
                    : `${efChange > 0 ? '↑ ' : '↓ '}${km(Math.abs(efChange))} % ${efChange > 0 ? 'más eficiente' : 'menos eficiente'}`}{' '}
                  en 6 semanas
                </span>
              )}
            </div>
            <p class="max-w-prose text-sm text-muted-foreground">
              El ritmo que llevarías a tu FC habitual de rodaje ({refHr} ppm), según la eficiencia de cada rodaje
              (metros por minuto ÷ FC media). Más rápido arriba = mejor forma aeróbica.
            </p>
            <div
              class="mt-2 w-full min-w-0"
              data-chart={JSON.stringify(paceRefSpec)}
              role="img"
              aria-label={`Ritmo a ${refHr} ppm por rodaje y media de 28 días`}
              style="min-height:240px"
            />
            <details class="mt-2 text-sm">
              <summary class="cursor-pointer select-none text-muted-foreground hover:text-foreground pointer-coarse:py-2.5">
                Ver datos
              </summary>
              <section class="mt-2 max-h-72 overflow-auto" tabindex="0" aria-labelledby="datos-ritmo-fc">
                <table class="w-full text-left text-xs">
                  <caption id="datos-ritmo-fc" class="sr-only">
                    Ritmo a {refHr} ppm por rodaje
                  </caption>
                  <thead class="sticky top-0 text-muted-foreground bg-muted/50">
                    <tr>
                      <th scope="col" class="px-2 py-1 font-medium">
                        Fecha
                      </th>
                      <th scope="col" class="px-2 py-1 font-medium">
                        Factor de eficiencia
                      </th>
                      <th scope="col" class="px-2 py-1 font-medium">
                        Ritmo a {refHr} ppm
                      </th>
                      <th scope="col" class="px-2 py-1 font-medium">
                        Media 28 días
                      </th>
                    </tr>
                  </thead>
                  <tbody class="tabular-nums">
                    {efShown.toReversed().map((p) => (
                      <tr class="border-b border-border">
                        <td class="px-2 py-1">{shortDate(p.date)}</td>
                        <td class="px-2 py-1">{km(p.ef, 3)}</td>
                        <td class="px-2 py-1">{pace(paceAtHr(p.ef, refHr!))}</td>
                        <td class="px-2 py-1">{p.avg28 ? pace(paceAtHr(p.avg28, refHr!)) : '—'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </section>
            </details>
          </section>
        ) : (
          <p class:list={[card, 'p-4 text-sm text-muted-foreground']}>
            Hacen falta al menos 2 rodajes suaves en el periodo para ver la tendencia de eficiencia.
          </p>
        )}

        <div class="grid gap-6 lg:grid-cols-2">
          <section class:list={[card, 'min-w-0 p-4']}>
            <h3 class="type-card">Desacoplamiento · últimas tiradas largas</h3>
            <p class="text-sm text-muted-foreground">
              Cuánto cae la eficiencia de la 1.ª a la 2.ª mitad. Por debajo del 5 % suele indicar buena base aeróbica.
            </p>
            <Collapsible summary="Cómo se calcula" class="mt-1">
              <p class="text-xs text-muted-foreground">
                Con el ritmo ajustado por pendiente y sin los 10 primeros minutos, en tiradas de 60 minutos o más. Regla
                orientativa: el calor y la deshidratación lo suben.
              </p>
            </Collapsible>
            {decouplings.length ? (
              <table class="mt-3 w-full text-sm">
                <caption class="sr-only">Desacoplamiento de las últimas tiradas largas</caption>
                <tbody class="tabular-nums">
                  {decouplings.map(({ run, d }) => (
                    <tr class="border-t border-border">
                      <td class="py-2 pr-3 whitespace-nowrap text-muted-foreground">{shortDate(run.date)}</td>
                      <td class="py-2 pr-3">
                        <a
                          href={`/actividades/${run.id}`}
                          class="text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground"
                        >
                          {run.name}
                        </a>
                        <span class="block text-xs text-muted-foreground">
                          {km(run.distanceKm)} km · {duration(run.movingS)}
                        </span>
                      </td>
                      <td
                        class:list={[
                          'py-2 text-right font-semibold whitespace-nowrap',
                          d.pct < 5
                            ? 'text-green-700 dark:text-green-400'
                            : d.pct < 10
                              ? 'text-amber-600 dark:text-amber-400'
                              : 'text-red-700 dark:text-red-400',
                        ]}
                      >
                        {d.pct >= 0 ? '' : '−'}
                        {km(Math.abs(d.pct))} %<span class="block text-xs font-normal">{decouplingWord(d.pct)}</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <p class="py-6 text-center text-sm text-muted-foreground">
                Sin tiradas de 60 minutos o más en el historial cargado.
              </p>
            )}
          </section>

          <section class:list={[card, 'min-w-0 p-4']}>
            <h3 class="type-card">Predicción de carrera · marcas de 12 meses</h3>
            {vdotBase ? (
              <>
                <p class="text-sm text-muted-foreground">
                  VDOT de Daniels <span class="font-semibold text-foreground">{km(vdotBase.v)}</span>, calculado con tu
                  mejor {DIST_LABEL[vdotBase.r.distance]} de los últimos 12 meses ({duration(vdotBase.r.timeS)}).
                </p>
                <table class="mt-3 w-full text-sm">
                  <caption class="sr-only">Predicción de carrera: tiempo y ritmo por distancia</caption>
                  <tbody class="tabular-nums">
                    {predictions.map(({ d, t }) => (
                      <tr class="border-t border-border">
                        <th scope="row" class="py-2 text-left font-medium">
                          {PREDICT_LABEL[d]}
                        </th>
                        <td class="py-2 text-right font-semibold">{duration(t)}</td>
                        <td class="py-2 text-right text-muted-foreground">{pace(t / (d / 1000))} /km</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                {fisio10k && marks10k && (
                  <p class="mt-3 text-sm text-muted-foreground">
                    Según tu VO2máx estimado (media de 28 días), el 10K saldría en{' '}
                    <b class="text-foreground tabular-nums">{duration(fisio10k)}</b>
                    {gapText}
                  </p>
                )}
                {cs && (
                  <p class="mt-3 text-sm">
                    <span class="text-muted-foreground">Velocidad crítica (≈ ritmo umbral):</span>{' '}
                    <span class="font-semibold tabular-nums">{pace(1000 / cs.csMs)} /km</span>
                  </p>
                )}
                <Collapsible summary="Cómo se calcula" class="mt-2">
                  <p class="text-xs text-muted-foreground">
                    Predicciones de mejores tramos dentro de entrenos, no de carreras. Hasta la media suelen acertar; la
                    maratón tiende a salir más lenta si el volumen es bajo (llevas {km(weeklyKm8)} km/semana de media en
                    8 semanas).
                  </p>
                </Collapsible>
                {curveDistances.length >= 2 && (
                  <Collapsible summary="Curva de marcas" class="mt-1">
                    <p class="text-xs text-muted-foreground">
                      Ritmo de tu mejor tramo en cada distancia: cuanto más plana, mejor aguantas el ritmo al alargar.
                    </p>
                    <div
                      class="mt-2 w-full min-w-0"
                      data-chart={JSON.stringify(curveSpec)}
                      role="img"
                      aria-label="Curva de marcas"
                      style="min-height:240px"
                    />
                    <DataTable title="Curva de marcas" spec={curveSpec} categoryLabel="Distancia" />
                  </Collapsible>
                )}
              </>
            ) : (
              <p class="py-6 text-center text-sm text-muted-foreground">
                Hace falta una marca de 5 km o más en los últimos 12 meses.
              </p>
            )}
          </section>
        </div>

        {vo2Dates.length >= 2 && (
          <ChartCard
            id="vo2"
            title="VO2máx estimado"
            subtitle="Por carrera, con el ritmo y la FC. Ruidoso: fíjate en la media; el de Garmin, como referencia."
            how="Coste de oxígeno del ritmo (Daniels) dividido por la fracción de VO2máx que corresponde a la FC (Swain). Solo carreras de asfalto o cinta de 20 a 150 min, con poco desnivel y FC entre el 65 y el 95 % de la máxima."
            spec={vo2Spec}
            table={{
              headers: ['Día', 'Carrera', 'Media 28 d', 'Garmin'],
              rows: vo2Dates.map((d) => [
                shortDate(d),
                km(vo2Est.findLast((p) => p.date === d)?.value),
                km(vo2At(vo2Est, d)),
                km(garminAt(d)),
              ]),
            }}
          >
            {hasPredTrend && (
              <Collapsible summary="Pronóstico semana a semana con esta estimación" class="mt-1">
                <p class="text-xs text-muted-foreground">
                  Ritmo previsto cada semana tomando la media de 28 días como VDOT (la predicción principal, con tus
                  marcas, está en Eficiencia y progreso)
                  {predNow?.t10k && predNow.tHalf
                    ? ` · ahora: 10K en ${duration(predNow.t10k)}, media en ${duration(predNow.tHalf)}`
                    : ''}
                  . Orientativo; más rápido arriba.
                </p>
                <div
                  class="mt-2 w-full min-w-0"
                  data-chart={JSON.stringify(predSpec)}
                  role="img"
                  aria-label="Pronóstico de 10K y media maratón"
                  style="min-height:240px"
                />
                <DataTable title="Pronóstico de 10K y media maratón" spec={predSpec} categoryLabel="Semana" />
              </Collapsible>
            )}
          </ChartCard>
        )}
      </section>

      {/* ---------- Constancia ---------- */}
      <section class="space-y-4" aria-labelledby="constancia">
        <h2 id="constancia" class={sectionTitle}>
          Constancia · todo el historial
        </h2>
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
          <div class:list={[card, 'p-4']}>
            <p class="type-label">Número de Eddington (carrera)</p>
            <p class="mt-1 type-kpi">{edd.value}</p>
            <p class="mt-1 text-xs text-muted-foreground">
              {edd.value} días con al menos {edd.value} km. Para llegar a {edd.value + 1}: {edd.toNext}{' '}
              {edd.toNext === 1 ? 'día más' : 'días más'} de {edd.value + 1} km o más.
            </p>
          </div>
          <div class:list={[card, 'p-4']}>
            <p class="type-label">Racha de días con actividad</p>
            <p class="mt-1 type-kpi">
              {streak.currentDays.length
                ? `${streak.currentDays.length} ${streak.currentDays.length === 1 ? 'día' : 'días'}`
                : 'En pausa'}
            </p>
            <p class="mt-1 text-xs text-muted-foreground">
              {streak.currentDays.from ? `Desde el ${shortDate(streak.currentDays.from)}. ` : ''}La más larga:{' '}
              {streak.longestDays.length} días
              {streak.longestDays.from
                ? ` (${shortDate(streak.longestDays.from)} ${streak.longestDays.from.slice(0, 4)})`
                : ''}
              .
            </p>
          </div>
          <div class:list={[card, 'p-4']}>
            <p class="type-label">Semanas seguidas corriendo</p>
            <p class="mt-1 type-kpi">
              {streak.currentWeeks.length} {streak.currentWeeks.length === 1 ? 'semana' : 'semanas'}
            </p>
            <p class="mt-1 text-xs text-muted-foreground">
              La más larga: {streak.longestWeeks.length} semanas
              {streak.longestWeeks.from
                ? ` (desde el ${shortDate(streak.longestWeeks.from)} ${streak.longestWeeks.from.slice(0, 4)})`
                : ''}
              .
            </p>
          </div>
          <div class:list={[card, 'p-4']}>
            <p class="text-sm text-muted-foreground">Calendario anual</p>
            <p class="mt-1 text-sm">
              Tus días de actividad y tus competiciones, año a año, en{' '}
              <a
                href="/competiciones#calendario"
                class="text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground"
              >
                Competiciones
              </a>
              .
            </p>
          </div>
        </div>
        {!everything && (
          <p class="text-xs text-muted-foreground">
            No se ha podido cargar el historial completo: las rachas y el Eddington cubren solo el periodo cargado.
          </p>
        )}
      </section>

      {/* ---------- Carga ---------- */}
      <section id="seccion-carga" class="scroll-mt-4 space-y-4" aria-labelledby="carga">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="carga" class={sectionTitle}>
            Carga de entrenamiento
          </h2>
          <RangeSelector
            options={LOAD_SCOPES.map((o) => ({ value: o.scope, label: o.label }))}
            current={scope}
            param="carga"
            label="Actividades que cuentan como carga"
            anchor="seccion-carga"
          />
        </div>
        <section class:list={[card, 'min-w-0 p-4']}>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="type-card">Forma física, fatiga y forma</h3>
            <p class="text-xs text-muted-foreground">
              TRIMP de Banister por sesión · FC reposo {hr.restingHr}, máx. {hr.maxHr}
              {hrRef ? ' (zonas de Garmin)' : ' (estimadas)'}
            </p>
          </div>
          <p class="mt-1 max-w-[80ch] text-sm text-muted-foreground">
            La forma física sube despacio con la carga constante; la fatiga reacciona rápido. Si la forma cae por debajo
            de −30 %, la fatiga va por delante.
          </p>
          <div
            class="mt-3 w-full min-w-0"
            data-chart={JSON.stringify(fitnessSpec)}
            role="img"
            aria-label="Forma física y fatiga"
            style="min-height:220px"
          />
          {hasForm && (
            <>
              <p class="mt-2 text-sm text-muted-foreground">Forma (% de la forma física)</p>
              <div
                class="w-full min-w-0"
                data-chart={JSON.stringify(formSpec)}
                role="img"
                aria-label="Forma"
                style="min-height:170px"
              />
            </>
          )}
          <DataTable title="Forma física, fatiga y forma" table={pmcTable} />
          <details class="mt-1 text-sm">
            <summary class="cursor-pointer select-none text-muted-foreground hover:text-foreground pointer-coarse:py-2.5">
              Cómo leer las zonas
            </summary>
            <ul class="mt-2 space-y-1 text-xs text-muted-foreground">
              {FORM_ZONES.map((z, i) => (
                <li>
                  <span class="font-semibold">{z.label}</span> (
                  {i === 0
                    ? `> +${z.min} %`
                    : z.min === -Infinity
                      ? `< ${FORM_ZONES[i - 1].min} %`
                      : `${z.min} a ${FORM_ZONES[i - 1].min} %`}
                  ): {z.text}
                </li>
              ))}
            </ul>
          </details>
          {hasAcwr && (
            <Collapsible summary="Ratio agudo:crónico en el tiempo" class="mt-1">
              <p class="text-xs text-muted-foreground">
                Fatiga (7 d) / forma física (42 d). {acwrLegend}. Orientativo.
              </p>
              <div
                class="mt-2 w-full min-w-0"
                data-chart={JSON.stringify(acwrSpec)}
                role="img"
                aria-label="Ratio agudo:crónico"
                style="min-height:220px"
              />
              <DataTable title="Ratio agudo:crónico" spec={acwrSpec} categoryLabel="Día" />
            </Collapsible>
          )}
        </section>

        <div class="grid gap-6 lg:grid-cols-2">
          <ChartCard
            title="Carga semanal por tipo"
            subtitle={`Avisa si una semana sube más de un ${WEEKLY_SPIKE_PCT} % sobre la media de las 4 anteriores`}
            spec={loadSpec}
            table={{
              headers: ['Semana', 'Carga', 'Días de fuerza'],
              rows: shownWeeks.map((w) => [shortDate(w.week), int(w.total), int(w.strengthDays)]),
            }}
          />
          <ChartCard
            title="Distribución de intensidad"
            subtitle={`${periodLow !== null ? `${periodLow} % del tiempo en baja intensidad en el periodo · ` : ''}los fondistas de élite hacen ~80 % suave`}
            spec={intensitySpec}
            table={{
              headers: ['Semana', 'Baja', 'Moderada', 'Alta'],
              rows: shownWeeks.map((w) => [shortDate(w.week), duration(w.low), duration(w.mid), duration(w.high)]),
            }}
          />
        </div>
      </section>

      {/* ---------- Volumen por deporte ---------- */}
      <section class="space-y-4" aria-labelledby="volumen">
        <h2 id="volumen" class={sectionTitle}>
          Volumen · semana y mes en curso
        </h2>
        <p class="max-w-[80ch] text-sm text-muted-foreground">
          Todos los deportes. Esta semana llevas{' '}
          <span class="font-semibold text-foreground tabular-nums">
            {int(weekAll.sessions)} {weekAll.sessions === 1 ? 'sesión' : 'sesiones'} y {hoursMinutes(weekAll.timeS)}
          </span>{' '}
          ({int(weekAllPrev.sessions)} y {hoursMinutes(weekAllPrev.timeS)} la semana pasada a estas alturas).
        </p>
        <Collapsible summary="Ver por deporte (semana y mes en curso)">
          <div class="grid gap-6 lg:grid-cols-2">
            {volumes.map((period) => {
              const groups = SPORT_GROUPS.filter((g) => period.current.has(g.group) || period.previous.has(g.group));
              const captionId = `volumen-${period.label.toLowerCase()}`;
              return (
                <section class:list={[card, 'min-w-0 p-4']} aria-labelledby={captionId}>
                  <h3 id={captionId} class="type-card">
                    {period.label} en curso
                  </h3>
                  <p class="text-sm text-muted-foreground">
                    Desde el {shortDate(period.from)} frente al mismo tramo anterior ({shortDate(period.prevFrom)}–
                    {shortDate(period.prevTo)})
                  </p>
                  {groups.length === 0 ? (
                    <p class="mt-3 text-sm">Sin actividades.</p>
                  ) : (
                    <div class="mt-3 overflow-x-auto">
                      <table class="w-full text-sm">
                        <caption class="sr-only">
                          Volumen por deporte · {period.label.toLowerCase()} en curso frente al mismo tramo anterior
                        </caption>
                        <thead class="border-b border-border text-xs text-muted-foreground">
                          <tr>
                            <th scope="col" class="py-1 pr-3 text-left font-medium">
                              Deporte
                            </th>
                            <th scope="col" class="hidden py-1 pr-3 text-right font-medium sm:table-cell">
                              Sesiones
                            </th>
                            <th scope="col" class="py-1 pr-3 text-right font-medium">
                              Km
                            </th>
                            <th scope="col" class="py-1 pr-3 text-right font-medium">
                              Tiempo
                            </th>
                            <th scope="col" class="hidden py-1 text-right font-medium sm:table-cell">
                              Desnivel&nbsp;+
                            </th>
                          </tr>
                        </thead>
                        <tbody class="tabular-nums">
                          {groups.map(({ group, label }) => {
                            const c = period.current.get(group) ?? { sessions: 0, km: 0, timeS: 0, elevationM: 0 };
                            const prevV = period.previous.get(group) ?? { sessions: 0, km: 0, timeS: 0, elevationM: 0 };
                            return (
                              <tr class="border-t border-border">
                                <th scope="row" class="py-2 pr-3 text-left font-medium">
                                  {label}
                                </th>
                                <td class="hidden py-2 pr-3 text-right whitespace-nowrap sm:table-cell">
                                  {c.sessions}
                                  <span class="block text-xs text-muted-foreground sm:inline">
                                    {vs(c.sessions, prevV.sessions)}
                                  </span>
                                </td>
                                <td class="py-2 pr-3 text-right whitespace-nowrap">
                                  {c.km > 0 ? km(c.km) : '—'}
                                  <span class="block text-xs text-muted-foreground sm:inline">
                                    {c.km > 0 ? vs(c.km, prevV.km) : ''}
                                  </span>
                                </td>
                                <td class="py-2 pr-3 text-right whitespace-nowrap">
                                  {hoursMinutes(c.timeS)}
                                  <span class="block text-xs text-muted-foreground sm:inline">
                                    {vs(c.timeS, prevV.timeS)}
                                  </span>
                                </td>
                                <td class="hidden py-2 text-right whitespace-nowrap sm:table-cell">
                                  {c.elevationM > 0 ? `${int(c.elevationM)} m` : '—'}
                                </td>
                              </tr>
                            );
                          })}
                        </tbody>
                      </table>
                    </div>
                  )}
                </section>
              );
            })}
          </div>
        </Collapsible>
      </section>

      {/* ---------- Carrera ---------- */}
      <section class="space-y-4" aria-labelledby="carrera">
        <h2 id="carrera" class={sectionTitle}>
          Carrera
        </h2>
        <div class="grid gap-6 lg:grid-cols-[1fr_2fr]">
          <div class:list={[card, 'space-y-5 p-4']}>
            <div>
              <h3 class="type-card">Esta semana</h3>
              <p class="text-xs text-muted-foreground">
                Desde el {shortDate(thisWeek)}; entre paréntesis, la semana pasada a estas alturas
              </p>
              <dl class="mt-2 grid grid-cols-2 gap-4">
                {weekFigures.map((f) => (
                  <div>
                    <dt class="type-label">{f.label}</dt>
                    <dd class="type-value whitespace-nowrap">
                      {f.value}
                      {f.unit && <span class="text-sm font-normal text-muted-foreground"> {f.unit}</span>}
                    </dd>
                    <dd class="text-xs text-muted-foreground tabular-nums">({f.before})</dd>
                  </div>
                ))}
              </dl>
            </div>
            <div class="border-t border-border pt-4">
              <h3 class="type-card">Periodo · {WEEK_OPTIONS.find((o) => o.value === weeks)!.label}</h3>
              <dl class="mt-2 grid grid-cols-2 gap-4">
                {periodFigures.map((f) => (
                  <div>
                    <dt class="type-label">{f.label}</dt>
                    <dd class="type-value whitespace-nowrap">
                      {f.value}
                      {f.unit && <span class="text-sm font-normal text-muted-foreground"> {f.unit}</span>}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
          <ChartCard
            title="Kilómetros por semana"
            subtitle="Carrera, trail y cinta · semanas de lunes a domingo"
            spec={kmSpec}
            table={{
              headers: ['Semana', 'Km', 'Sesiones', 'Tiempo'],
              rows: kmWeekly.map((w) => [shortDate(w.week), km(w.km), int(w.runs), duration(w.movingS)]),
            }}
          />
        </div>

        <section id="marcas" class:list={[card, 'min-w-0 scroll-mt-4 p-4']}>
          <h3 class="type-card">Mejores marcas</h3>
          <p class="text-sm text-muted-foreground">
            Mejor tramo dentro de cualquier carrera en los últimos 12 meses (desde el {shortDate(yearAgo)}{' '}
            {yearAgo.slice(0, 4)}) frente a tu mejor marca
            {firstRun ? ` desde ${yearDate(firstRun)}` : ' histórica'}.
          </p>
          {recordRows.length ? (
            <section class="mt-3 max-w-3xl overflow-x-auto" tabindex="0" aria-labelledby="tabla-marcas">
              <table class="w-full text-sm">
                <caption id="tabla-marcas" class="sr-only">
                  Mejores marcas: últimos 12 meses frente a la histórica
                </caption>
                <thead class="border-b border-border text-xs text-muted-foreground">
                  <tr>
                    <th scope="col" class="py-1 pr-3 text-left font-medium">
                      Distancia
                    </th>
                    <th scope="col" class="py-1 pr-3 text-right font-medium">
                      <span class="sm:hidden">12 meses</span>
                      <span class="hidden sm:inline">Últimos 12 meses</span>
                    </th>
                    <th scope="col" class="py-1 pr-3 text-right font-medium">
                      Histórica
                    </th>
                    <th scope="col" class="py-1 text-right font-medium">
                      Diferencia
                    </th>
                  </tr>
                </thead>
                <tbody class="tabular-nums">
                  {recordRows.map(({ distance, period, best }) => (
                    <tr class="border-t border-border">
                      <td class="py-2 pr-3 font-medium whitespace-nowrap">{DIST_LABEL[distance]}</td>
                      <td class="py-2 pr-3 text-right whitespace-nowrap">
                        {period ? (
                          <>
                            <span class="font-semibold">{duration(period.timeS)}</span>
                            <span class="block text-xs text-muted-foreground">
                              {pace(period.timeS / (distance / 1000))} /km
                              <span class="hidden sm:inline"> · </span>
                              <a
                                href={`/actividades/${period.activityId}`}
                                class="block text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground pointer-coarse:py-2 sm:inline"
                                title={period.activityName}
                              >
                                {yearDate(period.date)}
                              </a>
                            </span>
                          </>
                        ) : (
                          <span class="text-muted-foreground">—</span>
                        )}
                      </td>
                      <td class="py-2 pr-3 text-right whitespace-nowrap">
                        {best ? (
                          <>
                            <span class="font-semibold">{duration(best.timeS)}</span>
                            <span class="block text-xs text-muted-foreground">
                              {pace(best.timeS / (distance / 1000))} /km
                              <span class="hidden sm:inline"> · </span>
                              <a
                                href={`/actividades/${best.activityId}`}
                                class="block text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground pointer-coarse:py-2 sm:inline"
                                title={best.activityName}
                              >
                                {yearDate(best.date)}
                              </a>
                            </span>
                          </>
                        ) : (
                          <span class="text-muted-foreground">—</span>
                        )}
                      </td>
                      <td class="py-2 text-right whitespace-nowrap">
                        {period && best ? (
                          period.timeS <= best.timeS ? (
                            <span class="chip chip-ok">Récord</span>
                          ) : (
                            <>
                              <span class="font-medium">+{duration(period.timeS - best.timeS)}</span>
                              <span class="block text-xs text-muted-foreground">
                                +{km(((period.timeS - best.timeS) / best.timeS) * 100)} %
                              </span>
                            </>
                          )
                        ) : (
                          <span class="text-muted-foreground">—</span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          ) : (
            <p class="py-6 text-center text-sm text-muted-foreground">Sin carreras con marcas registradas.</p>
          )}
          {!history && (
            <p class="mt-2 text-xs text-muted-foreground">
              No se ha podido cargar el histórico completo; se muestra solo el periodo.
            </p>
          )}
        </section>
      </section>
    </div>
  )}
</Base>

<script>
  import '../scripts/charts';
</script>
