---
/**
 * Comparador entre años: volumen por mes, acumulado anual y resumen por año para el tipo de actividad elegido.
 * Usa todo el historial (en memoria 6 h por usuario).
 */
import Base from '../layouts/Base.astro';
import ConnectPrompt from '../components/ConnectPrompt.astro';
import ErrorState from '../components/ErrorState.astro';
import FilterGroup from '../components/FilterGroup.astro';
import ChartCard from '../components/ChartCard.astro';
import { clientFor, getAllActivities, type Activity } from '../lib/garmin';
import { isoDate } from '../lib/dates';
import { hasDistance, kindOf, speedUnit, speedValue } from '../lib/activity-kinds';
import { MONTHS, cumulative, monthlyTotals, yearSummary, yearToDate } from '../lib/compare';
import { activityLabel, hoursMinutes, int, km, pace, speed } from '../lib/format';
import type { ChartSpec, ColorSlot } from '../lib/chart-spec';
import { card } from '../lib/ui';

const RUN = 'correr';
const ALL = 'todas';
const MAX_YEARS = 4;

const client = clientFor(Astro.locals);
const today = isoDate();
const thisYear = Number(today.slice(0, 4));
const mmdd = today.slice(5);

let all: Activity[] = [];
let error: unknown;
if (client) {
  try {
    all = await getAllActivities(client, today);
  } catch (err) {
    error = err;
  }
}

// ---------- Tipo ----------
const counts = new Map<string, number>();
for (const a of all) counts.set(a.typeKey, (counts.get(a.typeKey) ?? 0) + 1);
const types = [...counts.entries()].sort((a, b) => b[1] - a[1]);
const isRunType = (k: string) => /run/.test(k);
const runCount = all.filter((a) => isRunType(a.typeKey)).length;

const tipoParam = Astro.url.searchParams.get('tipo');
const tipo = tipoParam && /^[a-z0-9_]+$/i.test(tipoParam) ? tipoParam : runCount ? RUN : ALL;
const activities =
  tipo === ALL ? all : tipo === RUN ? all.filter((a) => isRunType(a.typeKey)) : all.filter((a) => a.typeKey === tipo);
const kind = tipo === RUN ? 'foot' : tipo === ALL ? undefined : kindOf(tipo);
const byDistance = kind !== undefined && hasDistance(kind) && activities.some((a) => a.distanceKm > 0);
const typeTitle = tipo === RUN ? 'Correr' : tipo === ALL ? 'Todas las actividades' : activityLabel(tipo);

// ---------- Años ----------
const availableYears = [...new Set(activities.map((a) => Number(a.date.slice(0, 4))))].sort((a, b) => b - a);
const yearsParam = (Astro.url.searchParams.get('anios') ?? '')
  .split(',')
  .map(Number)
  .filter((y) => availableYears.includes(y));
const years = (yearsParam.length ? yearsParam : availableYears.slice(0, 3)).slice(0, MAX_YEARS).sort((a, b) => a - b);

const hrefWith = (changes: Record<string, string | undefined>) => {
  const params = new URLSearchParams(Astro.url.search);
  for (const [k, v] of Object.entries(changes)) {
    if (v === undefined) params.delete(k);
    else params.set(k, v);
  }
  const qs = params.toString();
  return qs ? `?${qs}` : '/comparador';
};
const toggleYear = (y: number) => {
  const next = years.includes(y) ? years.filter((x) => x !== y) : [...years, y].sort((a, b) => a - b).slice(-MAX_YEARS);
  return hrefWith({ anios: next.length ? next.join(',') : undefined });
};
/** Años del selector en orden cronológico, como las tarjetas, las leyendas y la tabla. */
const yearItems = [...availableYears]
  .reverse()
  .map((y) => ({ href: toggleYear(y), label: String(y), active: years.includes(y) }));

// ---------- Datos ----------
const metric = (m: { km: number; movingS: number }) => (byDistance ? Math.round(m.km * 10) / 10 : m.movingS);
const fmtMetric = (m: { km: number; movingS: number }) => (byDistance ? `${km(m.km)} km` : hoursMinutes(m.movingS));
const unitLabel = byDistance ? 'Kilómetros' : 'Tiempo';
const monthly = years.map((y) => ({ year: y, months: monthlyTotals(activities, y) }));
const colorOf = (i: number) => ((i % 4) + 1) as ColorSlot;

const monthlySpec: ChartSpec = {
  type: 'bar',
  categories: MONTHS,
  series: monthly.map((m, i) => ({ name: String(m.year), data: m.months.map(metric), color: colorOf(i) })),
  format: byDistance ? 'km' : 'hm',
  height: 300,
};
const cumulativeSpec: ChartSpec = {
  type: 'line',
  categories: MONTHS,
  series: monthly.map((m, i) => ({
    name: String(m.year),
    data: cumulative(m.months.map(metric), m.year === thisYear ? Number(mmdd.slice(0, 2)) : 12),
    color: colorOf(i),
  })),
  format: byDistance ? 'km' : 'hm',
  height: 300,
};

const summaries = years.map((y) => yearSummary(activities, y, byDistance));
const mainOf = (s: { km: number; movingS: number }) => (byDistance ? s.km : s.movingS);
const pctVs = (cur: number, prev?: number) => (prev ? ((cur - prev) / prev) * 100 : undefined);
const ytd = years.map((y) => ({ year: y, ...yearToDate(activities, y, mmdd) }));
const ytdCurrent = ytd.find((y) => y.year === thisYear);
const avgSpeedText = (s: { km: number; movingS: number }) => {
  if (!kind || !byDistance) return '—';
  const v = speedValue(kind, s.km, s.movingS);
  if (v === undefined) return '—';
  return `${kind === 'cycling' ? speed(v) : pace(v)} ${speedUnit(kind)}`;
};
const signed = (p?: number) => (p === undefined ? '' : `${p >= 0 ? '+' : '−'}${Math.abs(Math.round(p))} %`);

const sectionTitle = 'type-section';
const todayLabel = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(
  new Date(`${today}T00:00:00Z`),
);
---

<Base title="Comparador">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    {client && !error ? (
      <div>
        <h1 class="type-display">
          <button
            data-dropdown-toggle="cmp-type-menu"
            data-dropdown-placement="bottom-start"
            type="button"
            class="-ml-2 flex items-center gap-2 rounded-lg px-2 py-1 text-left hover:bg-accent hover:text-accent-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none"
            aria-label={`Tipo de actividad: ${typeTitle}`}
          >
            Comparador · {typeTitle}
            <svg class="h-4 w-4 shrink-0 text-muted-foreground" fill="none" viewBox="0 0 10 6" aria-hidden="true">
              <path
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="m1 1 4 4 4-4"
              />
            </svg>
          </button>
        </h1>
        <div
          id="cmp-type-menu"
          class="z-50 hidden max-h-96 w-72 overflow-y-auto border border-border bg-popover text-popover-foreground rounded-md shadow-md"
        >
          <ul class="py-1 text-sm" aria-label="Tipo de actividad">
            {[
              ...(runCount ? [[RUN, runCount, 'Correr (carrera + trail + cinta)'] as const] : []),
              [ALL, all.length, 'Todas las actividades'] as const,
              ...types.map(([k, n]) => [k, n, activityLabel(k)] as const),
            ].map(([key, n, label]) => (
              <li>
                <a
                  href={hrefWith({ tipo: key, anios: undefined })}
                  aria-current={key === tipo ? 'page' : undefined}
                  class:list={[
                    'flex items-center justify-between gap-3 px-4 py-2 hover:bg-accent hover:text-accent-foreground',
                    key === tipo &&
                      'font-semibold text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground',
                  ]}
                >
                  <span class="truncate">{label}</span>
                  <span class="text-xs tabular-nums text-muted-foreground">{n}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ) : (
      <h1 class="type-display">Comparador</h1>
    )}
  </div>

  {!client ? (
    <ConnectPrompt />
  ) : error ? (
    <ErrorState error={error} />
  ) : availableYears.length === 0 ? (
    <p class:list={[card, 'p-6 text-sm text-muted-foreground']}>No hay actividades de este tipo.</p>
  ) : (
    <div class="space-y-6">
      {/* Selector de años */}
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm text-muted-foreground">Años (máx. {MAX_YEARS}):</span>
        <FilterGroup items={yearItems} label={`Años (máx. ${MAX_YEARS})`} />
      </div>

      {years.length === 0 ? (
        <p class:list={[card, 'p-6 text-sm text-muted-foreground']}>Elige al menos un año.</p>
      ) : (
        <>
          {/* Año hasta hoy */}
          <section aria-labelledby="ytd">
            <h2 id="ytd" class:list={[sectionTitle, 'mb-3']}>
              Del 1 de enero al {todayLabel}
            </h2>
            <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
              {ytd.map((y) => {
                const delta = y.year !== thisYear && ytdCurrent ? pctVs(mainOf(ytdCurrent), mainOf(y)) : undefined;
                return (
                  <div class:list={[card, 'p-4']}>
                    <p class="type-label">{y.year}</p>
                    <p class="mt-1 type-kpi">{fmtMetric(y)}</p>
                    <p class="text-xs text-muted-foreground">{int(y.sessions)} sesiones</p>
                    {delta !== undefined &&
                      (Math.abs(delta) < 1 ? (
                        <p class="mt-1 text-xs font-medium text-muted-foreground">
                          → {thisYear} va igual que {y.year}
                        </p>
                      ) : (
                        <p
                          class:list={[
                            'mt-1 text-xs font-medium tabular-nums',
                            delta > 0 ? 'text-green-400' : 'text-red-400',
                          ]}
                        >
                          {delta > 0 ? '↑' : '↓'} {thisYear} va {signed(delta)} frente a {y.year}
                        </p>
                      ))}
                  </div>
                );
              })}
            </div>
          </section>

          <div class="grid gap-6 xl:grid-cols-2">
            <ChartCard
              title={`${unitLabel} por mes`}
              subtitle="Un color por año"
              spec={monthlySpec}
              table={{
                headers: ['Mes', ...years.map(String)],
                rows: MONTHS.map((m, i) => [
                  m,
                  ...monthly.map((y) => `${fmtMetric(y.months[i])} · ${y.months[i].sessions} ses.`),
                ]),
              }}
            />
            <ChartCard
              title={byDistance ? 'Kilómetros acumulados en el año' : 'Tiempo acumulado en el año'}
              subtitle={`El año en curso llega hasta ${MONTHS[Number(mmdd.slice(0, 2)) - 1]}`}
              spec={cumulativeSpec}
            />
          </div>

          {/* Resumen por año */}
          <section class:list={[card, 'overflow-x-auto']} tabindex="0" aria-labelledby="tabla-resumen">
            <table class="w-full text-left text-sm">
              <caption id="tabla-resumen" class="sr-only">
                Resumen por año
              </caption>
              <thead class="border-b border-border text-xs text-muted-foreground">
                <tr>
                  <th scope="col" class="px-2.5 py-3 sm:px-4">
                    Año
                  </th>
                  <th scope="col" class="hidden px-2.5 py-3 sm:px-4 text-right sm:table-cell">
                    Sesiones
                  </th>
                  {byDistance && (
                    <th scope="col" class="px-2.5 py-3 sm:px-4 text-right">
                      Distancia<span class="sm:hidden"> y tiempo</span>
                    </th>
                  )}
                  {/* En móvil, con distancia, el tiempo va bajo los km para no desplazarse de lado */}
                  <th scope="col" class:list={['px-2.5 py-3 sm:px-4 text-right', byDistance && 'hidden sm:table-cell']}>
                    Tiempo
                  </th>
                  {byDistance && (
                    <th scope="col" class="px-2.5 py-3 sm:px-4 text-right">
                      {kind === 'cycling' ? 'Velocidad media' : 'Ritmo medio'}
                    </th>
                  )}
                  <th scope="col" class="hidden px-2.5 py-3 sm:px-4 text-right sm:table-cell">
                    FC media
                  </th>
                  {byDistance && (
                    <th scope="col" class="hidden px-2.5 py-3 sm:px-4 text-right md:table-cell">
                      Desnivel&nbsp;+
                    </th>
                  )}
                  <th scope="col" class="hidden px-2.5 py-3 sm:px-4 text-right sm:table-cell">
                    Mejor mes
                  </th>
                  <th scope="col" class="px-2.5 py-3 sm:px-4 text-right">
                    vs año anterior
                  </th>
                </tr>
              </thead>
              <tbody class="tabular-nums">
                {summaries.map((s, i) => {
                  const prev = summaries[i - 1];
                  const delta = prev && prev.year === s.year - 1 ? pctVs(mainOf(s), mainOf(prev)) : undefined;
                  return (
                    <tr class="border-t border-border">
                      <td class="px-2.5 py-3 sm:px-4 font-semibold">
                        {s.year}
                        {s.year === thisYear && (
                          <span class="block text-xs font-normal text-muted-foreground sm:ml-1 sm:inline">
                            (en curso)
                          </span>
                        )}
                      </td>
                      <td class="hidden px-2.5 py-3 sm:px-4 text-right sm:table-cell">{int(s.sessions)}</td>
                      {byDistance && (
                        <td class="px-2.5 py-3 sm:px-4 text-right whitespace-nowrap">
                          {km(s.km)} km
                          <span class="block text-xs text-muted-foreground sm:hidden">{hoursMinutes(s.movingS)}</span>
                        </td>
                      )}
                      <td
                        class:list={[
                          'px-2.5 py-3 sm:px-4 text-right whitespace-nowrap',
                          byDistance && 'hidden sm:table-cell',
                        ]}
                      >
                        {hoursMinutes(s.movingS)}
                      </td>
                      {byDistance && (
                        <td class="px-2.5 py-3 sm:px-4 text-right whitespace-nowrap">{avgSpeedText(s)}</td>
                      )}
                      <td class="hidden px-2.5 py-3 sm:px-4 text-right sm:table-cell">{int(s.avgHr)}</td>
                      {byDistance && (
                        <td class="hidden px-2.5 py-3 sm:px-4 text-right whitespace-nowrap md:table-cell">
                          {int(s.elevationGainM)} m
                        </td>
                      )}
                      <td class="hidden px-2.5 py-3 sm:px-4 text-right sm:table-cell">
                        {s.bestMonth !== undefined ? MONTHS[s.bestMonth] : '—'}
                      </td>
                      <td
                        class:list={[
                          'px-2.5 py-3 sm:px-4 text-right whitespace-nowrap',
                          delta === undefined
                            ? 'text-muted-foreground'
                            : delta >= 0
                              ? 'text-green-400'
                              : 'text-red-400',
                        ]}
                      >
                        {delta === undefined ? '—' : signed(delta)}
                        {delta !== undefined && s.year === thisYear && (
                          <span class="block text-xs whitespace-normal text-muted-foreground">año incompleto</span>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </section>
        </>
      )}
    </div>
  )}
</Base>

<script>
  import '../scripts/charts';
</script>
