---
/** Listado de actividades; cada fila se formatea según su familia (ritmo, velocidad o nada). */
import type { Activity } from '../lib/garmin/types';
import { hasDistance, kindOf, speedUnit, speedValue } from '../lib/activity-kinds';
import { activityLabel, dayLabel, duration, hoursMinutes, int, km, pace, speed } from '../lib/format';
import TrophyTip from './TrophyTip.astro';

interface Props {
  activities: Activity[];
  /** Muestra la etiqueta del tipo junto al nombre (útil cuando se mezclan tipos). */
  showType?: boolean;
  /** Nombre accesible de la tabla (va en un <caption> solo para lectores de pantalla). */
  caption?: string;
}
const { activities, showType = false, caption = 'Actividades' } = Astro.props;
const captionId = `tabla-${crypto.randomUUID()}`;
/** Columnas secundarias: se ocultan en móvil para no obligar a desplazarse de lado. */
const secondary = 'hidden sm:table-cell';
const kinds = activities.map((a) => kindOf(a.typeKey));
const anyDistance = activities.some((a, i) => hasDistance(kinds[i]) && a.distanceKm > 0);
const anySpeed = activities.some((a, i) => speedValue(kinds[i], a.distanceKm, a.movingS) !== undefined);
const anyElevation = activities.some((a) => a.elevationGainM);
const anyCalories = activities.some((a) => a.calories);

function speedText(a: Activity, i: number): string {
  const k = kinds[i];
  const v = speedValue(k, a.distanceKm, a.movingS);
  if (v === undefined) return '—';
  return k === 'cycling' ? `${speed(v)} ${speedUnit(k)}` : `${pace(v)} ${speedUnit(k)}`;
}
/** El nombre ya dice el tipo (Garmin lo añade al nombre automático): sin etiqueta repetida. */
const nameSaysType = (a: Activity) => a.name.toLowerCase().includes(activityLabel(a.typeKey).toLowerCase());
const distanceText = (a: Activity, i: number) =>
  !hasDistance(kinds[i]) || a.distanceKm <= 0
    ? '—'
    : kinds[i] === 'swim'
      ? `${int(a.distanceKm * 1000)} m`
      : `${km(a.distanceKm, 2)} km`;
---

<!-- Contenedor con scroll lateral: con tabindex se puede desplazar con el teclado (guía responsive-table). La regla
     noNoninteractiveTabindex de Biome está desactivada para este archivo en biome.json (su biome-ignore no surte efecto). -->
<section class="overflow-x-auto border border-border bg-card" tabindex="0" aria-labelledby={captionId}>
  <table class="w-full text-left text-sm">
    <caption id={captionId} class="sr-only">
      {caption}
    </caption>
    <thead class="border-b border-border text-xs text-muted-foreground">
      <tr>
        <th scope="col" class:list={[secondary, 'px-2.5 py-3 sm:px-4']}>Fecha</th>
        <th scope="col" class="px-2.5 py-3 sm:px-4">Actividad</th>
        {anyDistance && (
          <th scope="col" class="px-2.5 py-3 sm:px-4 text-right">
            Distancia
          </th>
        )}
        <th scope="col" class:list={[secondary, 'px-2.5 py-3 sm:px-4 text-right']}>Tiempo</th>
        {anySpeed && (
          <th scope="col" class="px-2.5 py-3 sm:px-4 text-right">
            Ritmo / vel.
          </th>
        )}
        <th scope="col" class:list={[secondary, 'px-2.5 py-3 sm:px-4 text-right']}>FC media</th>
        <th scope="col" class:list={[secondary, 'px-2.5 py-3 sm:px-4 text-right']}>FC máx</th>
        {anyElevation && (
          <th scope="col" class:list={[secondary, 'px-2.5 py-3 sm:px-4 text-right']}>
            Desnivel&nbsp;+
          </th>
        )}
        {anyCalories && (
          <th scope="col" class:list={[secondary, 'px-2.5 py-3 sm:px-4 text-right']}>
            kcal
          </th>
        )}
      </tr>
    </thead>
    <tbody class="tabular-nums">
      {activities.map((a, i) => (
        <tr class="border-b border-border transition-colors last:border-0 hover:bg-muted/50">
          <td class:list={[secondary, 'px-2.5 py-3 sm:px-4 whitespace-nowrap']}>{dayLabel(a.date)}</td>
          <td class="px-2.5 py-3 sm:px-4">
            <a href={`/actividades/${a.id}`} class="font-medium underline-offset-4 hover:underline">
              {a.name}
            </a>
            {a.isPr && (
              <span class="ml-1.5">
                <TrophyTip label="Récord personal en Garmin" />
              </span>
            )}
            {/* En móvil la fecha va bajo el nombre, junto al tipo: así caben las cifras sin desplazarse de lado */}
            <span class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground sm:mt-0 sm:ml-2 sm:inline-flex">
              <span class="whitespace-nowrap sm:hidden">{dayLabel(a.date)}</span>
              {showType && !nameSaysType(a) && <span class="chip">{activityLabel(a.typeKey)}</span>}
              <span class="whitespace-nowrap sm:hidden">· {hoursMinutes(a.movingS)}</span>
            </span>
          </td>
          {anyDistance && <td class="px-2.5 py-3 sm:px-4 text-right whitespace-nowrap">{distanceText(a, i)}</td>}
          <td class:list={[secondary, 'px-2.5 py-3 sm:px-4 text-right']}>{duration(a.movingS)}</td>
          {anySpeed && <td class="px-2.5 py-3 sm:px-4 text-right whitespace-nowrap">{speedText(a, i)}</td>}
          <td class:list={[secondary, 'px-2.5 py-3 sm:px-4 text-right']}>{int(a.avgHr)}</td>
          <td class:list={[secondary, 'px-2.5 py-3 sm:px-4 text-right']}>{int(a.maxHr)}</td>
          {anyElevation && (
            <td class:list={[secondary, 'px-2.5 py-3 sm:px-4 text-right whitespace-nowrap']}>
              {a.elevationGainM ? `${int(a.elevationGainM)} m` : '—'}
            </td>
          )}
          {anyCalories && <td class:list={[secondary, 'px-2.5 py-3 sm:px-4 text-right']}>{int(a.calories)}</td>}
        </tr>
      ))}
    </tbody>
  </table>
</section>
