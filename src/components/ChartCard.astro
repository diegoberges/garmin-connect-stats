---
/**
 * Tarjeta con gráfica + vista de tabla accesible ("Ver datos"; sin `table`, se genera desde el spec). El subtítulo dice en una línea qué se compara;
 * la fórmula y la evidencia van en `how` ("Cómo se calcula", plegado). Lo que se pase como hijo se añade al
 * final (p. ej. una gráfica secundaria plegada).
 */
import type { ChartSpec } from '../lib/chart-spec';
import Collapsible from './Collapsible.astro';
import DataTable from './DataTable.astro';

interface Props {
  title: string;
  subtitle?: string;
  spec: ChartSpec;
  table?: { headers: string[]; rows: string[][] };
  /** Fórmula, fuentes y límites: se pliega bajo "Cómo se calcula". */
  how?: string;
  /** Nivel del título: 3 dentro de una sección con su propio h2 (lo normal), 2 si cuelga directamente del h1. */
  headingLevel?: 2 | 3;
  class?: string;
}
const { title, subtitle, spec, table, how, headingLevel = 3, class: className } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const hasData = spec.series.some((s) => s.data.some((v) => v !== null && v !== undefined));
---

<section class:list={['min-w-0 border border-border bg-card p-5 text-card-foreground', className]}>
  <Heading class="type-card">{title}</Heading>
  {subtitle && <p class="mt-1.5 text-sm text-muted-foreground">{subtitle}</p>}
  {hasData ? (
    <div
      class="mt-2 w-full min-w-0"
      data-chart={JSON.stringify(spec)}
      role="img"
      aria-label={title}
      style={`min-height:${spec.height ?? 260}px`}
    />
  ) : (
    <p class="py-10 text-center text-sm text-muted-foreground">Sin datos en este periodo</p>
  )}
  {hasData && <DataTable title={title} spec={spec} table={table} />}
  {how && (
    <Collapsible summary="Cómo se calcula" class="mt-1">
      <p class="max-w-prose text-xs text-muted-foreground">{how}</p>
    </Collapsible>
  )}
  <slot />
</section>

<script>
  import '../scripts/charts';
</script>
