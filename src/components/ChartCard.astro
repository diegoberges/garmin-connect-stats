---
/**
 * Tarjeta con gráfica + vista de tabla accesible ("Ver datos").
 */
import type { ChartSpec } from '../lib/chart-spec';

interface Props {
  title: string;
  subtitle?: string;
  spec: ChartSpec;
  table?: { headers: string[]; rows: string[][] };
  class?: string;
}
const { title, subtitle, spec, table, class: className } = Astro.props;
const captionId = `datos-${crypto.randomUUID()}`;
const hasData = spec.series.some((s) => s.data.some((v) => v !== null && v !== undefined));
---

<section class:list={['min-w-0 rounded-xl border border-border bg-card p-5 text-card-foreground shadow-sm', className]}>
  <h2 class="leading-none font-semibold tracking-tight">{title}</h2>
  {subtitle && <p class="mt-1.5 text-sm text-muted-foreground">{subtitle}</p>}
  {hasData ? (
    <div
      class="mt-2 w-full min-w-0"
      data-chart={JSON.stringify(spec)}
      role="img"
      aria-label={title}
      style={`min-height:${spec.height ?? 260}px`}
    />
  ) : (
    <p class="py-10 text-center text-sm text-muted-foreground">Sin datos en este periodo</p>
  )}
  {table && hasData && (
    <details class="mt-2 text-sm">
      <summary class="cursor-pointer select-none text-muted-foreground hover:text-foreground">Ver datos</summary>
      <section class="mt-2 max-h-72 overflow-auto" tabindex="0" aria-labelledby={captionId}>
        <table class="w-full text-left text-xs">
          <caption id={captionId} class="sr-only">
            Datos de la gráfica: {title}
          </caption>
          <thead class="sticky top-0 text-muted-foreground bg-muted/50">
            <tr>
              {table.headers.map((h) => (
                <th scope="col" class="px-2 py-1 font-medium">
                  {h}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="tabular-nums">
            {table.rows.map((r) => (
              <tr class="border-b border-border">
                {r.map((c) => (
                  <td class="px-2 py-1">{c}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    </details>
  )}
</section>

<script>
  import '../scripts/charts';
</script>
