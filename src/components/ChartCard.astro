---
/**
 * Tarjeta con gráfica + vista de tabla accesible ("Ver datos").
 */
import type { ChartSpec } from '../lib/chart-spec';

interface Props {
  title: string;
  subtitle?: string;
  spec: ChartSpec;
  table?: { headers: string[]; rows: string[][] };
  class?: string;
}
const { title, subtitle, spec, table, class: className } = Astro.props;
const hasData = spec.series.some((s) => s.data.some((v) => v !== null && v !== undefined));
---

<section
  class:list={[
    'min-w-0 rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800',
    className,
  ]}
>
  <h2 class="text-base font-semibold">{title}</h2>
  {subtitle && <p class="text-sm text-gray-500 dark:text-gray-400">{subtitle}</p>}
  {hasData ? (
    <div
      class="mt-2 w-full min-w-0"
      data-chart={JSON.stringify(spec)}
      role="img"
      aria-label={title}
      style={`min-height:${spec.height ?? 260}px`}
    />
  ) : (
    <p class="py-10 text-center text-sm text-gray-500 dark:text-gray-400">Sin datos en este periodo</p>
  )}
  {table && hasData && (
    <details class="mt-2 text-sm">
      <summary class="cursor-pointer text-gray-500 select-none hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
        Ver datos
      </summary>
      <div class="mt-2 max-h-72 overflow-auto">
        <table class="w-full text-left text-xs">
          <thead class="sticky top-0 bg-gray-50 text-gray-600 dark:bg-gray-700 dark:text-gray-300">
            <tr>
              {table.headers.map((h) => (
                <th class="px-2 py-1 font-medium">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody class="tabular-nums">
            {table.rows.map((r) => (
              <tr class="border-b border-gray-100 dark:border-gray-700">
                {r.map((c) => (
                  <td class="px-2 py-1">{c}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  )}
</section>

<script>
  import '../scripts/charts';
</script>
