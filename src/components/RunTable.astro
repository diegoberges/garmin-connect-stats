---
import type { RunActivity } from '../lib/garmin/types';
import { dayLabel, duration, int, km, pace, runType } from '../lib/format';

interface Props {
  runs: RunActivity[];
}
const { runs } = Astro.props;
---

<div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
  <table class="w-full text-left text-sm">
    <thead class="bg-gray-50 text-xs text-gray-600 uppercase dark:bg-gray-700 dark:text-gray-300">
      <tr>
        <th class="px-4 py-3">Fecha</th>
        <th class="px-4 py-3">Actividad</th>
        <th class="px-4 py-3 text-right">Distancia</th>
        <th class="px-4 py-3 text-right">Tiempo</th>
        <th class="px-4 py-3 text-right">Ritmo</th>
        <th class="px-4 py-3 text-right">FC media</th>
        <th class="px-4 py-3 text-right">FC máx</th>
        <th class="px-4 py-3 text-right">Desnivel +</th>
      </tr>
    </thead>
    <tbody class="tabular-nums">
      {
        runs.map((r) => (
          <tr class="border-b border-gray-200 bg-white hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700">
            <td class="px-4 py-3 whitespace-nowrap">{dayLabel(r.date)}</td>
            <td class="px-4 py-3">
              <a href={`/actividades/${r.id}`} class="font-medium text-blue-700 hover:underline dark:text-blue-400">
                {r.name}
              </a>
              {r.typeKey !== 'running' && (
                <span class="ml-2 rounded-sm bg-gray-100 px-1.5 py-0.5 text-xs text-gray-700 dark:bg-gray-700 dark:text-gray-300">
                  {runType(r.typeKey)}
                </span>
              )}
            </td>
            <td class="px-4 py-3 text-right whitespace-nowrap">{km(r.distanceKm, 2)} km</td>
            <td class="px-4 py-3 text-right">{duration(r.movingS)}</td>
            <td class="px-4 py-3 text-right whitespace-nowrap">{pace(r.paceSPerKm)} /km</td>
            <td class="px-4 py-3 text-right">{int(r.avgHr)}</td>
            <td class="px-4 py-3 text-right">{int(r.maxHr)}</td>
            <td class="px-4 py-3 text-right whitespace-nowrap">{int(r.elevationGainM)} m</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
