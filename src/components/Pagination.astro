---
/**
 * Paginación de Flowbite con enlaces (?pagina=N) que conservan el resto de parámetros.
 * `anchor` lleva de vuelta a la tabla tras cambiar de página.
 */
interface Props {
  page: number;
  pages: number;
  total: number;
  pageSize: number;
  param?: string;
  anchor?: string;
  /** Nombre accesible de la paginación. */
  label?: string;
}
const { page, pages, total, pageSize, param = 'pagina', anchor = '', label = 'Paginación de sesiones' } = Astro.props;

const href = (n: number) => {
  const params = new URLSearchParams(Astro.url.search);
  if (n === 1) params.delete(param);
  else params.set(param, String(n));
  const qs = params.toString();
  return `${qs ? `?${qs}` : Astro.url.pathname}${anchor ? `#${anchor}` : ''}`;
};

// 1 … 4 5 6 … 12: primera, última y las vecinas de la actual
const items: (number | '…')[] = [];
for (let n = 1; n <= pages; n++) {
  if (n === 1 || n === pages || Math.abs(n - page) <= 1) items.push(n);
  else if (items.at(-1) !== '…') items.push('…');
}
const first = (page - 1) * pageSize + 1;
const last = Math.min(page * pageSize, total);
// Botones de paginación de shadcn: fantasma, y la página actual con contorno
const base = 'flex h-8 min-w-8 items-center justify-center rounded-md px-2.5 font-medium transition-colors';
const idle = 'hover:bg-accent hover:text-accent-foreground';
---

{pages > 1 && (
  <nav class="mt-3 flex flex-wrap items-center justify-between gap-3" aria-label={label}>
    <span class="text-sm text-muted-foreground">
      <span class="font-semibold tabular-nums text-foreground">
        {first}–{last}
      </span>{' '}
      de <span class="font-semibold tabular-nums text-foreground">{total}</span>
    </span>
    <ul class="inline-flex items-center gap-1 text-sm tabular-nums">
      <li>
        {page > 1 ? (
          <a href={href(page - 1)} class:list={[base, idle]} aria-label="Página anterior">
            ‹
          </a>
        ) : (
          <span class:list={[base, 'text-muted-foreground/50']} aria-hidden="true">
            ‹
          </span>
        )}
      </li>
      {items.map((n) => (
        <li>
          {n === '…' ? (
            <span class:list={[base, 'text-muted-foreground']}>…</span>
          ) : n === page ? (
            <span class:list={[base, 'border border-input bg-background shadow-xs']} aria-current="page">
              {n}
            </span>
          ) : (
            <a href={href(n)} class:list={[base, idle]}>
              {n}
            </a>
          )}
        </li>
      ))}
      <li>
        {page < pages ? (
          <a href={href(page + 1)} class:list={[base, idle]} aria-label="Página siguiente">
            ›
          </a>
        ) : (
          <span class:list={[base, 'text-muted-foreground/50']} aria-hidden="true">
            ›
          </span>
        )}
      </li>
    </ul>
  </nav>
)}
