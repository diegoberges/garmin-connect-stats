---
/**
 * Menú de perfil (sustituye a la antigua página de Ajustes): foto, nombre y datos clave del usuario,
 * más la gestión de la API key y el estado de la conexión (si se ha podido leer el perfil de Garmin).
 */
import { maskKey, secretConfigured } from '../lib/settings';
import { clientFor, getProfile, type UserProfile } from '../lib/garmin';

const key = Astro.locals.settings.garminApiKey;
const sex = Astro.locals.settings.sex;
const client = clientFor(Astro.locals);
const flash = Astro.locals.flash;
const profile: UserProfile = client ? await getProfile(client).catch(() => ({})) : {};
const connected = Boolean(key);
const healthy = connected && !profile.connectionError;

const statusText = healthy ? 'Garmin conectado' : connected ? 'Error de conexión con Garmin' : 'Garmin sin conectar';
const name = profile.fullName ?? profile.displayName ?? (connected ? 'Mi perfil' : 'Conectar Garmin');
const initials = (profile.fullName ?? profile.displayName ?? '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]!.toUpperCase())
  .join('');
const redirectTo = Astro.url.pathname + Astro.url.search;
---

<div class="relative">
  <button
    id="profile-toggle"
    type="button"
    class="flex items-center gap-2 rounded-lg py-1 pr-2 pl-1 text-sm font-medium hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 focus:outline-none dark:hover:bg-gray-700 dark:focus:ring-gray-700"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="profile-menu"
  >
    <span class="relative shrink-0">
      {profile.imageUrl ? (
        <img src={profile.imageUrl} alt="" class="h-8 w-8 rounded-full object-cover" referrerpolicy="no-referrer" />
      ) : (
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-gray-200 text-xs font-semibold text-gray-600 dark:bg-gray-600 dark:text-gray-200">
          {initials || (
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 1 1 14 0H3Z" />
            </svg>
          )}
        </span>
      )}
      <span
        class:list={[
          'absolute -right-0.5 -bottom-0.5 h-3 w-3 rounded-full border-2 border-white dark:border-gray-800',
          healthy ? 'bg-green-500' : connected ? 'bg-red-500' : 'bg-gray-400',
        ]}
        title={statusText}
        aria-hidden="true"
      ></span>
    </span>
    <!-- En móvil el nombre no se ve, pero sigue siendo el nombre accesible del botón; el estado va en texto -->
    <span class="sr-only sm:not-sr-only sm:block sm:max-w-40 sm:truncate">{name}</span>
    <span class="sr-only">({statusText})</span>
    <svg class="h-3 w-3 text-gray-500 dark:text-gray-400" fill="none" viewBox="0 0 10 6" aria-hidden="true">
      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4" />
    </svg>
  </button>

  <div
    id="profile-menu"
    role="dialog"
    aria-label="Perfil y conexión"
    class="z-50 hidden max-h-[calc(100vh-5rem)] w-[24rem] max-w-[calc(100vw-2rem)] overflow-y-auto rounded-lg border border-gray-200 bg-white shadow-lg dark:border-gray-700 dark:bg-gray-800"
  >
    <!-- Cabecera de perfil -->
    <div class="flex items-center gap-3 border-b border-gray-200 p-4 dark:border-gray-700">
      {profile.imageUrl ? (
        <img
          src={profile.imageUrl}
          alt=""
          class="h-12 w-12 shrink-0 rounded-full object-cover"
          referrerpolicy="no-referrer"
        />
      ) : (
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gray-200 font-semibold text-gray-600 dark:bg-gray-600 dark:text-gray-200">
          {initials || '?'}
        </span>
      )}
      <div class="min-w-0">
        <p class="truncate font-semibold">{name}</p>
        {profile.displayName && profile.fullName && (
          <p class="truncate text-sm text-gray-500 dark:text-gray-400">@{profile.displayName}</p>
        )}
        {profile.timeZone && <p class="truncate text-xs text-gray-500 dark:text-gray-400">{profile.timeZone}</p>}
      </div>
    </div>
    <div class="space-y-4 p-4">
      {flash && (
        <div
          class:list={[
            'rounded-lg p-3 text-sm',
            flash.type === 'success'
              ? 'bg-green-50 text-green-800 dark:bg-gray-700 dark:text-green-400'
              : 'bg-red-50 text-red-800 dark:bg-gray-700 dark:text-red-400',
          ]}
          role={flash.type === 'success' ? 'status' : 'alert'}
        >
          {flash.text}
        </div>
      )}
      {!secretConfigured() && (
        <div
          class="rounded-lg bg-yellow-50 p-3 text-sm text-yellow-800 dark:bg-gray-700 dark:text-yellow-300"
          role="alert"
        >
          Falta configurar <code>APP_SECRET</code> en el servidor. Sin él no se puede guardar la key de forma segura.
        </div>
      )}

      <!-- API key -->
      <section>
        <div class="flex items-center justify-between gap-2">
          <h2 class="text-sm font-semibold">Garmin Connect</h2>
          {key ? (
            <span class="rounded-sm bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800 dark:bg-green-900 dark:text-green-300">
              Conectado · {maskKey(key)}
            </span>
          ) : (
            <span class="rounded-sm bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-800 dark:bg-gray-700 dark:text-gray-300">
              Sin conectar
            </span>
          )}
        </div>
        <p class="mt-1 text-xs text-gray-600 dark:text-gray-400">
          Crea tu Personal API Key en{' '}
          <a
            class="text-blue-600 underline dark:text-blue-400"
            href="https://connect.garmin.com/app/settings/personalApiToken"
            target="_blank"
            rel="noopener"
            >Garmin Connect → Personal API Key</a
          >{' '}
          y pégala aquí. Se guarda cifrada en una cookie que solo lee el servidor.
        </p>
        <form
          method="post"
          action="/api/ajustes"
          class="mt-3 flex gap-2"
          data-loading="Validando tu API key con Garmin…"
        >
          <input type="hidden" name="action" value="save">
          <input type="hidden" name="redirect" value={redirectTo}>
          <label for="garminApiKey" class="sr-only">Personal API Key</label>
          <input
            id="garminApiKey"
            name="garminApiKey"
            type="password"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            required
            placeholder={key ? 'Key nueva para reemplazarla' : 'Personal API Key'}
            class="block w-full min-w-0 rounded-lg border border-gray-300 bg-gray-50 p-2 text-base text-gray-900 sm:text-sm focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400"
          >
          <button
            type="submit"
            class="shrink-0 rounded-lg bg-blue-700 px-3 py-2 text-sm font-medium text-white hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 focus:outline-none dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
          >
            Guardar
          </button>
        </form>
        {key && (
          <form method="post" action="/api/ajustes" class="mt-2" data-loading="Eliminando la key…">
            <input type="hidden" name="action" value="remove" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <button type="submit" class="text-xs text-red-600 hover:underline dark:text-red-400">
              Eliminar key
            </button>
          </form>
        )}
      </section>

      <!-- Datos del perfil -->
      <section class="border-t border-gray-200 pt-4 dark:border-gray-700">
        <h2 class="text-sm font-semibold">Perfil</h2>
        <form method="post" action="/api/ajustes" class="mt-2 flex items-end gap-2" data-loading="Guardando tu perfil…">
          <input type="hidden" name="action" value="save-sex">
          <input type="hidden" name="redirect" value={redirectTo}>
          <label class="min-w-0 flex-1 text-xs text-gray-600 dark:text-gray-400">
            Sexo (para comparar tu VO2máx con tu grupo de edad)
            <select
              name="sex"
              class="mt-1 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2 text-base text-gray-900 sm:text-sm focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white"
            >
              <option value="" selected={!sex}>Sin indicar</option>
              <option value="male" selected={sex === 'male'}>Hombre</option>
              <option value="female" selected={sex === 'female'}>Mujer</option>
            </select>
          </label>
          <button
            type="submit"
            class="shrink-0 rounded-lg border border-gray-300 px-3 py-2 text-sm font-medium hover:bg-gray-100 dark:border-gray-600 dark:hover:bg-gray-700"
          >
            Guardar
          </button>
        </form>
      </section>

      <!-- Estado de la conexión: basta con que Garmin devuelva el perfil -->
      {key && (
        <p
          class:list={[
            'flex items-start gap-2 border-t border-gray-200 pt-3 text-sm dark:border-gray-700',
            healthy ? 'text-green-700 dark:text-green-400' : 'text-red-700 dark:text-red-400',
          ]}
          role={healthy ? 'status' : 'alert'}
        >
          <span
            class:list={['mt-1.5 h-2 w-2 shrink-0 rounded-full', healthy ? 'bg-green-500' : 'bg-red-500']}
            aria-hidden="true"
          />
          {healthy ? 'Conexión correcta' : `Sin conexión: ${profile.connectionError}`}
        </p>
      )}
    </div>
  </div>
</div>

<script>
  import { Dropdown } from 'flowbite';

  const toggle = document.getElementById('profile-toggle')!;
  const panel = document.getElementById('profile-menu')!;

  const menu = new Dropdown(panel, toggle, {
    placement: 'bottom-start',
    offsetDistance: 8,
    onShow: () => toggle.setAttribute('aria-expanded', 'true'),
    onHide: () => toggle.setAttribute('aria-expanded', 'false'),
  });

  // Enlaces "Conectar"/"Comprobar la conexión" del resto de páginas abren el menú
  document.addEventListener('click', (ev) => {
    const link = (ev.target as Element).closest('[data-open-profile]');
    if (!link) return;
    ev.preventDefault();
    menu.show();
    panel.querySelector<HTMLInputElement>('#garminApiKey')?.focus();
  });

  // Tras guardar/eliminar la key se vuelve con #perfil: abrir y limpiar el hash
  if (location.hash === '#perfil') {
    menu.show();
    history.replaceState(null, '', location.pathname + location.search);
  }
</script>
