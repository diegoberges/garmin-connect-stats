---
/**
 * Menú de perfil (sustituye a la antigua página de Ajustes): foto, nombre y datos clave del usuario,
 * más la gestión de la API key y el estado de la conexión (si se ha podido leer el perfil de Garmin).
 */
import { maskKey, secretConfigured } from '../lib/settings';
import { clientFor, getProfile, type UserProfile } from '../lib/garmin';
import { DEFAULT_THRESHOLDS, THRESHOLD_LIMITS, type AlertThresholds } from '../lib/sleep-alert';

const key = Astro.locals.settings.garminApiKey;
const sex = Astro.locals.settings.sex;
const heightCm = Astro.locals.settings.heightCm;
const savedAlert = Astro.locals.settings.alert ?? {};
/** Campos de la alerta de sueño: vacío = valor por defecto (que se muestra como sugerencia). */
interface AlertField {
  key: keyof AlertThresholds;
  label: string;
  unit: string;
  /** Sugerencia si no hay valor por defecto numérico. */
  fallback?: string;
}
const ALERT_FIELDS: AlertField[] = [
  { key: 'lastNightH', label: 'Avisar si anoche dormiste menos de', unit: 'h' },
  { key: 'shortNightH', label: 'Noche corta: menos de', unit: 'h' },
  { key: 'minShortNights', label: 'Noches cortas en 7 días, al menos', unit: '' },
  { key: 'sleepTargetH', label: 'Objetivo de sueño para la deuda', unit: 'h', fallback: 'Garmin' },
  { key: 'hrvSd', label: 'Escalar si la VFC baja más de', unit: 'DE' },
  { key: 'rhrBpm', label: 'Escalar si la FC en reposo sube', unit: 'ppm' },
];
const alertFields = ALERT_FIELDS.map((f) => ({
  ...f,
  placeholder: f.fallback ?? String(DEFAULT_THRESHOLDS[f.key] ?? '').replace('.', ','),
}));
const hasCustomAlert = Object.keys(savedAlert).length > 0;
const client = clientFor(Astro.locals);
const flash = Astro.locals.flash;
const profile: UserProfile = client ? await getProfile(client).catch(() => ({})) : {};
const connected = Boolean(key);
const healthy = connected && !profile.connectionError;

const statusText = healthy ? 'Garmin conectado' : connected ? 'Error de conexión con Garmin' : 'Garmin sin conectar';
const name = profile.fullName ?? profile.displayName ?? (connected ? 'Mi perfil' : 'Conectar Garmin');
const initials = (profile.fullName ?? profile.displayName ?? '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]!.toUpperCase())
  .join('');
const redirectTo = Astro.url.pathname + Astro.url.search;
---

<div class="relative">
  <button
    id="profile-toggle"
    type="button"
    class="flex items-center gap-2 rounded-lg py-1 pr-2 pl-1 text-sm font-medium hover:bg-accent hover:text-accent-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="profile-menu"
  >
    <span class="relative shrink-0">
      {profile.imageUrl ? (
        <img src={profile.imageUrl} alt="" class="h-8 w-8 rounded-full object-cover" referrerpolicy="no-referrer" />
      ) : (
        <span class="flex h-8 w-8 items-center justify-center rounded-full text-xs font-semibold text-muted-foreground bg-muted">
          {initials || (
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 1 1 14 0H3Z" />
            </svg>
          )}
        </span>
      )}
      <span
        class:list={[
          'absolute -right-0.5 -bottom-0.5 h-3 w-3 rounded-full border-2 border-card',
          healthy ? 'bg-green-500' : connected ? 'bg-red-500' : 'bg-muted-foreground',
        ]}
        title={statusText}
        aria-hidden="true"
      ></span>
    </span>
    <!-- En móvil el nombre no se ve, pero sigue siendo el nombre accesible del botón; el estado va en texto -->
    <span class="sr-only sm:not-sr-only sm:block sm:max-w-40 sm:truncate">{name}</span>
    <span class="sr-only">({statusText})</span>
    <svg class="h-3 w-3 text-muted-foreground" fill="none" viewBox="0 0 10 6" aria-hidden="true">
      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4" />
    </svg>
  </button>

  <div
    id="profile-menu"
    role="dialog"
    aria-label="Perfil y conexión"
    class="z-50 hidden max-h-[calc(100vh-5rem)] w-[24rem] max-w-[calc(100vw-2rem)] overflow-y-auto border border-border bg-popover text-popover-foreground rounded-md shadow-md"
  >
    <!-- Cabecera de perfil -->
    <div class="flex items-center gap-3 border-b p-4 border-border">
      {profile.imageUrl ? (
        <img
          src={profile.imageUrl}
          alt=""
          class="h-12 w-12 shrink-0 rounded-full object-cover"
          referrerpolicy="no-referrer"
        />
      ) : (
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full font-semibold text-muted-foreground bg-muted">
          {initials || '?'}
        </span>
      )}
      <div class="min-w-0">
        <p class="truncate font-semibold">{name}</p>
        {profile.displayName && profile.fullName && (
          <p class="truncate text-sm text-muted-foreground">@{profile.displayName}</p>
        )}
        {profile.timeZone && <p class="truncate text-xs text-muted-foreground">{profile.timeZone}</p>}
      </div>
    </div>
    <div class="space-y-4 p-4">
      {flash && (
        <div
          class:list={[
            'rounded-lg p-3 text-sm',
            flash.type === 'success'
              ? 'bg-green-50 text-green-800 dark:bg-green-950/50 dark:text-green-400'
              : 'bg-red-50 text-red-800 dark:bg-red-950/50 dark:text-red-400',
          ]}
          role={flash.type === 'success' ? 'status' : 'alert'}
        >
          {flash.text}
        </div>
      )}
      {!secretConfigured() && (
        <div
          class="rounded-lg border border-yellow-200 bg-yellow-50 p-3 text-sm text-yellow-800 dark:border-yellow-900/60 dark:bg-yellow-950/40 dark:text-yellow-300"
          role="alert"
        >
          Falta configurar <code>APP_SECRET</code> en el servidor. Sin él no se puede guardar la key de forma segura.
        </div>
      )}

      <!-- API key -->
      <section>
        <div class="flex items-center justify-between gap-2">
          <h2 class="text-sm font-semibold">Garmin Connect</h2>
          {key ? <span class="chip chip-ok">Conectado · {maskKey(key)}</span> : <span class="chip">Sin conectar</span>}
        </div>
        <p class="mt-1 text-xs text-muted-foreground">
          Crea tu Personal API Key en{' '}
          <a
            class="text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground"
            href="https://connect.garmin.com/app/settings/personalApiToken"
            target="_blank"
            rel="noopener"
            >Garmin Connect → Personal API Key</a
          >{' '}
          y pégala aquí. Se guarda cifrada en una cookie que solo lee el servidor.
        </p>
        <form
          method="post"
          action="/api/ajustes"
          class="mt-3 flex gap-2"
          data-loading="Validando tu API key con Garmin…"
        >
          <input type="hidden" name="action" value="save">
          <input type="hidden" name="redirect" value={redirectTo}>
          <label for="garminApiKey" class="sr-only">Personal API Key</label>
          <input
            id="garminApiKey"
            name="garminApiKey"
            type="password"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            required
            placeholder={key ? 'Key nueva para reemplazarla' : 'Personal API Key'}
            class="block w-full min-w-0 rounded-lg border p-2 text-base sm:text-sm bg-transparent shadow-xs placeholder:text-muted-foreground focus:border-ring focus:ring-[3px] focus:ring-ring/50 text-foreground border-input dark:bg-input/30"
          >
          <button
            type="submit"
            class="shrink-0 rounded-lg px-3 py-2 text-sm font-medium bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none"
          >
            Guardar
          </button>
        </form>
        {key && (
          <form method="post" action="/api/ajustes" class="mt-2" data-loading="Eliminando la key…">
            <input type="hidden" name="action" value="remove" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <button type="submit" class="text-xs text-red-600 hover:underline dark:text-red-400">
              Eliminar key
            </button>
          </form>
        )}
      </section>

      <!-- Datos del perfil -->
      <section class="border-t pt-4 border-border">
        <h2 class="text-sm font-semibold">Perfil</h2>
        <form
          method="post"
          action="/api/ajustes"
          class="mt-2 grid grid-cols-[1fr_6rem] items-end gap-2"
          data-loading="Guardando tu perfil…"
        >
          <input type="hidden" name="action" value="save-sex">
          <input type="hidden" name="redirect" value={redirectTo}>
          <label class="min-w-0 text-xs text-muted-foreground">
            Sexo (para comparar tu VO2máx con tu grupo de edad y para la carga)
            <select
              name="sex"
              class="mt-1 block w-full rounded-lg border p-2 text-base sm:text-sm bg-transparent shadow-xs focus:border-ring focus:ring-[3px] focus:ring-ring/50 text-foreground border-input dark:bg-input/30"
            >
              <option value="" selected={!sex}>Sin indicar</option>
              <option value="male" selected={sex === 'male'}>Hombre</option>
              <option value="female" selected={sex === 'female'}>Mujer</option>
            </select>
          </label>
          <label class="text-xs text-muted-foreground">
            Altura (cm), para el IMC
            <input
              name="heightCm"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              value={heightCm ?? ''}
              placeholder="175"
              class="mt-1 block w-full rounded-lg border p-2 text-base sm:text-sm bg-transparent shadow-xs focus:border-ring focus:ring-[3px] focus:ring-ring/50 text-foreground border-input dark:bg-input/30 text-right tabular-nums placeholder:text-muted-foreground"
            >
          </label>
          <div class="col-span-2 flex justify-end">
            <button
              type="submit"
              class="shrink-0 rounded-lg border px-3 py-2 text-sm font-medium border-input hover:bg-accent hover:text-accent-foreground"
            >
              Guardar
            </button>
          </div>
        </form>
      </section>

      <!-- Umbrales de la alerta de fatiga por sueño -->
      <section class="border-t pt-4 border-border">
        <h2 class="text-sm font-semibold">Alerta de fatiga por sueño</h2>
        <p class="mt-1 text-xs text-muted-foreground">
          Umbrales orientativos. Deja un campo vacío para usar el valor por defecto (el que se ve en gris).
        </p>
        <form
          method="post"
          action="/api/ajustes"
          class="mt-2 grid grid-cols-[1fr_auto] items-center gap-x-2 gap-y-1.5 text-xs"
          data-loading="Guardando los umbrales…"
        >
          <input type="hidden" name="action" value="save-alert">
          <input type="hidden" name="redirect" value={redirectTo}>
          {alertFields.map((f) => (
            <>
              <label for={`alert-${f.key}`} class="text-muted-foreground">
                {f.label}
              </label>
              <span class="flex items-center gap-1">
                <input
                  id={`alert-${f.key}`}
                  name={f.key}
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  value={savedAlert[f.key]?.toString().replace('.', ',') ?? ''}
                  placeholder={f.placeholder}
                  aria-describedby={`alert-${f.key}-range`}
                  class="w-16 rounded-lg border p-1.5 text-right text-base tabular-nums sm:text-sm bg-transparent shadow-xs placeholder:text-muted-foreground focus:border-ring focus:ring-[3px] focus:ring-ring/50 text-foreground border-input dark:bg-input/30"
                >
                <span class="w-7 text-muted-foreground">{f.unit}</span>
                <span id={`alert-${f.key}-range`} class="sr-only">
                  {`Entre ${String(THRESHOLD_LIMITS[f.key].min).replace('.', ',')} y ${String(THRESHOLD_LIMITS[f.key].max).replace('.', ',')}`}
                </span>
              </span>
            </>
          ))}
          <div class="col-span-2 mt-1 flex justify-end">
            <button
              type="submit"
              class="rounded-lg border px-3 py-1.5 text-sm font-medium border-input hover:bg-accent hover:text-accent-foreground"
            >
              Guardar
            </button>
          </div>
        </form>
        {hasCustomAlert && (
          <form method="post" action="/api/ajustes" class="mt-1" data-loading="Restableciendo los umbrales…">
            <input type="hidden" name="action" value="reset-alert" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <button type="submit" class="text-xs hover:underline text-muted-foreground">
              Restablecer los valores por defecto
            </button>
          </form>
        )}
      </section>

      <!-- Estado de la conexión: basta con que Garmin devuelva el perfil -->
      {key && (
        <p
          class:list={[
            'flex items-start gap-2 border-t pt-3 text-sm border-border',
            healthy ? 'text-green-700 dark:text-green-400' : 'text-red-700 dark:text-red-400',
          ]}
          role={healthy ? 'status' : 'alert'}
        >
          <span
            class:list={['mt-1.5 h-2 w-2 shrink-0 rounded-full', healthy ? 'bg-green-500' : 'bg-red-500']}
            aria-hidden="true"
          />
          {healthy ? 'Conexión correcta' : `Sin conexión: ${profile.connectionError}`}
        </p>
      )}
    </div>
  </div>
</div>

<script>
  import { Dropdown } from 'flowbite';

  const toggle = document.getElementById('profile-toggle')!;
  const panel = document.getElementById('profile-menu')!;

  const menu = new Dropdown(panel, toggle, {
    placement: 'bottom-start',
    offsetDistance: 8,
    onShow: () => toggle.setAttribute('aria-expanded', 'true'),
    onHide: () => toggle.setAttribute('aria-expanded', 'false'),
  });

  // Enlaces "Conectar"/"Comprobar la conexión" del resto de páginas abren el menú
  document.addEventListener('click', (ev) => {
    const link = (ev.target as Element).closest('[data-open-profile]');
    if (!link) return;
    ev.preventDefault();
    menu.show();
    panel.querySelector<HTMLInputElement>('#garminApiKey')?.focus();
  });

  // Tras guardar/eliminar la key se vuelve con #perfil: abrir y limpiar el hash
  if (location.hash === '#perfil') {
    menu.show();
    history.replaceState(null, '', location.pathname + location.search);
  }
</script>
