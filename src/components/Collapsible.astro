---
/**
 * Bloque plegable con el mismo aspecto que "Ver datos": para lo secundario ("Más indicadores…") y para las
 * explicaciones largas ("Cómo se calcula"). Lo que es un aviso no se pliega: se muestra fuera.
 */
interface Props {
  summary: string;
  class?: string;
  /** Abierto de entrada (p. ej. cuando dentro hay algo que pide atención). */
  open?: boolean;
}
const { summary, class: className, open = false } = Astro.props;
---

<details class:list={['text-sm', className]} open={open}>
  <summary class="w-fit cursor-pointer select-none text-muted-foreground hover:text-foreground pointer-coarse:py-2.5">
    {summary}
  </summary>
  <div class="mt-2">
    <slot />
  </div>
</details>
