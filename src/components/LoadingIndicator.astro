---
/**
 * Indicador de carga global. Las páginas se generan en el servidor mientras se consulta Garmin,
 * así que al navegar el navegador se queda en la página anterior sin pista de que algo pasa.
 * Al pulsar un enlace interno o enviar un formulario se muestra una barra arriba y un aviso con
 * lo que se está esperando. Un elemento puede fijar su texto con data-loading="…" o desactivarlo
 * con data-no-loading.
 */
---

<div id="page-loading" class="page-loading" hidden>
  <div class="page-loading-bar" aria-hidden="true"></div>
  <div class="page-loading-toast" role="status" aria-live="polite">
    <svg class="page-loading-spinner" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity="0.25"></circle>
      <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
    </svg>
    <div>
      <p id="page-loading-text" class="page-loading-text">Cargando…</p>
      <p id="page-loading-slow" class="page-loading-slow" hidden>Sigue cargando: Garmin está respondiendo despacio.</p>
    </div>
  </div>
</div>

<script>
  const root = document.getElementById('page-loading')!;
  const text = document.getElementById('page-loading-text')!;
  const slow = document.getElementById('page-loading-slow')!;
  let showTimer: ReturnType<typeof setTimeout> | undefined;
  let slowTimer: ReturnType<typeof setTimeout> | undefined;

  /** Qué se está esperando en cada página (lo que hace su servidor antes de responder). */
  function messageFor(url: URL): string {
    const p = url.pathname;
    if (p.startsWith('/salud')) return 'Cargando tu salud de los últimos 90 días…';
    if (p.startsWith('/rendimiento')) return 'Calculando tu carga, marcas y eficiencia (incluye tus últimas tiradas largas)…';
    if (/^\/actividades\/\d+/.test(p)) return 'Descargando la actividad y su recorrido…';
    if (p.startsWith('/actividades')) return 'Cargando tus actividades…';
    if (p.startsWith('/competiciones')) return 'Buscando tus competiciones en todo tu historial…';
    if (p.startsWith('/comparador')) return 'Descargando tu historial completo de actividades… la primera vez puede tardar.';
    return 'Cargando…';
  }

  function show(message: string) {
    clearTimeout(showTimer);
    clearTimeout(slowTimer);
    // Pequeño retardo: si la página llega enseguida, no hay parpadeo
    showTimer = setTimeout(() => {
      text.textContent = message;
      slow.hidden = true;
      root.hidden = false;
      slowTimer = setTimeout(() => (slow.hidden = false), 6000);
    }, 150);
  }

  function hide() {
    clearTimeout(showTimer);
    clearTimeout(slowTimer);
    root.hidden = true;
  }

  document.addEventListener('click', (ev) => {
    if (ev.defaultPrevented || ev.button !== 0 || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
    const a = (ev.target as Element).closest('a');
    if (!a || a.hasAttribute('data-no-loading') || a.hasAttribute('download')) return;
    if (a.target && a.target !== '_self') return;
    const url = new URL(a.href, location.href);
    if (url.origin !== location.origin) return;
    // Solo cambia el ancla: no hay carga
    if (url.pathname === location.pathname && url.search === location.search && url.hash) return;
    show(a.dataset.loading ?? messageFor(url));
  });

  document.addEventListener('submit', (ev) => {
    const form = ev.target as HTMLFormElement;
    if (ev.defaultPrevented || form.hasAttribute('data-no-loading')) return;
    show(form.dataset.loading ?? 'Guardando…');
  });

  // Al volver con el botón atrás (bfcache) la página se restaura tal cual: ocultarlo
  window.addEventListener('pageshow', hide);
</script>

<style>
  .page-loading {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
  }
  .page-loading[hidden] {
    display: none;
  }
  .page-loading-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 35%;
    background: #2a78d6;
    border-radius: 0 2px 2px 0;
    animation: page-loading-slide 1.1s ease-in-out infinite;
  }
  @keyframes page-loading-slide {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(300%);
    }
  }
  .page-loading-toast {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: flex-start;
    gap: 10px;
    width: max-content;
    max-width: calc(100vw - 32px);
    padding: 10px 14px;
    border-radius: 10px;
    background: #111827;
    color: #fff;
    box-shadow: 0 10px 25px rgb(0 0 0 / 0.25);
    pointer-events: auto;
  }
  :global(.dark) .page-loading-toast {
    background: #f4f4f5;
    color: #18181b;
  }
  .page-loading-spinner {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    animation: page-loading-spin 0.8s linear infinite;
  }
  @keyframes page-loading-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .page-loading-text {
    font-size: 14px;
    font-weight: 500;
  }
  .page-loading-slow {
    margin-top: 2px;
    font-size: 12px;
    opacity: 0.75;
  }
  @media (prefers-reduced-motion: reduce) {
    .page-loading-bar,
    .page-loading-spinner {
      animation-duration: 3s;
    }
  }
</style>
