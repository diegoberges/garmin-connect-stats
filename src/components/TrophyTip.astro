---
/**
 * Trofeo ámbar con aviso propio (al pasar el ratón o al enfocar/tocar). El color va fijado aquí
 * para no depender de clases generadas; el texto del aviso también es el texto accesible.
 */
import Trophy from './Trophy.astro';

interface Props {
  label: string;
  class?: string;
}
const { label, class: className = 'h-4 w-4' } = Astro.props;
---

<span class="trophy-tip" tabindex="0">
  <Trophy class={className} />
  <span role="tooltip" class="trophy-tip-text">{label}</span>
</span>

<style>
  .trophy-tip {
    position: relative;
    display: inline-flex;
    vertical-align: -2px;
    cursor: help;
    color: #f59e0b;
  }
  :global(.dark) .trophy-tip {
    color: #fbbf24;
  }
  .trophy-tip:focus {
    outline: none;
  }
  .trophy-tip-text {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    padding: 2px 8px;
    border-radius: 6px;
    background: #111827;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.12s;
    z-index: 20;
  }
  .trophy-tip:hover .trophy-tip-text,
  .trophy-tip:focus .trophy-tip-text {
    opacity: 1;
  }
</style>
