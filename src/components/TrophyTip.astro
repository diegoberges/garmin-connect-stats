---
/**
 * Trofeo ámbar con aviso propio (al pasar el ratón o al enfocar/tocar). El color va fijado aquí
 * para no depender de clases generadas; el texto del aviso también es el texto accesible.
 */
import Trophy from './Trophy.astro';

interface Props {
  label: string;
  class?: string;
}
const { label, class: className = 'h-4 w-4' } = Astro.props;
---

<button type="button" class="trophy-tip" aria-label={label}>
  <Trophy class={className} />
  <span role="tooltip" class="trophy-tip-text" aria-hidden="true">{label}</span>
</button>

<style>
  .trophy-tip {
    position: relative;
    display: inline-flex;
    vertical-align: -2px;
    cursor: help;
    color: #f59e0b;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
  }
  :global(.dark) .trophy-tip {
    color: #fbbf24;
  }
  /* Anillo de foco visible al llegar con el teclado (no al tocar o hacer clic) */
  .trophy-tip:focus-visible {
    outline: 2px solid #1d4ed8;
    outline-offset: 2px;
    border-radius: 4px;
  }
  :global(.dark) .trophy-tip:focus-visible {
    outline-color: #60a5fa;
  }
  .trophy-tip-text {
    position: absolute;
    bottom: calc(100% + 0.375rem);
    left: 50%;
    transform: translateX(-50%);
    padding: 0.125rem 0.5rem;
    border-radius: 6px;
    background: #111827;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.12s;
    z-index: 20;
  }
  .trophy-tip:hover .trophy-tip-text,
  .trophy-tip:focus .trophy-tip-text {
    opacity: 1;
  }
</style>
