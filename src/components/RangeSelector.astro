---
/**
 * Selector de opciones por enlaces (?semanas=N, ?carga=…), estilo Tabs de shadcn/ui.
 * Conserva el resto de parámetros.
 */
interface Props {
  options: { value: number | string; label: string }[];
  current: number | string;
  param?: string;
  /** Nombre accesible del grupo. */
  label?: string;
  /** Ancla a la que volver tras elegir (p. ej. la sección donde está el selector). */
  anchor?: string;
}
const { options, current, param = 'semanas', label = 'Periodo', anchor = '' } = Astro.props;
const hrefFor = (value: number | string) => {
  const params = new URLSearchParams(Astro.url.search);
  params.set(param, String(value));
  params.delete('pagina');
  return `?${params}${anchor ? `#${anchor}` : ''}`;
};
---

<nav class="inline-flex h-9 items-center rounded-lg bg-muted p-[3px] text-muted-foreground" aria-label={label}>
  {options.map((o) => (
    <a
      href={hrefFor(o.value)}
      aria-current={o.value === current ? 'true' : undefined}
      class:list={[
        'inline-flex h-full items-center rounded-md border border-transparent px-3 text-sm font-medium whitespace-nowrap transition-colors',
        o.value === current
          ? 'bg-background text-foreground shadow-sm dark:border-input dark:bg-input/30'
          : 'hover:text-foreground',
      ]}
    >
      {o.label}
    </a>
  ))}
</nav>
