---
/** Selector de periodo (enlaces ?semanas=N), estilo button group de Flowbite. Conserva el resto de parámetros. */
interface Props {
  options: { value: number; label: string }[];
  current: number;
  param?: string;
}
const { options, current, param = 'semanas' } = Astro.props;
const hrefFor = (value: number) => {
  const params = new URLSearchParams(Astro.url.search);
  params.set(param, String(value));
  params.delete('pagina');
  return `?${params}`;
};
---

<div class="inline-flex rounded-lg shadow-xs" role="group" aria-label="Periodo">
  {
    options.map((o, i) => (
      <a
        href={hrefFor(o.value)}
        aria-current={o.value === current ? 'true' : undefined}
        class:list={[
          'border border-gray-200 px-3 py-1.5 text-sm font-medium dark:border-gray-600',
          i === 0 && 'rounded-s-lg',
          i === options.length - 1 && 'rounded-e-lg',
          i > 0 && '-ms-px',
          o.value === current
            ? 'bg-blue-700 text-white dark:bg-blue-600'
            : 'bg-white text-gray-900 hover:bg-gray-100 dark:bg-gray-800 dark:text-white dark:hover:bg-gray-700',
        ]}
      >
        {o.label}
      </a>
    ))
  }
</div>
