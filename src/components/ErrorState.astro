---
import { GarminAuthError } from '../lib/garmin/auth';
import { GarminApiError } from '../lib/garmin/client';

interface Props {
  error: unknown;
}
const { error } = Astro.props;
const auth = error instanceof GarminAuthError || (error instanceof GarminApiError && error.status === 401);
/** Qué ha fallado y qué hacer, sin el mensaje técnico (que va al log). */
function messageFor(): string {
  if (auth) return 'Tu API key de Garmin no es válida o ha caducado.';
  if (error instanceof GarminApiError && error.status === 429)
    return 'Garmin está limitando las peticiones. Espera unos minutos y recarga la página.';
  if (error instanceof GarminApiError && error.status >= 500)
    return 'Garmin no responde ahora mismo. Prueba a recargar en unos minutos.';
  return 'Ha fallado la petición a Garmin. Recarga la página; si sigue fallando, comprueba la conexión en tu perfil.';
}
const message = messageFor();
if (!auth) console.error('[garmin]', error);
---

<div class="border p-6 text-sm border-red-900/60 bg-red-950/40 text-red-300" role="alert">
  <p class="font-semibold">No se han podido cargar los datos</p>
  <p class="mt-1 break-words">{message}</p>
  <a href="#perfil" data-open-profile class="mt-3 inline-block font-medium underline"
    >{auth ? 'Actualizar la key' : 'Comprobar la conexión'}</a
  >
</div>
