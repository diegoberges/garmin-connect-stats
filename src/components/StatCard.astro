---
/**
 * KPI: etiqueta, valor y comparación opcional. La variación lleva flecha + texto
 * (nunca solo color). `higherIsBetter` decide si subir es bueno (km) o malo (FC reposo).
 */
interface Props {
  label: string;
  value: string;
  unit?: string;
  delta?: number; // % de variación
  deltaLabel?: string; // "vs semana pasada"
  higherIsBetter?: boolean;
  hint?: string;
}
const { label, value, unit, delta, deltaLabel, higherIsBetter = true, hint } = Astro.props;
const hasDelta = delta !== undefined && Number.isFinite(delta);
const flat = hasDelta && Math.abs(delta!) < 1;
const good = hasDelta && !flat && delta! > 0 === higherIsBetter;
const arrow = !hasDelta || flat ? '→' : delta! > 0 ? '↑' : '↓';
const deltaText = hasDelta ? `${delta! > 0 ? '+' : ''}${Math.round(delta!)} %` : '';
---

<div class="border border-border bg-card p-5 text-card-foreground">
  <p class="type-label">{label}</p>
  <p class="mt-1 type-kpi">
    {value}{unit && <span class="ml-1 text-base font-normal text-muted-foreground">{unit}</span>}
  </p>
  {hasDelta && (
    <p class="mt-1 text-xs">
      <span
        class:list={[
          'font-medium tabular-nums',
          flat
            ? 'text-muted-foreground'
            : good
              ? 'text-green-700 dark:text-green-400'
              : 'text-red-700 dark:text-red-400',
        ]}
      >
        {arrow} {deltaText}
      </span>
      {deltaLabel && <span class="text-muted-foreground"> {deltaLabel}</span>}
    </p>
  )}
  {hint && <p class="mt-1 text-xs text-muted-foreground">{hint}</p>}
</div>
