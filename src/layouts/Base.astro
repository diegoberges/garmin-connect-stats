---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import ProfileMenu from '../components/ProfileMenu.astro';
import LoadingIndicator from '../components/LoadingIndicator.astro';
import SleepAlertBanner from '../components/SleepAlertBanner.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;

interface NavItem {
  href: string;
  label: string;
  /** Si tiene hijos, se muestra como desplegable */
  children?: { href: string; label: string; description: string }[];
}
const nav: NavItem[] = [
  { href: '/salud', label: 'Salud' },
  { href: '/rendimiento', label: 'Rendimiento' },
  {
    href: '/actividades',
    label: 'Actividades',
    children: [
      { href: '/actividades', label: 'Actividades', description: 'Todas tus sesiones por tipo' },
      { href: '/competiciones', label: 'Competiciones', description: 'Las marcadas como competición en Garmin' },
      { href: '/comparador', label: 'Comparador', description: 'Compara tu volumen entre años' },
      { href: '/calidad', label: 'Calidad de datos', description: 'Duplicadas, sin FC o con errores de GPS' },
    ],
  },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const itemActive = (item: NavItem) =>
  item.children ? item.children.some((c) => isActive(c.href)) : isActive(item.href);
const linkClass = (active: boolean) => [
  'rounded-md px-3 py-1.5 text-sm font-medium whitespace-nowrap transition-colors',
  active ? 'bg-accent text-accent-foreground' : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground',
];
const dropdowns = nav.filter((i) => i.children);
const menuId = (item: NavItem) => `nav-menu-${item.label.toLowerCase()}`;
---

<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <title>{title} · Garmin Stats</title>
    <meta name="color-scheme" content="light dark">
    <script is:inline>
      // Aplica el tema guardado antes de pintar (evita el parpadeo); sin valor guardado se sigue al sistema
      {
        const meta = document.querySelector('meta[name="color-scheme"]');
        try {
          const s = localStorage.getItem('theme');
          if (s === 'light' || s === 'dark') meta.content = s;
        } catch {
          // Datos del sitio bloqueados: se sigue al sistema
        }
        const m = meta.content;
        const dark = m === 'dark' || (m !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      }
    </script>
    <!-- Transición entre páginas: no pintar hasta tener el contenido, para no animar hacia una página a medias -->
    <link rel="expect" href="#contenido" blocking="render">
    <!--
      Precarga de la siguiente página (Speculation Rules; donde no hay soporte no hace nada). Cada página
      consulta Garmin en el servidor, así que se precarga con prudencia: la navegación principal al pasar
      el ratón (moderate) y el resto solo al empezar el clic (conservative). Nunca /api ni /dev.
    -->
    <script is:inline type="speculationrules">
      {
        "prefetch": [
          {
            "where": { "and": [{ "selector_matches": "header nav a" }, { "href_matches": "/*" }] },
            "eagerness": "moderate"
          },
          {
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": ["/api/*", "/dev/*"] } },
                { "not": { "selector_matches": "[download], [data-no-loading]" } }
              ]
            },
            "eagerness": "conservative"
          }
        ]
      }
    </script>
    <Analytics />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <a
      href="#contenido"
      class="sr-only z-70 rounded-lg px-4 py-2 text-sm font-medium focus:not-sr-only focus:fixed focus:top-2 focus:left-2 bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none"
      data-no-loading
    >
      Saltar al contenido
    </a>
    <header class="sticky top-0 z-40 border-b border-border bg-background/80 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2.5">
        <ProfileMenu />
        <div class="flex min-w-0 items-center gap-1">
          <nav aria-label="Principal" class="flex min-w-0 items-center">
            <div class="flex min-w-0 items-center gap-1 overflow-x-auto">
              {nav.map((item) =>
                item.children ? (
                  <button
                    type="button"
                    data-dropdown-toggle={menuId(item)}
                    data-dropdown-placement="bottom-end"
                    class:list={[linkClass(itemActive(item)), 'flex items-center gap-1']}
                    aria-controls={menuId(item)}
                    aria-expanded="false"
                  >
                    {item.children.find((c) => isActive(c.href))?.label ?? item.label}
                    <svg class="h-3 w-3" fill="none" viewBox="0 0 10 6" aria-hidden="true">
                      <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="m1 1 4 4 4-4"
                      />
                    </svg>
                  </button>
                ) : (
                  <a
                    href={item.href}
                    class:list={linkClass(isActive(item.href))}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                ),
              )}
            </div>
            {/* Fuera del contenedor con scroll lateral, para que no recorte los paneles */}
            {dropdowns.map((item) => (
              <ul
                id={menuId(item)}
                class="z-50 hidden w-64 border py-1 border-border bg-popover text-popover-foreground rounded-md shadow-md"
              >
                {item.children!.map((c) => (
                  <li>
                    <a
                      href={c.href}
                      aria-current={isActive(c.href) ? 'page' : undefined}
                      class:list={[
                        'block px-4 py-2 hover:bg-accent hover:text-accent-foreground',
                        isActive(c.href) && 'bg-accent',
                      ]}
                    >
                      <span class:list={['block text-sm font-medium', isActive(c.href) && 'text-accent-foreground']}>
                        {c.label}
                      </span>
                      <span class="block text-xs text-muted-foreground">{c.description}</span>
                    </a>
                  </li>
                ))}
              </ul>
            ))}
          </nav>
          <button
            id="theme-toggle"
            type="button"
            class="ml-3 rounded-md p-1.5 text-muted-foreground/60 transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:text-accent-foreground"
          >
            <!-- El texto dice qué hará el botón; el que no aplica se oculta (y sale del árbol accesible) -->
            <span class="sr-only dark:hidden">Pasar a modo oscuro</span>
            <span class="sr-only hidden dark:inline">Pasar a modo claro</span>
            <svg class="h-4 w-4 dark:hidden" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
            </svg>
            <svg class="hidden h-4 w-4 dark:block" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path
                d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <!-- Alerta de fatiga por sueño: isla de servidor, se carga aparte para no retrasar la página -->
    <SleepAlertBanner server:defer />

    <main id="contenido" class="mx-auto max-w-6xl px-4 py-6">
      <slot />
    </main>

    <LoadingIndicator />

    <script>
      import 'flowbite';
      import '../scripts/theme';
      import '../scripts/dropdowns';
    </script>
  </body>
</html>
